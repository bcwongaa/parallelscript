import { range } from "pts:parallel";
const source = range(0, 4000).toArray();
const mapped = source.par.map((value) => {
    let scratch = 0;
    for (let i = 0; i < (value % 7) * 10; i++) scratch += i;
    return value * 2 + scratch * 0;
});
console.log(mapped.every((value, index) => value === index * 2), mapped.length);
try {
    source.par.map((value) => {
        if (value === 37) throw new Error("map failure");
        return value;
    });
    console.log("did not throw");
} catch (error: any) {
    console.log(error.name, error.message);
}
console.log([3, 1, 2].par.map(value => value * 2).join(","));
console.log("reduce", source.par.reduce((left, right) => left + right, 10), source.reduce((left, right) => left + right, 10));
