// A parallel analytics job: generate a synthetic event log, then compute the same report
// sequentially and in parallel (several ways) and check that they agree.
import { range, join } from "pts:parallel";
import { AtomicInt, Channel, Mutex } from "pts:sync";
import process from "pts:process";

// ---------- data ----------

type EventKind = "view" | "click" | "purchase" | "refund";

interface Event {
  user: number;
  ts: number;
  kind: EventKind;
  cents: number;
  country: string;
}

const COUNTRIES = ["US", "DE", "FR", "JP", "BR", "IN", "GB", "CA"];
const KINDS: EventKind[] = ["view", "view", "view", "view", "click", "click", "purchase", "refund"];

// A tiny deterministic PRNG (mulberry32), so every run sees the same data.
function rng(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function generateLines(count: number, seed: number): string[] {
  const rand = rng(seed);
  const lines: string[] = [];
  let ts = 1_700_000_000;
  for (let i = 0; i < count; i++) {
    ts += Math.floor(rand() * 5);
    const user = Math.floor(rand() * 5000);
    const kind = KINDS[Math.floor(rand() * KINDS.length)];
    const cents = kind === "purchase" || kind === "refund" ? 100 + Math.floor(rand() * 20000) : 0;
    const country = COUNTRIES[user % COUNTRIES.length];
    lines.push(`${ts},${user},${kind},${cents},${country}`);
  }
  return lines;
}

function parseLine(line: string): Event {
  const [ts, user, kind, cents, country] = line.split(",");
  return { ts: Number(ts), user: Number(user), kind: kind as EventKind, cents: Number(cents), country };
}

// ---------- the report ----------

interface Report {
  events: number;
  byKind: Map<string, number>;
  revenueByCountry: Map<string, number>;
  buyers: Set<number>;
}

function emptyReport(): Report {
  return { events: 0, byKind: new Map(), revenueByCountry: new Map(), buyers: new Set() };
}

function addEvent(r: Report, e: Event): Report {
  r.events++;
  r.byKind.set(e.kind, (r.byKind.get(e.kind) ?? 0) + 1);
  if (e.kind === "purchase" || e.kind === "refund") {
    const sign = e.kind === "purchase" ? 1 : -1;
    r.revenueByCountry.set(e.country, (r.revenueByCountry.get(e.country) ?? 0) + sign * e.cents);
    if (e.kind === "purchase") r.buyers.add(e.user);
  }
  return r;
}

function mergeReports(a: Report, b: Report): Report {
  const out = emptyReport();
  out.events = a.events + b.events;
  for (const src of [a, b]) {
    for (const [k, v] of src.byKind) out.byKind.set(k, (out.byKind.get(k) ?? 0) + v);
    for (const [k, v] of src.revenueByCountry) out.revenueByCountry.set(k, (out.revenueByCountry.get(k) ?? 0) + v);
    for (const u of src.buyers) out.buyers.add(u);
  }
  return out;
}

function reportOf(events: Event[]): Report {
  return events.reduce(addEvent, emptyReport());
}

function summarize(r: Report): string {
  const kinds = [...r.byKind.entries()].sort(([a], [b]) => a.localeCompare(b));
  const revenue = [...r.revenueByCountry.entries()].sort((x, y) => y[1] - x[1]);
  const fmt = (cents: number) => `$${(cents / 100).toFixed(2)}`;
  return [
    `events=${r.events} buyers=${r.buyers.size}`,
    `kinds: ${kinds.map(([k, n]) => `${k}=${n}`).join(" ")}`,
    `revenue: ${revenue.map(([c, v]) => `${c}=${fmt(v)}`).join(" ")}`,
  ].join("\n");
}

// ---------- parallel strategies ----------

function chunk<T>(items: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
  return out;
}

// 1. .par.map over chunks, then a sequential merge.
function viaParMap(events: Event[]): Report {
  const partials = chunk(events, 25_000).par.map((part) => reportOf(part));
  return partials.reduce(mergeReports, emptyReport());
}

// 2. .par.reduce with an associative merge.
function viaParReduce(events: Event[]): Report {
  return chunk(events, 25_000)
    .par.map((part) => reportOf(part))
    .par.reduce(mergeReports, emptyReport());
}

// 3. One `parallel` task per shard.
async function viaTasks(events: Event[], shards: number): Promise<Report> {
  const size = Math.ceil(events.length / shards);
  const parts = await Promise.all(chunk(events, size).map((part) => parallel reportOf(part)));
  return parts.reduce(mergeReports, emptyReport());
}

// 4. A channel pipeline: the main task sends batches, workers on other loops fold them.
async function viaChannel(events: Event[], workers: number): Promise<Report> {
  const batches = new Channel<Event[]>(8);
  const processed = new AtomicInt();
  async function worker(): Promise<Report> {
    let r = emptyReport();
    for await (const batch of batches) {
      for (const e of batch) r = addEvent(r, e);
      processed.add(batch.length as int);
    }
    return r;
  }
  const running = Promise.all(Array.from({ length: workers }, () => parallel worker()));
  for (const batch of chunk(events, 10_000)) await batches.send(batch);
  batches.close();
  const reports = await running;
  if (processed.load() !== events.length) throw new Error(`lost events: ${processed.load()} of ${events.length}`);
  return reports.reduce(mergeReports, emptyReport());
}

// 5. parallel for into a mutex-guarded report.
function viaMutex(events: Event[]): Report {
  const shared = new Mutex(emptyReport());
  parallel for (const part of chunk(events, 25_000)) {
    const local = reportOf(part);
    shared.withLock((r) => {
      const merged = mergeReports(r, local);
      r.events = merged.events;
      r.byKind = merged.byKind;
      r.revenueByCountry = merged.revenueByCountry;
      r.buyers = merged.buyers;
    });
  }
  return shared.withLock((r) => r);
}

// ---------- sorting with join ----------

function mergeSorted(a: number[], b: number[]): number[] {
  const out: number[] = [];
  let i = 0;
  let j = 0;
  while (i < a.length && j < b.length) out.push(a[i] <= b[j] ? a[i++] : b[j++]);
  while (i < a.length) out.push(a[i++]);
  while (j < b.length) out.push(b[j++]);
  return out;
}

function parallelSort(xs: number[]): number[] {
  if (xs.length < 20_000) return [...xs].sort((a, b) => a - b);
  const mid = xs.length >> 1;
  const [left, right] = join(
    () => parallelSort(xs.slice(0, mid)),
    () => parallelSort(xs.slice(mid)),
  );
  return mergeSorted(left, right);
}

// ---------- k-means on purchases (amount, hour of day) ----------

type Point = [number, number];

function kmeans(points: Point[], k: number, iterations: number, usePar: boolean): Point[] {
  let centers: Point[] = points.slice(0, k).map(([x, y]) => [x, y]);
  for (let it = 0; it < iterations; it++) {
    const nearest = (p: Point): number => {
      let best = 0;
      let bestDist = Infinity;
      centers.forEach(([cx, cy], i) => {
        const d = (p[0] - cx) ** 2 + (p[1] - cy) ** 2;
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };
    const assignment = usePar ? points.par.map(nearest) : points.map(nearest);
    const sums = centers.map((): [number, number, number] => [0, 0, 0]);
    assignment.forEach((c, i) => {
      sums[c][0] += points[i][0];
      sums[c][1] += points[i][1];
      sums[c][2]++;
    });
    centers = sums.map(([sx, sy, n], i) => (n === 0 ? centers[i] : [sx / n, sy / n]));
  }
  return centers;
}

// ---------- main ----------

function time<T>(label: string, f: () => T): T {
  const t0 = performance.now();
  const result = f();
  timings.push(`${label}: ${(performance.now() - t0).toFixed(1)} ms`);
  return result;
}
const timings: string[] = [];

const COUNT = Number(process.argv[2] ?? "400000");
const lines = time("generate", () => generateLines(COUNT, 42));
const sequentialEvents = time("parse (map)", () => lines.map(parseLine));
const events = time("parse (.par.map)", () => lines.par.map(parseLine));
console.log("parsed alike:", JSON.stringify(events.slice(0, 3)) === JSON.stringify(sequentialEvents.slice(0, 3)), events.length);

const expected = time("report (sequential)", () => reportOf(sequentialEvents));
console.log(summarize(expected));

const strategies: [string, Report][] = [
  [".par.map", time(".par.map", () => viaParMap(events))],
  [".par.reduce", time(".par.reduce", () => viaParReduce(events))],
  ["parallel for + Mutex", time("parallel for + Mutex", () => viaMutex(events))],
];
let t0 = performance.now();
strategies.push(["parallel tasks", await viaTasks(events, 8)]);
timings.push(`parallel tasks: ${(performance.now() - t0).toFixed(1)} ms`);
t0 = performance.now();
strategies.push(["channel pipeline", await viaChannel(events, 3)]);
timings.push(`channel pipeline: ${(performance.now() - t0).toFixed(1)} ms`);

const want = summarize(expected);
for (const [name, r] of strategies) {
  console.log(`${name.padEnd(22)} ${summarize(r) === want ? "agrees" : "DIFFERS:\n" + summarize(r)}`);
}

// Biggest purchases, sorted three ways.
const amounts = events.filter((e) => e.kind === "purchase").map((e) => e.cents);
const sortedSeq = time("sort (Array.sort)", () => [...amounts].sort((a, b) => a - b));
const sortedJoin = time("sort (join)", () => parallelSort(amounts));
const sortedPar = time("sort (.par.sort)", () => [...amounts].par.sort((a, b) => a - b));
console.log(
  "sorts agree:",
  sortedJoin.every((v, i) => v === sortedSeq[i]),
  sortedPar.every((v, i) => v === sortedSeq[i]),
  "median purchase:",
  sortedSeq[sortedSeq.length >> 1],
);

// Counting with range + .par and atomics.
const bigSpenders = new AtomicInt();
parallel for (const i of range(0, events.length)) {
  if (events[i].cents > 15_000) bigSpenders.add(1);
}
console.log("big spenders:", bigSpenders.load(), events.par.count((e) => e.cents > 15_000));

const points: Point[] = events
  .filter((e) => e.kind === "purchase")
  .map((e): Point => [e.cents / 100, ((e.ts % 86400) / 3600) * 10]);
const c1 = time("kmeans (map)", () => kmeans(points, 4, 10, false));
const c2 = time("kmeans (.par.map)", () => kmeans(points, 4, 10, true));
const round = (cs: Point[]) => cs.map(([x, y]) => `(${x.toFixed(2)}, ${y.toFixed(2)})`).join(" ");
console.log("kmeans:", round(c1));
console.log("kmeans agree:", round(c1) === round(c2));

if (process.env.SHOW_TIMINGS) for (const t of timings) console.error(t);
