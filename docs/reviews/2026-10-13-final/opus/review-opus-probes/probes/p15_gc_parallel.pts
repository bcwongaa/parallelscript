// GC stress across loops and the pool, plus iteration of collections being mutated elsewhere.
import { range } from "pts:parallel";
class Node2 { constructor(public left: Node2 | null, public right: Node2 | null, public label: string) {} }
function build(depth: number): Node2 {
  return depth === 0 ? new Node2(null, null, "leaf") : new Node2(build(depth - 1), build(depth - 1), `d${depth}`);
}
function check(n: Node2 | null): number { return n === null ? 0 : 1 + check(n.left) + check(n.right); }
async function treeTask(seed: number): Promise<number> {
  let total = 0;
  for (let i = 0; i < 20; i++) {
    total += check(build(12));
    if (i % 5 === 0) await new Promise((r) => setTimeout(r, 1));
  }
  return total + seed * 0;
}
const tasks = await Promise.all([...range(0, 8)].map((i) => parallel treeTask(i)));
console.log("tasks", tasks.every((t) => t === 20 * 8191));
const counts = range(0, 64).par.map((i) => check(build(10 + (i % 4))));
console.log("par trees", counts.slice(0, 4));
// Iterate a Map and an array while other threads mutate them.
const m = new Map<number, number[]>();
for (let i = 0; i < 1000; i++) m.set(i, [i]);
const arr: string[] = Array.from({ length: 1000 }, (_, i) => `s${i}`);
async function mutate(): Promise<void> {
  for (let round = 0; round < 200; round++) {
    for (let i = 0; i < 1000; i += 7) { m.delete(i); m.set(i + round * 1000, [i, round]); }
    arr.splice(0, 50);
    for (let i = 0; i < 50; i++) arr.push(`r${round}`);
    if (round % 20 === 0) await null;
  }
}
const mutator = parallel mutate();
let seen = 0;
for (let round = 0; round < 200; round++) {
  for (const [k, v] of m) { if (!Array.isArray(v)) throw new Error("bad value"); seen += k >= 0 ? 1 : 0; }
  for (const s of arr) { if (typeof s !== "string") throw new Error("bad string"); }
  const copy = [...m.values()].map((v) => v.length);
  if (copy.some((n) => n < 1)) throw new Error("bad copy");
}
await mutator;
console.log("iterated during mutation", seen > 0, m.size > 0);
