const mixed: (number | string)[] = [3, "b", 1, "a", 10, "10"];
console.log([...mixed].sort(), mixed.join("|"), mixed.indexOf("10"), mixed.includes(10), mixed.lastIndexOf(1));
const nested: (number | number[])[] = [1, [2, 3], 4, [5]];
console.log(nested.flatMap((x) => x), nested.flatMap((x) => (Array.isArray(x) ? x : [x, x])), nested.concat([6], 7, [[8]]));
const withUndef: (string | undefined)[] = ["b", undefined, "a"];
console.log([...withUndef].sort(), withUndef.filter((x): x is string => x !== undefined), withUndef.map((x) => x ?? "-"));
const objs: ({ t: "a"; n: number } | { t: "b"; s: string })[] = [{ t: "a", n: 1 }, { t: "b", s: "x" }];
console.log(objs.map((o) => (o.t === "a" ? o.n : o.s)), objs.find((o) => o.t === "b"), objs.findIndex((o) => o.t === "b"));
console.log(new Array(4).fill(0).map((_, i) => i), [1, 2, 3].fill(9, 1), [5, 1, 4].reduceRight((a, b) => a + "-" + b, ""));
console.log([10, 1, 2].sort(), [true, false].sort(), [[2, 1], [1, 2]].sort(), [-1, -2, 3].sort());
const arrs: number[][] = [[3], [1, 2], []];
console.log(arrs.flat(), arrs.map((a) => a.length), Math.max(...arrs.flat()));
console.log(Array.from(new Set([3, 1, 3])), Array.from(new Map([["a", 1]])), Array.from("héllo".matchAll(/l/g), (m) => m.index));
const sparse = [1, 2, 3];
const removed = sparse.splice(1, 1, 9, 8);
console.log(sparse, removed, [1, 2, 3].slice(-2), [1, 2, 3].splice(-1), Array.of(7, 8), [3, 2, 1].keys().next());
const tuples: [string, number][] = [["b", 2], ["a", 1]];
console.log(Object.fromEntries(tuples), new Map(tuples), tuples.sort(([a], [b]) => a.localeCompare(b)), tuples.flat());
const deepU: (string | (string | string[])[])[] = ["a", ["b", ["c"]]];
console.log(deepU.flat(), deepU.flat(2), deepU.join(), String(deepU));
console.log([[1, 2], [3]].flatMap((x) => x).flat(), [0, 1, 2].map(String), ["1", "2", "3"].map(Number), ["1", "2", "3"].map((s) => parseInt(s)));
