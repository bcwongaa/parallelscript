function* naturals(): Generator<number> { let n = 0; while (true) yield n++; }
function* take<T>(it: Iterable<T>, n: number): Generator<T> { if (n <= 0) return; for (const x of it) { yield x; if (--n <= 0) return; } }
function* mapIt<T, U>(it: Iterable<T>, f: (x: T) => U): Generator<U> { for (const x of it) yield f(x); }
console.log([...take(mapIt(naturals(), (n) => n * n), 5)]);
function* withReturn(): Generator<number, string, number> { const a = yield 1; const b = yield a * 2; return `done ${a + b}`; }
const g = withReturn(); console.log(g.next(), g.next(5), g.next(7), g.next());
function* guarded() { try { yield 1; yield 2; } finally { console.log("cleanup"); } }
for (const v of guarded()) { console.log(v); break; }
const g2 = guarded(); g2.next(); try { g2.throw(new Error("injected")); } catch (e) { console.log("thrown out:", (e as Error).message); }
class Range implements Iterable<number> {
  constructor(private lo: number, private hi: number, private step = 1) {}
  [Symbol.iterator](): Iterator<number> {
    let cur = this.lo; const { hi, step } = this;
    return {
      next: (): IteratorResult<number> => {
        if (cur < hi) { const value = cur; cur += step; return { value, done: false }; }
        return { value: undefined, done: true };
      },
    };
  }
}
console.log([...new Range(0, 10, 3)], Array.from(new Range(1, 4), (x) => x * 10), Math.max(...new Range(0, 5)));
const m = new Map([["a", 1], ["b", 2]]);
console.log([...m.keys()], [...m.entries()].map(([k, v]) => k + v), Object.fromEntries(m), new Set("hello").size);
function* flatten(xs: unknown[]): Generator<unknown> { for (const x of xs) Array.isArray(x) ? yield* flatten(x) : yield x; }
console.log([...flatten([1, [2, [3, [4]], 5]])]);
async function* ticker(n: number) { for (let i = 0; i < n; i++) { await new Promise((r) => setTimeout(r, 1)); yield i; } }
(async () => {
  const seen: number[] = [];
  for await (const t of ticker(4)) seen.push(t);
  console.log("ticks", seen);
  const it = ticker(10);
  console.log(await it.next(), await it.return(), await it.next());
  const results = await Promise.all([1, 2].map(async (k) => { const out: number[] = []; for await (const x of ticker(k + 1)) out.push(x * k); return out; }));
  console.log(results);
})();
const entries = Object.entries({ x: 1, y: 2 }).map(([k, v]) => `${k}=${v}`);
console.log(entries, Array.from({ length: 3 }, (_, i) => i), [..."ab"].entries().next());
const it2 = [1, 2, 3][Symbol.iterator](); it2.next(); console.log([...it2]);
