class Point { constructor(public x: number, public y: number) {} static readonly ORIGIN = new Point(0, 0); plus(o: Point) { return new Point(this.x + o.x, this.y + o.y); } }
console.log(Point.ORIGIN.plus(new Point(1, 2)), { ...new Point(3, 4) }, Object.keys(new Point(5, 6)), JSON.stringify(new Point(1, 1)));
