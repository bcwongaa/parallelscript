type Json = string | number | boolean | null | Json[] | { [k: string]: Json };
function render(j: Json, indent = 0): string {
  const pad = " ".repeat(indent);
  if (Array.isArray(j)) return `[\n${j.map((x) => pad + "  " + render(x, indent + 2)).join(",\n")}\n${pad}]`;
  if (j !== null && typeof j === "object") return `{ ${Object.entries(j).map(([k, v]) => `${k}: ${render(v, indent)}`).join(", ")} }`;
  return JSON.stringify(j);
}
console.log(render({ a: [1, "two", { b: null }], c: true }));
class Btn {
  clicks = 0;
  label: string;
  onClick = () => { this.clicks++; return this.label; };
  constructor(label: string) { this.label = label; }
}
const btn = new Btn("ok"); const handler = btn.onClick; handler(); handler();
console.log(btn.clicks, [1, 2].map(btn.onClick));
interface Cfg { name?: string; nested?: { deep?: { fn?: () => string } } }
const cfgs: Cfg[] = [{}, { nested: {} }, { nested: { deep: { fn: () => "called" } } }];
console.log(cfgs.map((c) => c.nested?.deep?.fn?.() ?? "none"), cfgs[0].name?.toUpperCase());
function greet(this: { name: string }, greeting: string) { return `${greeting}, ${this.name}`; }
console.log(greet.call({ name: "Ann" }, "Hi"), greet.apply({ name: "Bo" }, ["Yo"]), greet.bind({ name: "Cy" })("Hey"));
function tag(strings: TemplateStringsArray, ...vals: unknown[]) { return strings.raw.join("|") + "#" + vals.join(","); }
console.log(tag`a${1}b${"x"}c\n`, String.raw`C:\new\table`);
type Shape = { kind: "circle"; r: number } | { kind: "rect"; w: number; h: number } | { kind: "tri"; a: number; b: number; c: number };
function area(s: Shape): number {
  switch (s.kind) {
    case "circle": return Math.PI * s.r ** 2;
    case "rect": return s.w * s.h;
    case "tri": { const p = (s.a + s.b + s.c) / 2; return Math.sqrt(p * (p - s.a) * (p - s.b) * (p - s.c)); }
    default: { const never: never = s; return never; }
  }
}
console.log([{ kind: "circle", r: 1 }, { kind: "rect", w: 2, h: 3 }, { kind: "tri", a: 3, b: 4, c: 5 }].map((s) => area(s as Shape).toFixed(3)));
const people = [{ n: "b", age: 30 }, { n: "a", age: 30 }, { n: "c", age: 25 }];
console.log(people.toSorted((x, y) => x.age - y.age || x.n.localeCompare(y.n)).map((p) => p.n), people.map((p) => p.n));
console.log([1, 2, 3].at(-1), [1, 2, 3].findLast((x) => x < 3), [3, 1, 2].toReversed(), [1, 2, 3].with(1, 9), [[1, [2]], [3]].flat(2));
