const a = [1, 2, 3];
console.log(a.map((x, i) => { if (i === 0) a.push(4); return x * 2; }), a);
const b = [1, 2, 3];
console.log(b.reduce((sum, x, i) => { if (i === 0) b[2] = 10; return sum + x; }, 0));
const mixed: any[] = [1, "a", null, undefined, false];
console.log(mixed.filter(Boolean), mixed.map(String));
console.log([NaN, -0, Infinity].includes(NaN), Object.is([0].at(0), -0));
