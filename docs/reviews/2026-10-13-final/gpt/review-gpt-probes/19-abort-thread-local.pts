import { range } from "pts:parallel";
import { AtomicInt } from "pts:sync";
const failed = new AtomicInt();
const passed = new AtomicInt();
const errors: string[] = [];
range(0, 4).par.forEach(() => {
  for (let i = 0; i < 100000; i++) {
    try {
      const controller = new AbortController();
      if (controller.signal.aborted) throw new Error("new controller already aborted");
      controller.abort("local");
      if (!controller.signal.aborted || controller.signal.reason !== "local") throw new Error("wrong local signal");
      passed.add(1);
    } catch (error) {
      failed.add(1);
      if (errors.length < 4) errors.push(error instanceof Error ? error.name + ": " + error.message : String(error));
    }
  }
});
console.log("passed", passed.load(), "failed", failed.load(), errors);
