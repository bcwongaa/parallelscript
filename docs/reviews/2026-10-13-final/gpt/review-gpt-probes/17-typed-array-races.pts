import { AtomicInt } from "pts:sync";
import { range } from "pts:parallel";
const shared = new Float64Array(64).fill(1.25);
const invalid = new AtomicInt();
range(0, 4).par.forEach((worker) => {
  for (let i = 0; i < 3000; i++) {
    if (worker % 2 === 0) shared.fill(i % 2 === 0 ? 1.25 : -3.5);
    else {
      const copy = shared.slice();
      for (const n of copy) if (n !== 1.25 && n !== -3.5) invalid.add(1);
      shared.reverse();
    }
  }
});
console.log(invalid.load());
const clamped = new Uint8ClampedArray([0.5, 1.5, 2.5, 254.6, NaN]);
console.log(clamped.join(","));
