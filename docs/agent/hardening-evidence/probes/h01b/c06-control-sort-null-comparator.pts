// H01b C06 control: unlike undefined, null IS passed to a comparator, which then decides its place
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): prints `[ null, 1, 3 ]` and `comparator saw null: true`, exit 0
// baseline PTS: builds and runs, stdout identical to Node, exit 0
const values: (number | null)[] = [3, null, 1];
const seen: string[] = [];
values.sort((a, b) => {
    seen.push(String(a), String(b));
    return (a ?? -1) - (b ?? -1);
});
console.log(values);
console.log("comparator saw null:", seen.includes("null"));
