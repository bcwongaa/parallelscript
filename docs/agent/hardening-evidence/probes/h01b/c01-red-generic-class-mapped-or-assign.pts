class Buckets<E extends Record<string, unknown>> {
    readonly lists: { [K in keyof E]?: E[K][] } = {};

    add<K extends keyof E>(key: K, value: E[K]): void {
        (this.lists[key] ||= []).push(value);
    }
}
const buckets = new Buckets<{ a: number; b: string }>();
buckets.add("a", 1);
buckets.add("b", "x");
buckets.add("a", 2);
console.log(buckets.lists);
