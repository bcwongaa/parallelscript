// H01b C18 control: getter results done=false,false,true through a typed `Iterable<number>` class (`next(): any`), logging getter calls
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): `read done 0, read value 0, item 0, read done 1, read value 1, item 10, read done 2, end` (one per line), exit 0
// baseline PTS: builds and runs, stdout identical to Node, exit 0
class Steps implements Iterable<number> {
    [Symbol.iterator](): Iterator<number> {
        let step = 0;
        return {
            next(): any {
                const current = step++;
                return {
                    get done() {
                        console.log("read done", current);
                        return current >= 2;
                    },
                    get value() {
                        console.log("read value", current);
                        return current * 10;
                    },
                };
            },
        };
    }
}
for (const item of new Steps()) {
    console.log("item", item);
}
console.log("end");
