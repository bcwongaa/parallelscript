// H01b C05 red: `flat()` over arrays of tuples
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): prints `[ 'b', 2, 'a', 1 ]` and `[ 1, 2, 3, 4 ]`, exit 0
// baseline PTS: builds and runs but returns the tuples unflattened: `[ [ 'b', 2 ], [ 'a', 1 ] ]`, `[ [ 1, 2 ], [ 3, 4 ] ]`, exit 0
// failure: ^\[ \[ 'b', 2 \], \[ 'a', 1 \] \]$
const entries: [string, number][] = [["b", 2], ["a", 1]];
console.log(entries.flat());
const pairs: [number, number][] = [[1, 2], [3, 4]];
console.log(pairs.flat());
