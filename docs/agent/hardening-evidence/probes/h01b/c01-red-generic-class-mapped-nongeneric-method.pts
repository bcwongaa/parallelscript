// failure: ^panic: interface conversion: ir\.Type is \*ir\.Primitive, not \*ir\.MapType(?s:.*)pts/lower/records\.go:280
class Buckets<E extends Record<string, unknown>> {
    readonly lists: { [K in keyof E]?: E[keyof E][] } = {};

    add(key: keyof E, value: E[keyof E]): void {
        (this.lists[key] ??= []).push(value);
    }
}
const buckets = new Buckets<{ a: number; b: number }>();
buckets.add("a", 1);
buckets.add("b", 2);
buckets.add("a", 3);
console.log(buckets.lists);
