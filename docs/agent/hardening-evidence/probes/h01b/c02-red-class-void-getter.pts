// H01b C02 red: a class getter whose body only throws (tsc infers `void`), read through the instance
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): prints `caught thrown by getter`, exit 0
// baseline PTS: `pts build` panics (cgen: no check for void, pts/cgen/checks.go:305), exit 2
// failure: ^panic: cgen: no check for void(?s:.*)pts/cgen/checks\.go:305
class Settings {
    get missing() {
        throw new Error("thrown by getter");
    }
}
try {
    console.log(new Settings().missing);
} catch (error: any) {
    console.log("caught", error.message);
}
