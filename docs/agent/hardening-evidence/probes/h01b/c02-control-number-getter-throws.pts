// H01b C02 control: the same throwing object-literal getter annotated `: number` (so not `void`), read through `any`
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): prints `caught thrown by getter`, exit 0
// baseline PTS: builds and runs, stdout identical to Node, exit 0
const settings: any = {
    get missing(): number {
        throw new Error("thrown by getter");
    },
};
try {
    console.log(settings.missing);
} catch (error: any) {
    console.log("caught", error.message);
}
