// H01b C06 red: the same SortCompare rules for `any[]` and for an array held as `any` (dynamic method dispatch)
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): `[ 1, 3, 'b', null, undefined ]` x2, `[ 3, 1, null, 'b', undefined ]`, `comparator saw undefined: false`, exit 0
// baseline PTS: builds and runs; `[ undefined, null, 1, 3, 'b' ]` x2, `[ 3, undefined, 1, null, 'b' ]`, `... true`, exit 0
// failure: ^\[ undefined, null, 1, 3, 'b' \]$
const loose: any[] = [3, undefined, 1, null, "b"];
console.log(loose.toSorted());
const dynamic: any = [3, undefined, 1, null, "b"];
console.log(dynamic.toSorted());
const seen: string[] = [];
console.log(dynamic.toSorted((a: any, b: any) => {
    seen.push(String(a), String(b));
    return 0;
}));
console.log("comparator saw undefined:", seen.includes("undefined"));
