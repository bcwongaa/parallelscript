// H01b C02 red: for...of over an `any` iterable whose result has `get done()` (true) and a `get value()` that only throws
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): prints `read done` then `end` (value is never read), exit 0
// baseline PTS: `pts build` panics (cgen: no check for void, pts/cgen/checks.go:305), exit 2
// failure: ^panic: cgen: no check for void(?s:.*)pts/cgen/checks\.go:305
const iterable: any = {
    [Symbol.iterator]() {
        return {
            next() {
                return {
                    get done() {
                        console.log("read done");
                        return true;
                    },
                    get value() {
                        throw new Error("value of a done result was read");
                    },
                };
            },
        };
    },
};
for (const item of iterable) {
    console.log("item", item);
}
console.log("end");
