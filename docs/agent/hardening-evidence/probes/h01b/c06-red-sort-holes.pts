// H01b C06 red: holes sort after undefined (sort keeps them as holes at the end; toSorted reads them as undefined)
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): `[ 3, undefined, <1 empty item>, 1, <1 empty item> ]`, `[ 1, 3, undefined, undefined, undefined ]`, `[ 1, 3, undefined, <2 empty items> ]` x2, exit 0
// baseline PTS: builds and runs; toSorted() and sort() give `[ undefined, <2 empty items>, 1, 3 ]`, sort(cmp) `[ undefined, 1, 3, <2 empty items> ]`, exit 0
// failure: ^\[ undefined, <2 empty items>, 1, 3 \]$
function withHoles(): (number | undefined)[] {
    const values = new Array<number | undefined>(5);
    values[0] = 3;
    values[1] = undefined;
    values[3] = 1;
    return values;
}
console.log(withHoles());
console.log(withHoles().toSorted());
console.log(withHoles().sort((a, b) => (a ?? 0) - (b ?? 0)));
console.log(withHoles().sort());
