// H01b C06 red: `.par.sort(comparator)` over 6000 values with 600 undefined: undefined last, never passed to the comparator
// oracle: node:c06-red-par-sort-undefined-comparator.oracle.mts
// threads: 1,2,4
// runs: 3
// expected (Node): `first [ 1, 2, 3, 4, 5 ]`, `last [ undefined, undefined, undefined ]`, `undefined count 600`, `defined ascending: true`, `comparator saw undefined: false`, exit 0
// baseline PTS: builds and runs at 1, 2 and 4 threads but undefined reaches the comparator and sorts first: `last [ 5997, 5998, 5999 ]`, `... true`, exit 0
// failure: ^comparator saw undefined: true$
// With 2+ threads and more than 2048 elements the library's merge also calls the comparator itself.
import { AtomicInt } from "pts:sync";

const values: (number | undefined)[] = [];
for (let i = 0; i < 6000; i++) {
    values.push(i % 10 === 0 ? undefined : (i * 7919) % 6000);
}
const undefinedArguments = new AtomicInt();
values.par.sort((a, b) => {
    if (a === undefined || b === undefined) {
        undefinedArguments.add(1);
    }
    return (a ?? -1) - (b ?? -1);
});
const defined = values.filter((value) => value !== undefined);
console.log("first", defined.slice(0, 5));
console.log("last", values.slice(values.length - 3));
console.log("undefined count", values.length - defined.length);
console.log("defined ascending:", defined.every((value, i) => i === 0 || (defined[i - 1] ?? 0) < (value ?? 0)));
console.log("comparator saw undefined:", undefinedArguments.load() > 0);
