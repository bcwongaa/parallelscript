// H01b C06 red: `toSorted()` with and without a comparator puts undefined last and leaves the source unchanged
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): `[ 1, 20, 3, undefined ]`, `[ 'a', 'v', 'z', undefined ]`, `[ 1, 3, 20, undefined ]`, `comparator saw undefined: false`, `[ 3, undefined, 1, 20 ]`, exit 0
// baseline PTS: builds and runs; undefined first in all three and it reaches the comparator; source unchanged, exit 0
// failure: ^\[ undefined, 1, 20, 3 \]$
const numbers: (number | undefined)[] = [3, undefined, 1, 20];
console.log(numbers.toSorted());
const letters: (string | undefined)[] = ["v", undefined, "a", "z"];
console.log(letters.toSorted());
const seen: string[] = [];
console.log(numbers.toSorted((a, b) => {
    seen.push(String(a), String(b));
    return (a ?? -100) - (b ?? -100);
}));
console.log("comparator saw undefined:", seen.includes("undefined"));
console.log(numbers);
