// H01b C02 control: for…of over an any iterator whose result has done/value getters; done is true, value returns a number
// oracle: node-self
// threads: 1
// runs: 1
// expected (Node): "read done" then "after loop"; value is never read and the body never runs
// baseline PTS: matches Node. The parent first wrote this as a red probe expecting the reported
// panic; it built and matched, so it is kept as the boundary control: the panic needs a value
// getter that never returns (see c02-red-parent-done-getter-throwing-value.pts)
// Parent-written probe (independent of the reviewers' and the reproducer's programs).
const iterable: any = {
  [Symbol.iterator]() {
    return {
      next() {
        return {
          get done() {
            console.log("read done");
            return true;
          },
          get value() {
            console.log("read value");
            return 1;
          },
        };
      },
    };
  },
};

for (const item of iterable) {
  console.log("body", item);
}
console.log("after loop");
