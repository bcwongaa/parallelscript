// H07 C07 red: four `.par.map` tasks each follow 10,000 local controllers with `AbortSignal.any([a, b])` and abort one; none may fail
// oracle: node:c07-red-signal-any-par.oracle.mts
// threads: 1,2,4
// runs: 20
// expected (Node): prints `task 0: failed 0` ... `task 3: failed 0` (4 lines), exit 0
// baseline PTS: 1 thread passes; at 2 and 4 threads AbortController or AbortSignal.any throws `TypeError: Illegal constructor`
// failure: TypeError: Illegal constructor
import { range } from "pts:parallel";

const lines = range(0, 4).par.map((task) => {
    let failed = 0;
    let first = "";
    for (let i = 0; i < 10000; i++) {
        try {
            const a = new AbortController();
            const b = new AbortController();
            const either = AbortSignal.any([a.signal, b.signal]);
            b.abort(i);
            if (!either.aborted || either.reason !== i || a.signal.aborted) {
                throw new Error("wrong any signal");
            }
        } catch (error) {
            failed++;
            if (first === "") {
                first = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
            }
        }
    }
    return `task ${task}: failed ${failed}${first === "" ? "" : ` (first ${first})`}`;
});
for (const line of lines) {
    console.log(line);
}
