[submodule "_submodules/TypeScript"]
	path = _submodules/TypeScript
	url = https://github.com/microsoft/TypeScript.git
	branch = tsgo-port
# PTS: vendored runtime dependencies, pinned to release tags (docs/FORK.md).
[submodule "pts/third_party/bdwgc"]
	path = pts/third_party/bdwgc
	url = https://github.com/ivmai/bdwgc.git
[submodule "pts/third_party/libuv"]
	path = pts/third_party/libuv
	url = https://github.com/libuv/libuv.git
[submodule "pts/third_party/ryu"]
	path = pts/third_party/ryu
	url = https://github.com/ulfjack/ryu
[submodule "pts/third_party/libbacktrace"]
	path = pts/third_party/libbacktrace
	url = https://github.com/ianlancetaylor/libbacktrace
[submodule "pts/third_party/pcre2"]
	path = pts/third_party/pcre2
	url = https://github.com/PCRE2Project/pcre2.git
[submodule "pts/third_party/mbedtls"]
	path = pts/third_party/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls
