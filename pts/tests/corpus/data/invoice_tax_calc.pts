// skip: not supported yet: PTS1001: computed property names
enum TaxClass {
  Standard = "standard",
  Reduced = "reduced",
  Exempt = "exempt",
}

interface Product {
  sku: string;
  name: string;
  price: number;
  taxClass: TaxClass;
}

interface InvoiceLine {
  product: Product;
  qty: number;
  discountPct?: number;
}

const RATES: Record<TaxClass, number> = {
  [TaxClass.Standard]: 0.2,
  [TaxClass.Reduced]: 0.05,
  [TaxClass.Exempt]: 0,
};

function roundCents(n: number): number {
  return Math.round((n + Number.EPSILON) * 100) / 100;
}

class Invoice {
  private static nextNumber = 1001;
  readonly number: string;
  private lines: InvoiceLine[] = [];

  constructor(readonly customer: string, readonly issued: Date) {
    this.number = `INV-${Invoice.nextNumber++}`;
  }

  add(product: Product, qty: number, discountPct?: number): Invoice {
    if (qty <= 0) throw new Error(`Invalid quantity ${qty} for ${product.sku}`);
    this.lines.push({ product, qty, discountPct });
    return this;
  }

  lineNet(l: InvoiceLine): number {
    const gross = l.product.price * l.qty;
    return roundCents(gross * (1 - (l.discountPct ?? 0) / 100));
  }

  get subtotal(): number {
    return roundCents(this.lines.reduce((s, l) => s + this.lineNet(l), 0));
  }

  taxByClass(): Map<TaxClass, number> {
    const m = new Map<TaxClass, number>();
    for (const l of this.lines) {
      const t = l.product.taxClass;
      m.set(t, roundCents((m.get(t) ?? 0) + this.lineNet(l) * RATES[t]));
    }
    return m;
  }

  get tax(): number {
    let total = 0;
    for (const v of this.taxByClass().values()) total += v;
    return roundCents(total);
  }

  get total(): number {
    return roundCents(this.subtotal + this.tax);
  }

  print(): void {
    const due = new Date(this.issued.getTime());
    due.setDate(due.getDate() + 30);
    console.log(`${this.number}  ${this.customer}`);
    console.log(`Issued ${this.issued.toDateString()}  Due ${due.toDateString()}`);
    for (const l of this.lines) {
      const disc = l.discountPct ? ` (-${l.discountPct}%)` : "";
      console.log(`  ${l.product.name.padEnd(18)} ${String(l.qty).padStart(3)} x ${l.product.price.toFixed(2).padStart(7)}${disc.padEnd(8)} ${this.lineNet(l).toFixed(2).padStart(9)}`);
    }
    console.log(`  ${"Subtotal".padEnd(47)} ${this.subtotal.toFixed(2).padStart(9)}`);
    for (const [cls, amt] of this.taxByClass()) {
      console.log(`  ${("Tax " + cls + " " + RATES[cls] * 100 + "%").padEnd(47)} ${amt.toFixed(2).padStart(9)}`);
    }
    console.log(`  ${"TOTAL".padEnd(47)} ${this.total.toFixed(2).padStart(9)}`);
  }
}

const catalog: Product[] = [
  { sku: "BK-1", name: "Paperback book", price: 12.99, taxClass: TaxClass.Reduced },
  { sku: "HP-2", name: "Headphones", price: 59.95, taxClass: TaxClass.Standard },
  { sku: "BR-3", name: "Bread loaf", price: 2.35, taxClass: TaxClass.Exempt },
  { sku: "CB-4", name: "USB cable", price: 7.49, taxClass: TaxClass.Standard },
];
const find = (sku: string): Product => {
  const p = catalog.find((c) => c.sku === sku);
  if (!p) throw new Error(`Unknown SKU ${sku}`);
  return p;
};

const inv = new Invoice("Northwind Traders", new Date(2024, 1, 15));
inv.add(find("BK-1"), 3).add(find("HP-2"), 1, 15).add(find("BR-3"), 4).add(find("CB-4"), 6, 10);
inv.print();

const inv2 = new Invoice("Contoso", new Date(2024, 11, 20));
inv2.add(find("CB-4"), 1).add(find("CB-4"), 2, 33.3);
inv2.print();
console.log(inv2.taxByClass());
console.log({ number: inv2.number, subtotal: inv2.subtotal, tax: inv2.tax, total: inv2.total });

try {
  inv2.add(find("XX-9"), 1);
} catch (e) {
  console.log("error:", (e as Error).message);
}
try {
  inv2.add(find("BK-1"), 0);
} catch (e) {
  console.log("error:", e instanceof Error ? e.message : String(e));
}
console.log((0.1 + 0.2).toFixed(2), (1.005).toFixed(2), (2.675).toFixed(2), roundCents(1.005), (1234.5678).toFixed(0));
