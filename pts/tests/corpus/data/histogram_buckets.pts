function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function normalish(rand: () => number, mean: number, spread: number): number {
  let total = 0;
  for (let i = 0; i < 6; i++) total += rand();
  return mean + (total - 3) * spread;
}

interface Bucket {
  lo: number;
  hi: number;
  count: number;
}

function histogram(values: number[], bucketCount: number): Bucket[] {
  const lo = Math.min(...values);
  const hi = Math.max(...values);
  const width = (hi - lo) / bucketCount;
  const buckets: Bucket[] = Array.from({ length: bucketCount }, (_, i) => ({
    lo: lo + i * width,
    hi: lo + (i + 1) * width,
    count: 0,
  }));
  for (const v of values) {
    let idx = Math.floor((v - lo) / width);
    if (idx >= bucketCount) idx = bucketCount - 1;
    buckets[idx].count++;
  }
  return buckets;
}

const rand = mulberry32(20240501);
const heights: number[] = [];
for (let i = 0; i < 400; i++) heights.push(Math.round(normalish(rand, 170, 9) * 10) / 10);

console.log("first ten:", heights.slice(0, 10));
const hist = histogram(heights, 12);
const maxCount = Math.max(...hist.map((b) => b.count));
for (const b of hist) {
  const bar = "#".repeat(Math.round((b.count / maxCount) * 40));
  console.log(`${b.lo.toFixed(1).padStart(6)} - ${b.hi.toFixed(1).padEnd(6)} | ${String(b.count).padStart(3)} ${bar}`);
}
console.log("total counted:", hist.reduce((a, b) => a + b.count, 0));

const fixedEdges = [150, 160, 165, 170, 175, 180, 190];
const labels = fixedEdges.slice(0, -1).map((e, i) => `[${e},${fixedEdges[i + 1]})`);
const tally: Record<string, number> = Object.fromEntries(labels.map((l) => [l, 0]));
let below = 0;
let above = 0;
for (const h of heights) {
  const i = fixedEdges.findIndex((e, j) => j < fixedEdges.length - 1 && h >= e && h < fixedEdges[j + 1]);
  if (i === -1) {
    if (h < fixedEdges[0]) below++;
    else above++;
  } else {
    tally[labels[i]]++;
  }
}
console.log(tally);
console.log({ below, above });

const dice = mulberry32(7);
const rolls = new Map<number, number>();
for (let i = 0; i < 6000; i++) {
  const r = 1 + Math.floor(dice() * 6) + 1 + Math.floor(dice() * 6);
  rolls.set(r, (rolls.get(r) ?? 0) + 1);
}
const sortedRolls = new Map([...rolls].sort((a, b) => a[0] - b[0]));
console.log(sortedRolls);
for (const [sum, n] of sortedRolls) {
  console.log(`${String(sum).padStart(2)}: ${(n / 60).toFixed(2)}% ${"*".repeat(Math.round(n / 40))}`);
}
console.log(rand(), dice());
