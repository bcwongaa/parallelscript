interface Activity {
  userId: string;
  date: string;
}

function monthKey(iso: string): string {
  return iso.slice(0, 7);
}

function monthsBetween(a: string, b: string): number {
  const [ya, ma] = a.split("-").map(Number);
  const [yb, mb] = b.split("-").map(Number);
  return (yb - ya) * 12 + (mb - ma);
}

function mulberry32(seed: number): () => number {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = seed;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(99);
const activity: Activity[] = [];
const months = ["2024-01", "2024-02", "2024-03", "2024-04", "2024-05", "2024-06"];
let uid = 0;
months.forEach((m, mi) => {
  const newUsers = 20 + Math.floor(rand() * 15);
  for (let u = 0; u < newUsers; u++) {
    const id = `u${++uid}`;
    activity.push({ userId: id, date: `${m}-${String(1 + Math.floor(rand() * 28)).padStart(2, "0")}` });
    let p = 0.65;
    for (let later = mi + 1; later < months.length; later++) {
      if (rand() < p) activity.push({ userId: id, date: `${months[later]}-15` });
      p *= 0.8;
    }
  }
});

const firstSeen = new Map<string, string>();
const activeMonths = new Map<string, Set<string>>();
for (const a of activity) {
  const mk = monthKey(a.date);
  const prev = firstSeen.get(a.userId);
  if (prev === undefined || mk < prev) firstSeen.set(a.userId, mk);
  if (!activeMonths.has(a.userId)) activeMonths.set(a.userId, new Set());
  activeMonths.get(a.userId)!.add(mk);
}

const cohorts = new Map<string, number[]>();
for (const [user, cohort] of firstSeen) {
  const row = cohorts.get(cohort) ?? new Array(months.length).fill(0);
  for (const m of activeMonths.get(user) ?? []) {
    row[monthsBetween(cohort, m)]++;
  }
  cohorts.set(cohort, row);
}

console.log("users:", firstSeen.size, "events:", activity.length);
console.log("cohort   size " + months.map((_, i) => `M${i}`.padStart(6)).join(""));
for (const cohort of [...cohorts.keys()].sort()) {
  const row = cohorts.get(cohort)!;
  const size = row[0];
  const cells = row
    .slice(0, months.length - months.indexOf(cohort))
    .map((n) => ((n / size) * 100).toFixed(0).padStart(5) + "%")
    .join("");
  console.log(`${cohort}  ${String(size).padStart(4)} ${cells}`);
}

const avgRetention = months.slice(1).map((_, k) => {
  const offs = k + 1;
  const eligible = [...cohorts].filter(([c]) => monthsBetween(c, months[months.length - 1]) >= offs);
  const kept = eligible.reduce((s, [, r]) => s + r[offs], 0);
  const base = eligible.reduce((s, [, r]) => s + r[0], 0);
  return { offset: offs, cohorts: eligible.length, rate: Number((kept / base).toFixed(4)) };
});
console.log(avgRetention);
console.log(cohorts);
const mostLoyal = [...activeMonths].filter(([, s]) => s.size === months.length).map(([u]) => u);
console.log("active every month:", mostLoyal);
