// GCD/LCM, extended Euclid, modular exponentiation and inverses, and a toy RSA with small numbers.

const gcd = (a: number, b: number): number => (b === 0 ? Math.abs(a) : gcd(b, a % b));
const lcm = (a: number, b: number): number => (a === 0 || b === 0 ? 0 : Math.abs(a / gcd(a, b) * b));

function extendedGcd(a: number, b: number): { g: number; x: number; y: number } {
  if (b === 0) return { g: a, x: 1, y: 0 };
  const { g, x, y } = extendedGcd(b, a % b);
  return { g, x: y, y: x - Math.floor(a / b) * y };
}

// Multiplication modulo m without overflow beyond 2^53 for m < 2^26.
function mulMod(a: number, b: number, m: number): number {
  return ((a % m) * (b % m)) % m;
}

function powMod(base: number, exp: number, mod: number): number {
  let result = 1 % mod;
  let b = base % mod;
  let e = exp;
  while (e > 0) {
    if (e & 1) result = mulMod(result, b, mod);
    b = mulMod(b, b, mod);
    e = Math.floor(e / 2);
  }
  return result;
}

class NoInverseError extends Error {
  constructor(a: number, m: number) {
    super(`${a} has no inverse modulo ${m}`);
    this.name = "NoInverseError";
  }
}

function invMod(a: number, m: number): number {
  const { g, x } = extendedGcd(((a % m) + m) % m, m);
  if (g !== 1) throw new NoInverseError(a, m);
  return ((x % m) + m) % m;
}

console.log("gcd(1071, 462) =", gcd(1071, 462));
console.log("lcm(21, 6) =", lcm(21, 6), "lcm 1..20 =", Array.from({ length: 20 }, (_, i) => i + 1).reduce(lcm));
console.log("extended(240, 46):", extendedGcd(240, 46));
const { g, x, y } = extendedGcd(99, 78);
console.log(`99*${x} + 78*${y} = ${99 * x + 78 * y} (g=${g})`);

const fractions: [number, number][] = [[42, 56], [100, 75], [17, 51], [-12, 18]];
console.log(fractions.map(([n, d]) => { const k = gcd(n, d); return `${n}/${d} = ${n / k}/${d / k}`; }));

console.log("3^200 mod 13 =", powMod(3, 200, 13));
console.log("2^62 mod 1000007 =", powMod(2, 62, 1000007));
console.log("Fermat check 7^(101-1) mod 101 =", powMod(7, 100, 101));

const fermatProbable = (n: number): boolean => [2, 3, 5, 7].every((a) => a % n === 0 || powMod(a, n - 1, n) === 1);
const carmichaelish = [561, 1105, 1729, 2465].map((n) => ({ n, fermat: fermatProbable(n), divisibleBy: [3, 5, 7, 11, 13, 17].filter((p) => n % p === 0) }));
console.log(carmichaelish);

for (const [a, m] of [[3, 11], [10, 17], [6, 9], [7, 26]] as [number, number][]) {
  try {
    const inv = invMod(a, m);
    console.log(`inverse of ${a} mod ${m} = ${inv}, check ${mulMod(a, inv, m)}`);
  } catch (e) {
    console.log(e instanceof NoInverseError ? `${e.name}: ${e.message}` : e);
  }
}

// Toy RSA with tiny primes.
const p = 61;
const q = 53;
const n = p * q;
const phi = (p - 1) * (q - 1);
const e = 17;
const d = invMod(e, phi);
console.log({ n, phi, e, d });
const message = "HELLO";
const cipher = [...message].map((ch) => powMod(ch.charCodeAt(0), e, n));
const plain = cipher.map((c) => String.fromCharCode(powMod(c, d, n))).join("");
console.log("cipher:", cipher, "decrypted:", plain);

// Chinese remainder theorem.
function crt(residues: number[], moduli: number[]): number {
  const M = moduli.reduce((a, b) => a * b, 1);
  return residues.reduce((sum, r, i) => {
    const Mi = M / moduli[i];
    return (sum + r * Mi * invMod(Mi, moduli[i])) % M;
  }, 0);
}
const xcrt = crt([2, 3, 2], [3, 5, 7]);
console.log("x = 2 mod 3, 3 mod 5, 2 mod 7 ->", xcrt, [3, 5, 7].map((m) => xcrt % m));
console.log("Math.imul(65537, 65537) =", Math.imul(65537, 65537), ">>> 0:", Math.imul(65537, 65537) >>> 0);
