// Fenwick (binary indexed) tree: prefix sums, inversion counting, order statistics, and a 2D variant.

class Fenwick {
  private readonly t: number[];
  constructor(readonly n: number) {
    this.t = new Array<number>(n + 1).fill(0);
  }
  static from(values: number[]): Fenwick {
    const f = new Fenwick(values.length);
    values.forEach((v, i) => f.add(i, v));
    return f;
  }
  add(i: number, delta: number): void {
    for (let x = i + 1; x <= this.n; x += x & -x) this.t[x] += delta;
  }
  prefix(i: number): number {
    let s = 0;
    for (let x = i + 1; x > 0; x -= x & -x) s += this.t[x];
    return s;
  }
  range(l: number, r: number): number {
    return this.prefix(r) - (l > 0 ? this.prefix(l - 1) : 0);
  }
  // Smallest index whose prefix sum reaches k (values must be non-negative).
  lowerBound(k: number): number {
    let pos = 0;
    let rem = k;
    for (let step = 1 << Math.floor(Math.log2(this.n)); step > 0; step >>= 1) {
      if (pos + step <= this.n && this.t[pos + step] < rem) {
        pos += step;
        rem -= this.t[pos];
      }
    }
    return pos;
  }
}

function countInversions(a: number[]): number {
  const sorted = [...new Set(a)].sort((x, y) => x - y);
  const rank = new Map(sorted.map((v, i) => [v, i]));
  const bit = new Fenwick(sorted.length);
  let inv = 0;
  for (let i = a.length - 1; i >= 0; i--) {
    const r = rank.get(a[i])!;
    if (r > 0) inv += bit.prefix(r - 1);
    bit.add(r, 1);
  }
  return inv;
}

function bruteInversions(a: number[]): number {
  let c = 0;
  for (let i = 0; i < a.length; i++) for (let j = i + 1; j < a.length; j++) if (a[i] > a[j]) c++;
  return c;
}

const sales = [12, 7, 3, 15, 9, 4, 11, 8];
const f = Fenwick.from(sales);
console.log("prefix sums:", sales.map((_, i) => f.prefix(i)));
console.log("range [2,5] =", f.range(2, 5), "check", sales.slice(2, 6).reduce((a, b) => a + b));
f.add(3, -5);
console.log("after refund of 5 on day 3: total", f.prefix(sales.length - 1), "range [3,4]", f.range(3, 4));

const tests = [[2, 4, 1, 3, 5], [5, 4, 3, 2, 1], [1, 2, 3], [3, 3, 1, 2, 2], [8, 1, 6, 2, 7, 3, 5, 4]];
for (const t of tests) {
  console.log(`inversions of [${t}]: ${countInversions(t)} (brute ${bruteInversions(t)})`);
}

// Order statistics: a multiset of scores 0..100.
const scores = new Fenwick(101);
const entries = [55, 72, 88, 72, 91, 40, 66, 72, 100, 0];
entries.forEach((s) => scores.add(s, 1));
const kth = (k: number) => scores.lowerBound(k);
console.log("median-ish (5th smallest):", kth(5), "min:", kth(1), "max:", kth(entries.length));
console.log("count <= 70:", scores.prefix(70), "count in [70,90]:", scores.range(70, 90));
const percentiles = [10, 25, 50, 75, 90].map((p) => ({ p, score: kth(Math.max(1, Math.ceil((p / 100) * entries.length))) }));
console.log(percentiles);

class Fenwick2D {
  private t: number[][];
  constructor(private rows: number, private cols: number) {
    this.t = Array.from({ length: rows + 1 }, () => new Array<number>(cols + 1).fill(0));
  }
  add(r: number, c: number, d: number): void {
    for (let i = r + 1; i <= this.rows; i += i & -i)
      for (let j = c + 1; j <= this.cols; j += j & -j) this.t[i][j] += d;
  }
  sum(r: number, c: number): number {
    let s = 0;
    for (let i = r + 1; i > 0; i -= i & -i) for (let j = c + 1; j > 0; j -= j & -j) s += this.t[i][j];
    return s;
  }
  rect(r1: number, c1: number, r2: number, c2: number): number {
    return this.sum(r2, c2) - (r1 ? this.sum(r1 - 1, c2) : 0) - (c1 ? this.sum(r2, c1 - 1) : 0) + (r1 && c1 ? this.sum(r1 - 1, c1 - 1) : 0);
  }
}
const heat = new Fenwick2D(4, 5);
const hits: [number, number, number][] = [[0, 0, 3], [1, 2, 5], [2, 4, 2], [3, 1, 7], [1, 1, 1], [2, 2, 4]];
for (const [r, c, d] of hits) heat.add(r, c, d);
console.log("rect (1,1)-(2,3):", heat.rect(1, 1, 2, 3), "whole:", heat.rect(0, 0, 3, 4));
console.log("row sums:", [0, 1, 2, 3].map((r) => heat.rect(r, 0, r, 4)));
