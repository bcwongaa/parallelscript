// Longest increasing subsequence: O(n^2) DP, patience sorting O(n log n), and applications.

function lisQuadratic(a: number[]): number[] {
  if (a.length === 0) return [];
  const len = a.map(() => 1);
  const prev = a.map(() => -1);
  for (let i = 0; i < a.length; i++) {
    for (let j = 0; j < i; j++) {
      if (a[j] < a[i] && len[j] + 1 > len[i]) {
        len[i] = len[j] + 1;
        prev[i] = j;
      }
    }
  }
  let end = 0;
  len.forEach((l, i) => {
    if (l > len[end]) end = i;
  });
  const out: number[] = [];
  for (let i = end; i !== -1; i = prev[i]) out.push(a[i]);
  return out.reverse();
}

interface Patience {
  piles: number[][];
  sequence: number[];
}

function lisPatience(a: number[], strict = true): Patience {
  const tops: number[] = []; // index of the top card of each pile
  const piles: number[][] = [];
  const back = new Array<number>(a.length).fill(-1);
  for (let i = 0; i < a.length; i++) {
    let lo = 0;
    let hi = tops.length;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      const t = a[tops[mid]];
      if (strict ? t < a[i] : t <= a[i]) lo = mid + 1;
      else hi = mid;
    }
    if (lo > 0) back[i] = tops[lo - 1];
    if (lo === tops.length) {
      tops.push(i);
      piles.push([a[i]]);
    } else {
      tops[lo] = i;
      piles[lo].push(a[i]);
    }
  }
  const sequence: number[] = [];
  for (let i = tops.length ? tops[tops.length - 1] : -1; i >= 0; i = back[i]) sequence.unshift(a[i]);
  return { piles, sequence };
}

const samples = [
  [10, 9, 2, 5, 3, 7, 101, 18],
  [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15],
  [5, 4, 3, 2, 1],
  [1, 3, 3, 3, 2, 4],
  [],
];
for (const s of samples) {
  const q = lisQuadratic(s);
  const p = lisPatience(s);
  console.log(`[${s.join(" ")}] -> n^2: ${q.length} ${JSON.stringify(q)} | patience: ${p.sequence.length}`, p.sequence);
}

const demo = lisPatience([2, 9, 4, 7, 3, 11, 8, 14, 6]);
console.log("piles:", demo.piles);
console.log("non-strict:", lisPatience([1, 3, 3, 3, 2, 4], false).sequence);

// Russian doll envelopes: sort by width asc, height desc, then LIS on heights.
type Envelope = [w: number, h: number];
const envelopes: Envelope[] = [[5, 4], [6, 4], [6, 7], [2, 3], [1, 1], [8, 9], [7, 8], [3, 2]];
const ordered = [...envelopes].sort((x, y) => x[0] - y[0] || y[1] - x[1]);
const nest = lisPatience(ordered.map(([, h]) => h));
console.log("envelopes ordered:", ordered);
console.log("max nesting:", nest.sequence.length, "heights:", nest.sequence);

// Minimum deletions to make a list sorted.
const stocks = [31, 33, 30, 35, 34, 36, 40, 32, 41, 39, 45];
const keep = lisPatience(stocks, false).sequence;
console.log("keep", keep.length, "of", stocks.length, "-> remove", stocks.length - keep.length);
const keepSet = new Set(keep);
console.log("removed values:", stocks.filter((v) => !keepSet.has(v)));

// Longest decreasing subsequence via negation.
const lds = lisPatience(stocks.map((v) => -v)).sequence.map((v) => -v);
console.log("longest decreasing:", lds);
