// Bit tricks: popcount, parity, Gray codes, bit reversal, subset masks and a bitset class.

const popcount = (x: number): number => {
  x = x - ((x >>> 1) & 0x55555555);
  x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
  x = (x + (x >>> 4)) & 0x0f0f0f0f;
  return Math.imul(x, 0x01010101) >>> 24;
};

const parity = (x: number): number => popcount(x) & 1;
const isPowerOfTwo = (x: number): boolean => x > 0 && (x & (x - 1)) === 0;
const lowestBit = (x: number): number => x & -x;
const toGray = (x: number): number => x ^ (x >>> 1);
function fromGray(g: number): number {
  let x = g;
  for (let shift = 1; shift < 32; shift <<= 1) x ^= x >>> shift;
  return x;
}
function reverseBits(x: number): number {
  let r = 0;
  for (let i = 0; i < 32; i++) {
    r = (r << 1) | (x & 1);
    x >>>= 1;
  }
  return r >>> 0;
}
const bin = (x: number, width = 8): string => (x >>> 0).toString(2).padStart(width, "0");
const nextPow2 = (x: number): number => (x <= 1 ? 1 : 2 ** (32 - Math.clz32(x - 1)));

class BitSet {
  private words: number[];
  constructor(readonly size: number) {
    this.words = new Array<number>(Math.ceil(size / 32)).fill(0);
  }
  set(i: number): this {
    this.words[i >>> 5] |= 1 << (i & 31);
    return this;
  }
  has(i: number): boolean {
    return (this.words[i >>> 5] & (1 << (i & 31))) !== 0;
  }
  and(o: BitSet): BitSet {
    const r = new BitSet(this.size);
    r.words = this.words.map((w, i) => w & o.words[i]);
    return r;
  }
  count(): number {
    return this.words.reduce((s, w) => s + popcount(w), 0);
  }
  toArray(): number[] {
    const out: number[] = [];
    for (let i = 0; i < this.size; i++) if (this.has(i)) out.push(i);
    return out;
  }
}

for (const x of [0, 1, 7, 8, 255, 1023, 0x80000000, -1]) {
  console.log(`${String(x).padStart(11)}: pop=${popcount(x)} parity=${parity(x)} pow2=${isPowerOfTwo(x)} low=${lowestBit(x)} clz=${Math.clz32(x)}`);
}

console.log("gray codes 0..15:");
const grays = Array.from({ length: 16 }, (_, i) => toGray(i));
console.log(grays.map((g) => bin(g, 4)).join(" "));
console.log("decode ok:", grays.every((g, i) => fromGray(g) === i));
console.log("adjacent differ by one bit:", grays.every((g, i) => i === 0 || popcount(g ^ grays[i - 1]) === 1));

console.log("reverse 1 ->", reverseBits(1), "hex", reverseBits(1).toString(16));
console.log("reverse 0xF0 ->", reverseBits(0xf0).toString(16), bin(reverseBits(0xf0), 32));
console.log("next powers of two:", [0, 1, 3, 5, 16, 17, 1000, 65537].map(nextPow2));

const items = ["salt", "pepper", "basil", "thyme"];
const masks: string[] = [];
for (let m = 0; m < 1 << items.length; m++) {
  if (popcount(m) !== 2) continue;
  masks.push(`${bin(m, 4)}:${items.filter((_, i) => m & (1 << i)).join("+")}`);
}
console.log("pairs via masks:", masks);

const evens = new BitSet(64);
const triples = new BitSet(64);
for (let i = 0; i < 64; i += 2) evens.set(i);
for (let i = 0; i < 64; i += 3) triples.set(i);
const both = evens.and(triples);
console.log("multiples of 6 below 64:", both.toArray(), "count", both.count());
console.log(both);

console.log("signed vs unsigned shift of -16:", -16 >> 2, -16 >>> 28, (-16 >>> 0).toString(16));
console.log("xor swap:", (() => { let a = 12, b = 34; a ^= b; b ^= a; a ^= b; return [a, b]; })());
const missing = [0, 1, 2, 4, 5, 6, 7].reduce((acc, v, i) => acc ^ v ^ (i + 1), 0);
console.log("missing number in 0..7:", missing);
const single = [4, 1, 2, 1, 2, 7, 4].reduce((a, b) => a ^ b);
console.log("element appearing once:", single, "flags:", (0b1010 | 0b0101).toString(2), (~0b1010 & 0xf).toString(2));
