// Binary search variants: lower/upper bound, rotated arrays, answers on a monotone predicate.

function lowerBound(a: readonly number[], target: number): number {
  let lo = 0;
  let hi = a.length;
  while (lo < hi) {
    const mid = lo + ((hi - lo) >> 1);
    if (a[mid] < target) lo = mid + 1;
    else hi = mid;
  }
  return lo;
}

function upperBound(a: readonly number[], target: number): number {
  let lo = 0;
  let hi = a.length;
  while (lo < hi) {
    const mid = lo + ((hi - lo) >> 1);
    if (a[mid] <= target) lo = mid + 1;
    else hi = mid;
  }
  return lo;
}

function searchRotated(a: readonly number[], target: number): number {
  let lo = 0;
  let hi = a.length - 1;
  while (lo <= hi) {
    const mid = (lo + hi) >> 1;
    if (a[mid] === target) return mid;
    if (a[lo] <= a[mid]) {
      if (a[lo] <= target && target < a[mid]) hi = mid - 1;
      else lo = mid + 1;
    } else {
      if (a[mid] < target && target <= a[hi]) lo = mid + 1;
      else hi = mid - 1;
    }
  }
  return -1;
}

function firstTrue(lo: number, hi: number, pred: (x: number) => boolean): number {
  while (lo < hi) {
    const mid = Math.floor((lo + hi) / 2);
    if (pred(mid)) hi = mid;
    else lo = mid + 1;
  }
  return lo;
}

function sqrtFloat(x: number, eps = 1e-9): number {
  let lo = 0;
  let hi = Math.max(1, x);
  let iterations = 0;
  while (hi - lo > eps) {
    const mid = (lo + hi) / 2;
    if (mid * mid < x) lo = mid;
    else hi = mid;
    iterations++;
  }
  return Number(((lo + hi) / 2).toFixed(6));
}

const sorted = [1, 2, 2, 2, 3, 5, 8, 8, 13, 21, 34];
console.log("array:", sorted);
for (const t of [0, 2, 4, 8, 34, 40]) {
  const lb = lowerBound(sorted, t);
  const ub = upperBound(sorted, t);
  console.log(`target ${String(t).padStart(2)}: lower=${lb} upper=${ub} count=${ub - lb} found=${lb < sorted.length && sorted[lb] === t}`);
}

const rotated = [15, 18, 22, 3, 4, 7, 9, 11, 13];
const lookups = [3, 22, 13, 15, 10];
console.log(
  "rotated lookups:",
  lookups.map((t) => ({ t, at: searchRotated(rotated, t) })),
);

// Minimum ship capacity to deliver packages within D days.
const weights = [3, 2, 2, 4, 1, 4, 7, 5, 6, 9];
function daysNeeded(cap: number): number {
  let days = 1;
  let load = 0;
  for (const w of weights) {
    if (load + w > cap) {
      days++;
      load = 0;
    }
    load += w;
  }
  return days;
}
const total = weights.reduce((s, w) => s + w, 0);
for (const d of [1, 3, 5, 10]) {
  const cap = firstTrue(Math.max(...weights), total, (c) => daysNeeded(c) <= d);
  console.log("ship within %d days -> capacity %d (uses %d days)", d, cap, daysNeeded(cap));
}

for (const x of [2, 10, 0.25, 144, 1e6]) {
  console.log(`sqrt(${x}) ~ ${sqrtFloat(x)} vs Math.sqrt=${Math.sqrt(x).toFixed(6)}`);
}

// Find a peak in a bitonic array.
const bitonic = [1, 4, 9, 15, 23, 20, 12, 6, 2];
const peak = firstTrue(0, bitonic.length - 1, (i) => bitonic[i] > bitonic[i + 1]);
console.log("peak index", peak, "value", bitonic[peak]);

// Search in a 2D matrix with sorted rows and columns (staircase).
const grid = [
  [1, 4, 7, 11],
  [2, 5, 8, 12],
  [3, 6, 9, 16],
  [10, 13, 14, 17],
];
function findInGrid(g: number[][], t: number): [number, number] | null {
  let r = 0;
  let c = g[0].length - 1;
  while (r < g.length && c >= 0) {
    const v = g[r][c];
    if (v === t) return [r, c];
    if (v > t) c--;
    else r++;
  }
  return null;
}
console.log("grid finds:", [5, 14, 15, 1].map((t) => findInGrid(grid, t)));
