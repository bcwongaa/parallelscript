// skip: not supported yet: PTS1001: converting object2 to number
// Segment tree supporting range sum/min/max queries with point updates and lazy range adds.

interface Monoid<T> {
  identity: T;
  combine(a: T, b: T): T;
}

class SegmentTree<T> {
  private tree: T[];
  private readonly n: number;
  queries = 0;

  constructor(values: readonly T[], private readonly m: Monoid<T>) {
    this.n = values.length;
    this.tree = new Array<T>(4 * Math.max(1, this.n)).fill(m.identity);
    if (this.n) this.build(values, 1, 0, this.n - 1);
  }

  private build(v: readonly T[], node: number, lo: number, hi: number): void {
    if (lo === hi) {
      this.tree[node] = v[lo];
      return;
    }
    const mid = (lo + hi) >> 1;
    this.build(v, node * 2, lo, mid);
    this.build(v, node * 2 + 1, mid + 1, hi);
    this.tree[node] = this.m.combine(this.tree[node * 2], this.tree[node * 2 + 1]);
  }

  query(l: number, r: number): T {
    this.queries++;
    const go = (node: number, lo: number, hi: number): T => {
      if (r < lo || hi < l) return this.m.identity;
      if (l <= lo && hi <= r) return this.tree[node];
      const mid = (lo + hi) >> 1;
      return this.m.combine(go(node * 2, lo, mid), go(node * 2 + 1, mid + 1, hi));
    };
    return go(1, 0, this.n - 1);
  }

  update(i: number, value: T): void {
    const go = (node: number, lo: number, hi: number): void => {
      if (lo === hi) {
        this.tree[node] = value;
        return;
      }
      const mid = (lo + hi) >> 1;
      if (i <= mid) go(node * 2, lo, mid);
      else go(node * 2 + 1, mid + 1, hi);
      this.tree[node] = this.m.combine(this.tree[node * 2], this.tree[node * 2 + 1]);
    };
    go(1, 0, this.n - 1);
  }
}

class LazySumTree {
  private sum: number[];
  private lazy: number[];
  constructor(private readonly n: number) {
    this.sum = new Array<number>(4 * n).fill(0);
    this.lazy = new Array<number>(4 * n).fill(0);
  }
  private push(node: number, lo: number, hi: number): void {
    if (this.lazy[node] === 0) return;
    const mid = (lo + hi) >> 1;
    for (const [child, a, b] of [[node * 2, lo, mid], [node * 2 + 1, mid + 1, hi]]) {
      this.sum[child] += this.lazy[node] * (b - a + 1);
      this.lazy[child] += this.lazy[node];
    }
    this.lazy[node] = 0;
  }
  add(l: number, r: number, delta: number, node = 1, lo = 0, hi = this.n - 1): void {
    if (r < lo || hi < l) return;
    if (l <= lo && hi <= r) {
      this.sum[node] += delta * (hi - lo + 1);
      this.lazy[node] += delta;
      return;
    }
    this.push(node, lo, hi);
    const mid = (lo + hi) >> 1;
    this.add(l, r, delta, node * 2, lo, mid);
    this.add(l, r, delta, node * 2 + 1, mid + 1, hi);
    this.sum[node] = this.sum[node * 2] + this.sum[node * 2 + 1];
  }
  total(l: number, r: number, node = 1, lo = 0, hi = this.n - 1): number {
    if (r < lo || hi < l) return 0;
    if (l <= lo && hi <= r) return this.sum[node];
    this.push(node, lo, hi);
    const mid = (lo + hi) >> 1;
    return this.total(l, r, node * 2, lo, mid) + this.total(l, r, node * 2 + 1, mid + 1, hi);
  }
}

const prices = [5, 3, 8, 6, 1, 9, 2, 7, 4, 10];
const sumTree = new SegmentTree(prices, { identity: 0, combine: (a, b) => a + b });
const minTree = new SegmentTree(prices, { identity: Infinity, combine: Math.min });
const maxTree = new SegmentTree(prices, { identity: -Infinity, combine: (a, b) => Math.max(a, b) });
const ranges: [number, number][] = [[0, 9], [2, 5], [4, 4], [7, 9], [0, 2]];
for (const [l, r] of ranges) {
  console.log(`[${l},${r}] sum=${sumTree.query(l, r)} min=${minTree.query(l, r)} max=${maxTree.query(l, r)}`);
}
sumTree.update(4, 20);
minTree.update(4, 20);
console.log("after prices[4]=20: sum[2,5]=%d min[2,5]=%d", sumTree.query(2, 5), minTree.query(2, 5));

type Stats = { min: number; max: number; count: number };
const statsTree = new SegmentTree<Stats>(
  prices.map((p) => ({ min: p, max: p, count: 1 })),
  {
    identity: { min: Infinity, max: -Infinity, count: 0 },
    combine: (a, b) => ({ min: Math.min(a.min, b.min), max: Math.max(a.max, b.max), count: a.count + b.count }),
  },
);
console.log("stats [3,8]:", statsTree.query(3, 8));
console.log("stats empty range:", statsTree.query(5, 4));
const strTree = new SegmentTree(["a", "b", "c", "d", "e"], { identity: "", combine: (a, b) => a + b });
console.log("concat [1,3]:", strTree.query(1, 3), "queries so far:", strTree.queries);

const lazy = new LazySumTree(8);
lazy.add(0, 7, 1);
lazy.add(2, 5, 10);
lazy.add(4, 4, -3);
console.log("lazy totals:", Array.from({ length: 8 }, (_, i) => lazy.total(i, i)));
console.log("lazy range [1,6]:", lazy.total(1, 6), "whole:", lazy.total(0, 7));
