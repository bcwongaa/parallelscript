// Kruskal's minimum spanning tree with a union-find (rank + path compression).

class DisjointSet {
  private parent: number[];
  private rank: number[];
  private _sets: number;
  finds = 0;

  constructor(n: number) {
    this.parent = Array.from({ length: n }, (_, i) => i);
    this.rank = new Array<number>(n).fill(0);
    this._sets = n;
  }

  get sets(): number {
    return this._sets;
  }

  find(x: number): number {
    this.finds++;
    let root = x;
    while (this.parent[root] !== root) root = this.parent[root];
    while (this.parent[x] !== root) {
      const next = this.parent[x];
      this.parent[x] = root;
      x = next;
    }
    return root;
  }

  union(a: number, b: number): boolean {
    let ra = this.find(a);
    let rb = this.find(b);
    if (ra === rb) return false;
    if (this.rank[ra] < this.rank[rb]) [ra, rb] = [rb, ra];
    this.parent[rb] = ra;
    if (this.rank[ra] === this.rank[rb]) this.rank[ra]++;
    this._sets--;
    return true;
  }

  groups(): number[][] {
    const m = new Map<number, number[]>();
    this.parent.forEach((_, i) => {
      const r = this.find(i);
      const g = m.get(r) ?? [];
      g.push(i);
      m.set(r, g);
    });
    return [...m.values()];
  }
}

type WeightedEdge = [from: number, to: number, cost: number];

const towns = ["Ashby", "Brook", "Calder", "Dunmore", "Elm", "Fairfax", "Glen", "Hollow"];
const cables: WeightedEdge[] = [
  [0, 1, 7], [0, 3, 5], [1, 2, 8], [1, 3, 9], [1, 4, 7], [2, 4, 5],
  [3, 4, 15], [3, 5, 6], [4, 5, 8], [4, 6, 9], [5, 6, 11], [6, 7, 3], [5, 7, 13],
];

function kruskal(n: number, edges: WeightedEdge[]) {
  const ds = new DisjointSet(n);
  const chosen: WeightedEdge[] = [];
  const rejected: WeightedEdge[] = [];
  for (const e of [...edges].sort((a, b) => a[2] - b[2] || a[0] - b[0])) {
    if (ds.union(e[0], e[1])) chosen.push(e);
    else rejected.push(e);
    if (chosen.length === n - 1) break;
  }
  return { chosen, rejected, total: chosen.reduce((s, [, , c]) => s + c, 0), ds };
}

const mst = kruskal(towns.length, cables);
console.log("MST edges:");
for (const [a, b, c] of mst.chosen) console.log(`  ${towns[a]} - ${towns[b]}: ${c}`);
console.log("total cost:", mst.total);
console.log("rejected (would form cycles):", mst.rejected.map(([a, b]) => `${towns[a][0]}${towns[b][0]}`));
console.log("finds performed:", mst.ds.finds, "sets left:", mst.ds.sets);

// Clustering: stop early to get k clusters.
function clusters(k: number): string[][] {
  const ds = new DisjointSet(towns.length);
  for (const [a, b] of [...cables].sort((x, y) => x[2] - y[2])) {
    if (ds.sets === k) break;
    ds.union(a, b);
  }
  return ds.groups().map((g) => g.map((i) => towns[i]));
}
for (const k of [2, 3, 4]) console.log(`${k} clusters:`, clusters(k));

// Dynamic connectivity: friend circles.
const ds = new DisjointSet(10);
const friendships: [number, number][] = [[0, 1], [2, 3], [1, 4], [5, 6], [3, 7], [8, 9], [7, 2], [4, 0]];
const log = friendships.map(([a, b]) => ({ pair: `${a}-${b}`, merged: ds.union(a, b), circles: ds.sets }));
console.log(log);
console.log("connected(0,4)=%s connected(0,5)=%s", ds.find(0) === ds.find(4), ds.find(0) === ds.find(5));
console.log(ds);
