// Maze generation with a seeded PRNG: recursive backtracker and Kruskal-style, then solve with BFS.

class Rng {
  private state: number;
  constructor(seed: number) {
    this.state = seed >>> 0;
  }
  next(): number {
    this.state = (this.state + 0x6d2b79f5) >>> 0;
    let t = this.state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }
  int(n: number): number {
    return Math.floor(this.next() * n);
  }
  shuffle<T>(a: T[]): T[] {
    for (let i = a.length - 1; i > 0; i--) {
      const j = this.int(i + 1);
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }
}

const enum Wall {
  N = 1,
  E = 2,
  S = 4,
  W = 8,
}
const DIRS: { wall: Wall; dr: number; dc: number; opposite: Wall }[] = [
  { wall: Wall.N, dr: -1, dc: 0, opposite: Wall.S },
  { wall: Wall.E, dr: 0, dc: 1, opposite: Wall.W },
  { wall: Wall.S, dr: 1, dc: 0, opposite: Wall.N },
  { wall: Wall.W, dr: 0, dc: -1, opposite: Wall.E },
];

class Maze {
  cells: number[][];
  constructor(readonly rows: number, readonly cols: number) {
    this.cells = Array.from({ length: rows }, () => new Array<number>(cols).fill(Wall.N | Wall.E | Wall.S | Wall.W));
  }
  carve(r: number, c: number, d: (typeof DIRS)[number]): void {
    this.cells[r][c] &= ~d.wall;
    this.cells[r + d.dr][c + d.dc] &= ~d.opposite;
  }
  inside(r: number, c: number): boolean {
    return r >= 0 && c >= 0 && r < this.rows && c < this.cols;
  }
  render(path: Set<number> = new Set()): string {
    const lines = ["+" + "---+".repeat(this.cols)];
    for (let r = 0; r < this.rows; r++) {
      let mid = "|";
      let bot = "+";
      for (let c = 0; c < this.cols; c++) {
        mid += (path.has(r * this.cols + c) ? " o " : "   ") + (this.cells[r][c] & Wall.E ? "|" : " ");
        bot += (this.cells[r][c] & Wall.S ? "---" : "   ") + "+";
      }
      lines.push(mid, bot);
    }
    return lines.join("\n");
  }
  solve(): number[] {
    const target = this.rows * this.cols - 1;
    const prev = new Map<number, number>([[0, -1]]);
    const q = [0];
    while (q.length) {
      const id = q.shift()!;
      if (id === target) break;
      const r = Math.floor(id / this.cols);
      const c = id % this.cols;
      for (const d of DIRS) {
        if (this.cells[r][c] & d.wall) continue;
        const nid = (r + d.dr) * this.cols + c + d.dc;
        if (!prev.has(nid)) {
          prev.set(nid, id);
          q.push(nid);
        }
      }
    }
    const path: number[] = [];
    for (let at = target; at !== -1; at = prev.get(at) ?? -1) path.unshift(at);
    return path;
  }
}

function backtracker(rows: number, cols: number, rng: Rng): Maze {
  const m = new Maze(rows, cols);
  const visited = new Set<number>([0]);
  const stack: [number, number][] = [[0, 0]];
  while (stack.length) {
    const [r, c] = stack[stack.length - 1];
    const options = DIRS.filter((d) => m.inside(r + d.dr, c + d.dc) && !visited.has((r + d.dr) * cols + c + d.dc));
    if (!options.length) {
      stack.pop();
      continue;
    }
    const d = options[rng.int(options.length)];
    m.carve(r, c, d);
    visited.add((r + d.dr) * cols + c + d.dc);
    stack.push([r + d.dr, c + d.dc]);
  }
  return m;
}

function kruskalMaze(rows: number, cols: number, rng: Rng): Maze {
  const m = new Maze(rows, cols);
  const parent = Array.from({ length: rows * cols }, (_, i) => i);
  const find = (x: number): number => (parent[x] === x ? x : (parent[x] = find(parent[x])));
  const walls: [number, number, (typeof DIRS)[number]][] = [];
  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) for (const d of [DIRS[1], DIRS[2]]) if (m.inside(r + d.dr, c + d.dc)) walls.push([r, c, d]);
  for (const [r, c, d] of rng.shuffle(walls)) {
    const a = find(r * cols + c);
    const b = find((r + d.dr) * cols + c + d.dc);
    if (a !== b) {
      parent[a] = b;
      m.carve(r, c, d);
    }
  }
  return m;
}

const rng = new Rng(20240115);
console.log("first rolls:", [rng.int(6), rng.int(6), rng.int(6), rng.int(100)]);
const maze = backtracker(6, 10, new Rng(7));
const sol = maze.solve();
console.log(`backtracker 6x10, solution length ${sol.length}`);
console.log(maze.render(new Set(sol)));
const k = kruskalMaze(5, 8, new Rng(99));
console.log(`kruskal 5x8, solution length ${k.solve().length}`);
console.log(k.render());
const deadEnds = (mz: Maze) => mz.cells.flat().filter((w) => [Wall.N, Wall.E, Wall.S, Wall.W].filter((b) => w & b).length === 3).length;
console.log("dead ends:", { backtracker: deadEnds(maze), kruskal: deadEnds(k) });
console.log("row 0 wall masks:", maze.cells[0]);
