// skip: not supported yet: PTS1001: object types with an index signature and methods, optional properties or properties of other types (TemplateStringsArray)
// Tagged template literals as functions: escaping, SQL-like parameter binding, dedent, and units.

function html(strings: TemplateStringsArray, ...values: unknown[]): string {
  const escape = (s: string) => s.split("&").join("&amp;").split("<").join("&lt;").split(">").join("&gt;").split('"').join("&quot;");
  return strings.reduce((out, str, i) => {
    if (i === 0) return str;
    const v = values[i - 1];
    const rendered = Array.isArray(v) ? v.map((x) => String(x)).join("") : escape(String(v));
    return out + rendered + str;
  }, "");
}

const user = { name: "<script>alert(1)</script>", bio: 'Says "hi" & waves' };
const items = ["one", "two & three"].map((x) => html`<li>${x}</li>`);
console.log(html`<p title="${user.bio}">${user.name}</p>`);
console.log(html`<ul>${items}</ul>`);

interface Query {
  text: string;
  params: unknown[];
}
function sql(strings: TemplateStringsArray, ...values: unknown[]): Query {
  let text = strings[0];
  const params: unknown[] = [];
  values.forEach((v, i) => {
    if (Array.isArray(v)) {
      const placeholders = v.map((x) => {
        params.push(x);
        return `$${params.length}`;
      });
      text += `(${placeholders.join(", ")})`;
    } else {
      params.push(v);
      text += `$${params.length}`;
    }
    text += strings[i + 1];
  });
  return { text, params };
}

const minAge = 21;
const statuses = ["active", "trial"];
const q = sql`SELECT * FROM users WHERE age >= ${minAge} AND status IN ${statuses} AND name <> ${"O'Brien"} LIMIT ${10}`;
console.log(q.text);
console.log(q.params);
console.log(sql`SELECT 1`);

function dedent(strings: TemplateStringsArray, ...values: unknown[]): string {
  const raw = strings.reduce((acc, s, i) => acc + s + (i < values.length ? String(values[i]) : ""), "");
  const lines = raw.split("\n");
  while (lines.length && lines[0].trim() === "") lines.shift();
  while (lines.length && lines[lines.length - 1].trim() === "") lines.pop();
  const indent = Math.min(...lines.filter((l) => l.trim() !== "").map((l) => l.length - l.trimStart().length));
  return lines.map((l) => l.slice(indent)).join("\n");
}

const fnName = "greet";
console.log(dedent`
    function ${fnName}(name) {
      if (!name) {
        return "hello, stranger";
      }
      return "hello, " + name;
    }
`);

// Raw strings and String.raw
const path = String.raw`C:\Users\dev\new_folder\table.csv`;
console.log(path, path.length);
function showRaw(strings: TemplateStringsArray, ...values: number[]): string {
  return strings.raw.map((r, i) => `[${r}]${i < values.length ? values[i] : ""}`).join("");
}
console.log(showRaw`a\tb${1}c\nd${2}`);
console.log(`cooked has tab: ${"a\tb".includes("\t")}`, String.raw`\t`.length);

// Unit-aware tag returning numbers in base units
const factors: Record<string, number> = { ms: 1, s: 1000, m: 60000, h: 3600000 };
function duration(strings: TemplateStringsArray, ...values: number[]): number {
  let total = 0;
  values.forEach((v, i) => {
    const unit = strings[i + 1].trim().split(" ")[0];
    const f: number | undefined = factors[unit];
    if (f === undefined) throw new Error(`unknown unit "${unit}"`);
    total += v * f;
  });
  return total;
}
console.log(duration`${1} h ${30} m ${15} s`, duration`${250} ms`, duration`${2} s ${2} s`);
try {
  duration`${3} days`;
} catch (e) {
  console.log((e as Error).message);
}

// Template literal types alongside runtime tags
type Method = "get" | "post";
type Route = `/${string}`;
type Endpoint = `${Uppercase<Method>} ${Route}`;
const endpoints: Endpoint[] = ["GET /users", "POST /users", "GET /users/:id"];
const byMethod = endpoints.reduce<Record<string, string[]>>((acc, e) => {
  const [m, r] = e.split(" ");
  (acc[m] ??= []).push(r);
  return acc;
}, {});
console.log(byMethod);
const tagCalls: string[] = [];
const trace = (strings: TemplateStringsArray, ...vals: unknown[]) => {
  tagCalls.push(`${strings.length} strings, ${vals.length} values`);
  return strings.join("_");
};
console.log(trace`x${1}y${2}z`, trace``, trace`${0}`, tagCalls);
