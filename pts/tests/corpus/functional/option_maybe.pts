// Option/Maybe as a discriminated union with map, flatMap, getOrElse and friends.

type Option<T> = { readonly tag: "some"; readonly value: T } | { readonly tag: "none" };

const some = <T>(value: T): Option<T> => ({ tag: "some", value });
const none: Option<never> = { tag: "none" };

const Opt = {
  fromNullable<T>(x: T | null | undefined): Option<T> {
    return x === null || x === undefined ? none : some(x);
  },
  map<T, U>(o: Option<T>, f: (x: T) => U): Option<U> {
    return o.tag === "some" ? some(f(o.value)) : none;
  },
  flatMap<T, U>(o: Option<T>, f: (x: T) => Option<U>): Option<U> {
    return o.tag === "some" ? f(o.value) : none;
  },
  filter<T>(o: Option<T>, pred: (x: T) => boolean): Option<T> {
    return o.tag === "some" && pred(o.value) ? o : none;
  },
  getOrElse<T>(o: Option<T>, fallback: T): T {
    return o.tag === "some" ? o.value : fallback;
  },
  orElse<T>(o: Option<T>, alt: () => Option<T>): Option<T> {
    return o.tag === "some" ? o : alt();
  },
  match<T, R>(o: Option<T>, cases: { some: (x: T) => R; none: () => R }): R {
    return o.tag === "some" ? cases.some(o.value) : cases.none();
  },
  all<T>(opts: Option<T>[]): Option<T[]> {
    const out: T[] = [];
    for (const o of opts) {
      if (o.tag === "none") return none;
      out.push(o.value);
    }
    return some(out);
  },
  show<T>(o: Option<T>): string {
    return o.tag === "some" ? `Some(${JSON.stringify(o.value)})` : "None";
  },
};

interface Address {
  city: string;
  zip?: string;
}
interface Customer {
  id: number;
  name: string;
  address?: Address;
  managerId?: number;
}

const customers = new Map<number, Customer>([
  [1, { id: 1, name: "Ana", address: { city: "Lisbon", zip: "1100" } }],
  [2, { id: 2, name: "Ben", address: { city: "Porto" }, managerId: 1 }],
  [3, { id: 3, name: "Cleo", managerId: 9 }],
  [4, { id: 4, name: "Dev", managerId: 2, address: { city: "Faro", zip: "8000" } }],
]);

const findCustomer = (id: number): Option<Customer> => Opt.fromNullable(customers.get(id));
const zipOf = (c: Customer): Option<string> => Opt.fromNullable(c.address?.zip);
const managerOf = (c: Customer): Option<Customer> => Opt.flatMap(Opt.fromNullable(c.managerId), findCustomer);

for (const id of [1, 2, 3, 4, 5]) {
  const cust = findCustomer(id);
  const zip = Opt.flatMap(cust, zipOf);
  const managerName = Opt.map(Opt.flatMap(cust, managerOf), (m) => m.name);
  const managerZip = Opt.flatMap(Opt.flatMap(cust, managerOf), zipOf);
  console.log(
    `#${id}: name=${Opt.show(Opt.map(cust, (c) => c.name))} zip=${Opt.getOrElse(zip, "-")} manager=${Opt.show(managerName)} managerZip=${Opt.getOrElse(managerZip, "n/a")}`,
  );
}

const parseIntOpt = (s: string): Option<number> => {
  const n = Number.parseInt(s, 10);
  return Number.isNaN(n) ? none : some(n);
};
const positive = (n: number) => n > 0;

const raw = ["42", "-7", "abc", "13", "0", "8x"];
const parsed = raw.map(parseIntOpt);
console.log(parsed);
console.log(raw.map((s) => Opt.show(Opt.filter(parseIntOpt(s), positive))).join(", "));
console.log("all:", Opt.show(Opt.all(parsed)));
console.log("all valid:", Opt.show(Opt.all(["1", "2", "3"].map(parseIntOpt))));

const describe = (o: Option<number>): string =>
  Opt.match(o, { some: (n) => (n % 2 === 0 ? `even ${n}` : `odd ${n}`), none: () => "nothing" });
console.log(parsed.map(describe));

const firstAvailable = Opt.orElse(Opt.orElse(findCustomer(10), () => findCustomer(11)), () => findCustomer(3));
console.log("first available:", Opt.map(firstAvailable, (c) => c.name));

// Safe head / lookup helpers
const head = <T>(xs: readonly T[]): Option<T> => (xs.length > 0 ? some(xs[0]) : none);
const lookup = <V>(r: Record<string, V>, k: string): Option<V> => (k in r ? some(r[k]) : none);
const env: Record<string, string> = { HOME: "/home/demo", SHELL: "/bin/zsh", PORT: "3000" };
console.log(Opt.show(head([])), Opt.show(head(["x", "y"])));
const port = Opt.getOrElse(Opt.flatMap(lookup(env, "PORT"), parseIntOpt), 80);
const debugPort = Opt.getOrElse(Opt.flatMap(lookup(env, "DEBUG_PORT"), parseIntOpt), 9229);
console.log({ port, debugPort, shell: Opt.getOrElse(lookup(env, "SHELL"), "/bin/sh") });

const total = parsed.reduce((sum, o) => sum + Opt.getOrElse(o, 0), 0);
console.log("sum of parseable: %d", total);
