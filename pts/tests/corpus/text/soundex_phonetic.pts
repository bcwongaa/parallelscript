// Phonetic name matching: American Soundex, a simplified NYSIIS-style key, and
// grouping a list of surnames into sound-alike buckets.
const SOUNDEX_CODES: Record<string, string> = {
  b: "1", f: "1", p: "1", v: "1",
  c: "2", g: "2", j: "2", k: "2", q: "2", s: "2", x: "2", z: "2",
  d: "3", t: "3", l: "4", m: "5", n: "5", r: "6",
};

function soundex(name: string): string {
  const letters = [...name.toLowerCase()].filter((c) => c >= "a" && c <= "z");
  if (letters.length === 0) return "";
  const first = letters[0];
  let result = first.toUpperCase();
  let prevCode = SOUNDEX_CODES[first] ?? "";
  for (const c of letters.slice(1)) {
    const code = SOUNDEX_CODES[c] ?? "";
    if (code && code !== prevCode) result += code;
    if (c !== "h" && c !== "w") prevCode = code;
    if (result.length === 4) break;
  }
  return result.padEnd(4, "0");
}

function phoneticKey(name: string): string {
  let s = name.toUpperCase().split("").filter((c) => c >= "A" && c <= "Z").join("");
  const prefixes: [string, string][] = [["MAC", "MCC"], ["KN", "NN"], ["K", "C"], ["PH", "FF"], ["PF", "FF"], ["SCH", "SSS"]];
  for (const [from, to] of prefixes) {
    if (s.startsWith(from)) { s = to + s.slice(from.length); break; }
  }
  const suffixes: [string, string][] = [["EE", "Y"], ["IE", "Y"], ["DT", "D"], ["RT", "D"], ["RD", "D"], ["NT", "D"], ["ND", "D"]];
  for (const [from, to] of suffixes) {
    if (s.endsWith(from)) { s = s.slice(0, -from.length) + to; break; }
  }
  if (!s) return "";
  let key = s[0];
  for (let i = 1; i < s.length; i++) {
    let c = s[i];
    if ("AEIOU".includes(c)) c = s.slice(i, i + 2) === "EV" ? "AF" : "A";
    else if (c === "Q") c = "G";
    else if (c === "Z") c = "S";
    else if (c === "M") c = "N";
    else if (s.slice(i, i + 2) === "KN") c = "N";
    else if (c === "K") c = "C";
    else if (s.slice(i, i + 3) === "SCH") c = "SSS";
    else if (s.slice(i, i + 2) === "PH") c = "FF";
    else if (c === "H" && (!"AEIOU".includes(s[i - 1]) || (i + 1 < s.length && !"AEIOU".includes(s[i + 1])))) c = s[i - 1];
    else if (c === "W" && "AEIOU".includes(s[i - 1])) c = s[i - 1];
    if (c[c.length - 1] !== key[key.length - 1]) key += c[c.length - 1];
  }
  if (key.length > 1 && key.endsWith("S")) key = key.slice(0, -1);
  if (key.endsWith("AY")) key = key.slice(0, -2) + "Y";
  if (key.length > 1 && key.endsWith("A")) key = key.slice(0, -1);
  return key.slice(0, 6);
}

const reference: [string, string][] = [
  ["Robert", "R163"], ["Rupert", "R163"], ["Rubin", "R150"], ["Ashcraft", "A261"], ["Ashcroft", "A261"],
  ["Tymczak", "T522"], ["Pfister", "P236"], ["Honeyman", "H555"], ["Lee", "L000"], ["Gutierrez", "G362"],
];
let failures = 0;
for (const [name, expected] of reference) {
  const got = soundex(name);
  if (got !== expected) failures++;
  console.log(`${name.padEnd(10)} ${got} ${got === expected ? "✓" : `✗ expected ${expected}`}`);
}
console.log(`${reference.length - failures}/${reference.length} soundex reference codes correct`);

const surnames = [
  "Smith", "Smyth", "Smithe", "Schmidt", "Johnson", "Jonson", "Johnsen", "Jansen", "Macdonald", "McDonald",
  "Knight", "Night", "Philips", "Phillips", "Filips", "Catherine", "Kathryn", "Katherine", "Stewart", "Stuart", "Steward",
];
function bucket(key: (s: string) => string): Map<string, string[]> {
  const m = new Map<string, string[]>();
  for (const n of surnames) {
    const k = key(n);
    m.set(k, [...(m.get(k) ?? []), n]);
  }
  return m;
}
const bySoundex = bucket(soundex);
const byKey = bucket(phoneticKey);
console.log("soundex buckets:", bySoundex.size, "phonetic-key buckets:", byKey.size);
for (const [k, names] of bySoundex) if (names.length > 1) console.log(`  ${k}: ${names.join(", ")}`);
console.log(byKey);
const table = surnames.slice(0, 8).map((n) => ({ name: n, soundex: soundex(n), key: phoneticKey(n) }));
console.table(table);
console.log(soundex(""), JSON.stringify(soundex("123")), soundex("O'Brien"), soundex("van der Berg"));
