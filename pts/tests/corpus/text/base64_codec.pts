// Base64 encoding and decoding written by hand, with UTF-8 encoding and URL-safe variants.
const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

class Base64Error extends Error {
  constructor(message: string) {
    super(message);
    this.name = "Base64Error";
  }
}

function utf8Encode(s: string): number[] {
  const bytes: number[] = [];
  for (const ch of s) {
    const cp = ch.codePointAt(0) ?? 0;
    if (cp < 0x80) bytes.push(cp);
    else if (cp < 0x800) bytes.push(0xc0 | (cp >> 6), 0x80 | (cp & 63));
    else if (cp < 0x10000) bytes.push(0xe0 | (cp >> 12), 0x80 | ((cp >> 6) & 63), 0x80 | (cp & 63));
    else bytes.push(0xf0 | (cp >> 18), 0x80 | ((cp >> 12) & 63), 0x80 | ((cp >> 6) & 63), 0x80 | (cp & 63));
  }
  return bytes;
}

function utf8Decode(bytes: number[]): string {
  let out = "";
  let i = 0;
  while (i < bytes.length) {
    const b = bytes[i];
    let cp: number, n: number;
    if (b < 0x80) { cp = b; n = 0; }
    else if (b >> 5 === 6) { cp = b & 31; n = 1; }
    else if (b >> 4 === 14) { cp = b & 15; n = 2; }
    else { cp = b & 7; n = 3; }
    for (let k = 1; k <= n; k++) cp = (cp << 6) | (bytes[i + k] & 63);
    out += String.fromCodePoint(cp);
    i += n + 1;
  }
  return out;
}

function encode(bytes: number[], urlSafe = false): string {
  let out = "";
  for (let i = 0; i < bytes.length; i += 3) {
    const chunk = bytes.slice(i, i + 3);
    const n = (chunk[0] << 16) | ((chunk[1] ?? 0) << 8) | (chunk[2] ?? 0);
    const chars = [(n >> 18) & 63, (n >> 12) & 63, (n >> 6) & 63, n & 63].map((x) => ALPHABET[x]);
    out += chars.slice(0, chunk.length + 1).join("") + (urlSafe ? "" : "=".repeat(3 - chunk.length));
  }
  return urlSafe ? out.split("+").join("-").split("/").join("_") : out;
}

function decode(text: string): number[] {
  const clean = text.split("-").join("+").split("_").join("/").split("=").join("");
  const bytes: number[] = [];
  let buffer = 0, bits = 0;
  for (const c of clean) {
    const v = ALPHABET.indexOf(c);
    if (v < 0) throw new Base64Error(`invalid character ${JSON.stringify(c)}`);
    buffer = (buffer << 6) | v;
    bits += 6;
    if (bits >= 8) {
      bits -= 8;
      bytes.push((buffer >> bits) & 255);
    }
  }
  if (bits >= 6) throw new Base64Error("truncated input");
  return bytes;
}

const hex = (bytes: number[]) => bytes.map((b) => b.toString(16).padStart(2, "0")).join(" ");

const inputs = ["", "f", "fo", "foo", "foob", "fooba", "foobar", "Man", "héllo wörld", "日本語", "emoji 🚀✨", "a+b/c?d"];
for (const s of inputs) {
  const bytes = utf8Encode(s);
  const b64 = encode(bytes);
  const back = utf8Decode(decode(b64));
  console.log(`${JSON.stringify(s).padEnd(16)} ${String(bytes.length).padStart(2)}B ${b64.padEnd(24)} ${back === s ? "✓" : "✗"}`);
}
console.log(hex(utf8Encode("€ 🙂")));
console.log(encode(utf8Encode("subjects?_d>>"), false), encode(utf8Encode("subjects?_d>>"), true));
console.log(utf8Decode(decode("c3ViamVjdHM_X2Q-Pg")));
console.log(decode("AAEC/w=="));
console.log(encode([0, 1, 2, 253, 254, 255]));

const all = Array.from({ length: 256 }, (_, i) => i);
const allEncoded = encode(all);
console.log(allEncoded.length, allEncoded.slice(0, 40) + "...");
console.log("all bytes round trip:", decode(allEncoded).every((b, i) => b === i));

for (const bad of ["ab$c", "A", "Zm9v!"]) {
  try {
    console.log(decode(bad));
  } catch (e) {
    console.log(String(e));
  }
}
const lengths = inputs.map((s) => ({ s, ratio: +(encode(utf8Encode(s)).length / Math.max(1, s.length)).toFixed(2) }));
console.log(lengths.slice(5, 10));
