// Number to English words: cardinals, ordinals, currency amounts and cheque formatting.
const ONES = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
  "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"];
const TENS = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];
const SCALES = ["", "thousand", "million", "billion", "trillion", "quadrillion"];

function underThousand(n: number): string {
  const parts: string[] = [];
  const hundreds = Math.floor(n / 100);
  const rest = n % 100;
  if (hundreds > 0) parts.push(`${ONES[hundreds]} hundred`);
  if (rest > 0) {
    if (hundreds > 0) parts.push("and");
    if (rest < 20) parts.push(ONES[rest]);
    else parts.push(TENS[Math.floor(rest / 10)] + (rest % 10 ? "-" + ONES[rest % 10] : ""));
  }
  return parts.join(" ");
}

function toWords(n: number): string {
  if (!Number.isSafeInteger(n)) throw new RangeError(`cannot spell ${n}`);
  if (n < 0) return "minus " + toWords(-n);
  if (n === 0) return "zero";
  const groups: string[] = [];
  let scale = 0;
  while (n > 0) {
    if (scale >= SCALES.length) throw new RangeError("number too large");
    const chunk = n % 1000;
    if (chunk > 0) groups.unshift(underThousand(chunk) + (SCALES[scale] ? " " + SCALES[scale] : ""));
    n = Math.floor(n / 1000);
    scale++;
  }
  return groups.join(", ");
}

const ORDINAL_EXCEPTIONS: Record<string, string> = {
  one: "first", two: "second", three: "third", five: "fifth", eight: "eighth", nine: "ninth", twelve: "twelfth",
};

function toOrdinalWords(n: number): string {
  const words = toWords(n);
  const lastSep = Math.max(words.lastIndexOf(" "), words.lastIndexOf("-"));
  const head = words.slice(0, lastSep + 1);
  const last = words.slice(lastSep + 1);
  if (last in ORDINAL_EXCEPTIONS) return head + ORDINAL_EXCEPTIONS[last];
  if (last.endsWith("y")) return head + last.slice(0, -1) + "ieth";
  return head + last + "th";
}

function ordinalSuffix(n: number): string {
  const mod100 = n % 100;
  if (mod100 >= 11 && mod100 <= 13) return `${n}th`;
  switch (n % 10) {
    case 1: return `${n}st`;
    case 2: return `${n}nd`;
    case 3: return `${n}rd`;
    default: return `${n}th`;
  }
}

function cheque(amount: number): string {
  const cents = Math.round(amount * 100);
  const dollars = Math.floor(cents / 100);
  const rest = cents % 100;
  const word = toWords(dollars);
  return `${word.charAt(0).toUpperCase()}${word.slice(1)} dollar${dollars === 1 ? "" : "s"} and ${String(rest).padStart(2, "0")}/100`;
}

const numbers = [0, 7, 13, 21, 99, 100, 101, 342, 1000, 1001, 12345, 100000, 1000001, 987654321, -45, 2 ** 40];
for (const n of numbers) console.log(`${String(n).padStart(14)}  ${toWords(n)}`);

console.log([1, 2, 3, 4, 5, 8, 9, 11, 12, 20, 21, 40, 99, 100, 112, 1000].map(toOrdinalWords).join(", "));
console.log([1, 2, 3, 4, 11, 12, 13, 21, 22, 23, 101, 111, 112, 1003].map(ordinalSuffix));

for (const amt of [0.99, 1, 1.5, 19.95, 1234.56, 100000.01]) console.log(`$${amt.toFixed(2).padStart(10)}  ${cheque(amt)}`);

const lengthStats = new Map<number, number[]>();
for (let n = 1; n <= 100; n++) {
  const letters = toWords(n).split(" ").join("").split("-").join("").length;
  const list = lengthStats.get(letters) ?? [];
  list.push(n);
  lengthStats.set(letters, list);
}
const longestLen = Math.max(...lengthStats.keys());
console.log("longest spelled 1..100:", longestLen, "letters:", lengthStats.get(longestLen));
let total = 0;
for (let n = 1; n <= 1000; n++) total += toWords(n).split(" ").join("").split("-").join("").split(",").join("").length;
console.log("letters used for 1..1000 (British 'and'):", total);

for (const bad of [1.5, Number.MAX_SAFE_INTEGER + 2, NaN]) {
  try {
    toWords(bad);
  } catch (e) {
    console.log(e instanceof RangeError, (e as RangeError).message);
  }
}
console.log({ big: toWords(Number.MAX_SAFE_INTEGER).split(", ") });
