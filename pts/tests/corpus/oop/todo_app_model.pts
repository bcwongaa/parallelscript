// To-do application model: projects, tasks with priorities, tags, filters and JSON persistence.

type Priority = "low" | "medium" | "high";
const PRIORITY_ORDER: Record<Priority, number> = { high: 0, medium: 1, low: 2 };

interface TaskData {
  id: number;
  title: string;
  priority: Priority;
  tags: string[];
  due?: string;
  done: boolean;
}

class Task {
  private static lastId = 0;
  readonly id: number;
  done = false;
  readonly tags = new Set<string>();

  constructor(public title: string, public priority: Priority = "medium", public due?: string) {
    this.id = ++Task.lastId;
  }

  tag(...tags: string[]): Task {
    tags.forEach((t) => this.tags.add(t.toLowerCase()));
    return this;
  }

  complete(): void {
    this.done = true;
  }

  isOverdue(today: string): boolean {
    return !this.done && this.due !== undefined && this.due < today;
  }

  toJSON(): TaskData {
    const data: TaskData = { id: this.id, title: this.title, priority: this.priority, tags: [...this.tags], done: this.done };
    if (this.due) data.due = this.due;
    return data;
  }

  static fromJSON(d: TaskData): Task {
    const t = new Task(d.title, d.priority, d.due);
    t.tag(...d.tags);
    if (d.done) t.complete();
    return t;
  }

  toString(): string {
    const box = this.done ? "[x]" : "[ ]";
    const tags = this.tags.size ? " #" + [...this.tags].join(" #") : "";
    const due = this.due ? ` (due ${this.due})` : "";
    return `${box} ${this.title} !${this.priority}${due}${tags}`;
  }
}

type Filter = (t: Task) => boolean;

class Project {
  private tasks: Task[] = [];
  constructor(readonly name: string) {}

  add(title: string, priority?: Priority, due?: string): Task {
    const t = new Task(title, priority, due);
    this.tasks.push(t);
    return t;
  }

  query(...filters: Filter[]): Task[] {
    return this.tasks
      .filter((t) => filters.every((f) => f(t)))
      .sort((a, b) => Number(a.done) - Number(b.done) || PRIORITY_ORDER[a.priority] - PRIORITY_ORDER[b.priority] || (a.due ?? "~").localeCompare(b.due ?? "~"));
  }

  get progress(): string {
    const done = this.tasks.filter((t) => t.done).length;
    const pct = this.tasks.length ? Math.round((done / this.tasks.length) * 100) : 0;
    return `${done}/${this.tasks.length} done (${pct}%)`;
  }

  serialize(): string {
    return JSON.stringify({ name: this.name, tasks: this.tasks });
  }

  static load(json: string): Project {
    const raw = JSON.parse(json) as { name: string; tasks: TaskData[] };
    const p = new Project(raw.name + " (copy)");
    p.tasks = raw.tasks.map((d) => Task.fromJSON(d));
    return p;
  }

  tagCloud(): Map<string, number> {
    const m = new Map<string, number>();
    for (const t of this.tasks) for (const tag of t.tags) m.set(tag, (m.get(tag) ?? 0) + 1);
    return m;
  }
}

const notDone: Filter = (t) => !t.done;
const tagged = (tag: string): Filter => (t) => t.tags.has(tag);
const today = "2024-04-10";

const home = new Project("Home");
home.add("Pay rent", "high", "2024-04-01").tag("Money");
home.add("Buy groceries", "medium", "2024-04-11").tag("errands", "food");
home.add("Fix bike", "low").tag("errands");
home.add("Book dentist", "medium", "2024-04-09").tag("health");
home.add("Plan trip", "low", "2024-06-01").tag("fun", "money");
home.query(tagged("health"))[0].complete();
home.query((t) => t.title.startsWith("Pay"))[0].complete();

console.log(`${home.name}: ${home.progress}`);
home.query().forEach((t) => console.log(String(t)));
console.log("open errands:", home.query(notDone, tagged("errands")).map((t) => t.title));
console.log("overdue:", home.query((t) => t.isOverdue(today)).map((t) => t.id));
console.log(home.tagCloud());

const json = home.serialize();
console.log(json.length, json.slice(0, 90));
const copy = Project.load(json);
console.log(`${copy.name}: ${copy.progress}`);
console.log(copy.query(notDone).map((t) => `${t}`));
console.log(copy.query()[0]);
console.log(JSON.stringify(copy.query(tagged("money")), null, 2));
