// skip: not supported yet: PTS1001: a Set<string> of a string
// Checks passwords against a policy, throwing a PolicyViolation that lists
// all violated rules, and scores the passwords that pass.

enum Rule {
  Length = "LENGTH",
  Upper = "UPPER",
  Lower = "LOWER",
  Digit = "DIGIT",
  Symbol = "SYMBOL",
  Repeat = "REPEAT",
  Common = "COMMON",
  ContainsUser = "CONTAINS_USER",
}

class PolicyViolation extends Error {
  constructor(readonly user: string, readonly rules: Rule[]) {
    super(`password for ${user} violates ${rules.length} rule(s): ${rules.join(", ")}`);
    this.name = "PolicyViolation";
  }
}

const COMMON = new Set(["password", "123456", "qwerty", "letmein", "dragon"]);
const SYMBOLS = "!@#$%^&*()-_=+[]{};:,.?";

function has(pw: string, pred: (c: string) => boolean): boolean {
  return pw.split("").some(pred);
}

function maxRun(pw: string): number {
  let best = pw.length > 0 ? 1 : 0;
  let run = 1;
  for (let i = 1; i < pw.length; i++) {
    run = pw[i] === pw[i - 1] ? run + 1 : 1;
    best = Math.max(best, run);
  }
  return best;
}

function check(user: string, pw: string, minLength = 10): number {
  const violations: Rule[] = [];
  if (pw.length < minLength) violations.push(Rule.Length);
  if (!has(pw, (c) => c >= "A" && c <= "Z")) violations.push(Rule.Upper);
  if (!has(pw, (c) => c >= "a" && c <= "z")) violations.push(Rule.Lower);
  if (!has(pw, (c) => c >= "0" && c <= "9")) violations.push(Rule.Digit);
  if (!has(pw, (c) => SYMBOLS.includes(c))) violations.push(Rule.Symbol);
  if (maxRun(pw) >= 3) violations.push(Rule.Repeat);
  if (COMMON.has(pw.toLowerCase())) violations.push(Rule.Common);
  if (user.length >= 3 && pw.toLowerCase().includes(user.toLowerCase())) violations.push(Rule.ContainsUser);
  if (violations.length > 0) throw new PolicyViolation(user, violations);
  const classes = new Set(pw.split("").map((c) => (c >= "0" && c <= "9" ? "d" : SYMBOLS.includes(c) ? "s" : c === c.toUpperCase() ? "U" : "l")));
  return Math.min(100, pw.length * 4 + classes.size * 10 + (new Set(pw).size - 5) * 2);
}

const attempts: Array<[string, string]> = [
  ["alice", "Tr0ub4dor&3x"],
  ["bob", "password"],
  ["carol", "carolRocks!2024"],
  ["dan", "aaaBBB111!!!"],
  ["erin", "correct-Horse-battery-9"],
  ["frank", "Short1!"],
  ["gina", "ALLUPPERCASE123!"],
  ["hank", ""],
];

const violationCounts = new Map<Rule, number>();
const scores: Record<string, number> = {};
for (const [user, pw] of attempts) {
  try {
    const score = check(user, pw);
    scores[user] = score;
    console.log(`${user}: accepted, strength ${score}`);
  } catch (e) {
    if (!(e instanceof PolicyViolation)) throw e;
    console.log(`${user}: rejected -> ${e.rules.map((r) => r.toLowerCase()).join(" ")}`);
    for (const r of e.rules) violationCounts.set(r, (violationCounts.get(r) ?? 0) + 1);
  }
}
console.log(scores);
console.log([...violationCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])));
try {
  check("zoe", "zoe", 3);
} catch (e) {
  const v = e as PolicyViolation;
  console.log(v.name, v.user, v.rules.length, v.message);
}
