// Promises settled and awaited across loops (D-121): tasks that start tasks, chains of
// promises handed between loops, rejections caught on other loops, combinators over
// tasks, timers inside tasks, and resolvers called from the pool.
// threads: 1 2 4 8
import { range } from "pts:parallel";

// Tasks that start tasks, three levels deep.
async function tree(depth: number, id: number): Promise<number> {
  if (depth === 0) return id;
  const children = await Promise.all([parallel tree(depth - 1, id * 3), parallel tree(depth - 1, id * 3 + 1), tree(depth - 1, id * 3 + 2)]);
  return children.reduce((a, b) => a + b, 0);
}
console.log(await tree(5, 1));

// A promise made on one loop, settled on another and awaited on a third.
type Relay = PromiseWithResolvers<number>;
async function settle(relay: Relay, value: number): Promise<void> {
  relay.resolve(value);
}
async function relayed(relay: Relay): Promise<number> {
  const value = await relay.promise;
  return value + 1;
}
const relays = range(0, 100).toArray().map(() => Promise.withResolvers<number>());
const awaiters = Promise.all(relays.map((relay) => parallel relayed(relay)));
await Promise.all(relays.map((relay, i) => parallel settle(relay, i * 2)));
console.log((await awaiters).reduce((a, b) => a + b, 0));

// Rejections in tasks, caught where they are awaited; any, race and allSettled over tasks.
async function failing(i: number): Promise<number> {
  if (i % 3 === 0) throw new RangeError("bad " + i);
  return i;
}
const settled = await Promise.allSettled(range(0, 60).toArray().map((i) => parallel failing(i)));
console.log(settled.filter((s) => s.status === "rejected").length, settled.filter((s) => s.status === "fulfilled").length);
const outcomes = range(0, 30).toArray().map((i) => (parallel failing(i)).then(() => 0, (e: any) => (e instanceof RangeError ? 1 : 100)));
let caught = 0;
for (const outcome of outcomes) {
  caught += await outcome;
}
console.log(caught, await Promise.any([parallel failing(0), parallel failing(3), parallel failing(4)]));
console.log(await Promise.race([parallel failing(5), new Promise<number>(() => {})]));

// Timers inside tasks on every loop.
function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}
async function napping(i: number): Promise<number> {
  await sleep(i % 5);
  await sleep(1);
  return i;
}
const timed = await Promise.all(range(0, 40).toArray().map((i) => parallel napping(i)));
console.log(timed.reduce((a, b) => a + b, 0));

// Resolvers called from pool threads: the promises settle on their own loop.
const pending = range(0, 1000).toArray().map(() => Promise.withResolvers<number>());
range(0, 1000).par.forEach((i) => pending[i].resolve(i));
const values = await Promise.all(pending.map((p) => p.promise));
console.log(values.reduce((a, b) => a + b, 0));

// expect:
// 88452
// 10000
// 20 40
// 10 4
// 5
// 780
// 499500
