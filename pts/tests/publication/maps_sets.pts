// Maps and sets made from entries, and a map and a Record filled by sets after they were
// made, published into module-scope bindings a task on another loop reads (H35b, D-226):
// each construction must reach other threads before the store that publishes it; the sets
// are changes, whose entries the map's own release stores order.
// threads: 1 2 4
let byName = new Map<string, number>();
let seen = new Set<string>();
let counts: Record<string, number> = {};

function build(): void {
  const m = new Map<string, number>([
    ["one", 1],
    ["two", 2],
  ]);
  for (let i = 3; i < 12; i++) m.set(`k${i}`, i);
  byName = m;
  seen = new Set(["a", "b", "a", "c"]);
  const r: Record<string, number> = {};
  for (const w of ["x", "y", "x"]) r[w] = (r[w] ?? 0) + 1;
  counts = r;
}

function describe(): string {
  return `${byName.size} ${byName.get("two")} ${byName.get("k11")} ${[...seen].join("")} ${counts["x"]}${counts["y"]}`;
}

build();
console.log(await parallel describe());

// expect:
// 11 2 11 abc 21
