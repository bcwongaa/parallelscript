// Objects sent through a pts:sync Channel to tasks on other loops, and the channel itself
// made at run time and published into a module-scope binding (H35b).
// publication: strict
// threads: 1 2 4
import { Channel } from "pts:sync";

type Job = { id: number; name: string; tags: string[] };

let jobs: Channel<Job> = new Channel<Job>(0);

async function consume(): Promise<string> {
  const seen: string[] = [];
  for await (const job of jobs) seen.push(`${job.id}:${job.name}:${job.tags.join("+")}`);
  return seen.join(" ");
}

jobs = new Channel<Job>(2);
const consumer = parallel consume();
for (let i = 1; i <= 3; i++) await jobs.send({ id: i, name: `job${i}`, tags: ["t", String(i)] });
jobs.close();
console.log(await consumer);

// expect:
// 1:job1:t+1 2:job2:t+2 3:job3:t+3
