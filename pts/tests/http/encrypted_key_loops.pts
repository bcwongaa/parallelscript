// serve's tls with an encrypted key on one loop, then on every loop, for
// TestHTTPSServerDecryptsItsKeyOnce: TLS_KEY_FILE is encrypted with TLS_PASSPHRASE at many
// PBKDF2 iterations, so decrypting it takes a while, and serving on every loop takes about
// as long as serving on one, since the other loops take the key the first decrypted. It
// prints "listening", the every-loop server's port and how many times longer that server
// took to start; GET /stop on it stops both servers, so the program ends.
import { serve, type TLSOptions } from "pts:http";

const tls: TLSOptions = { certFile: process.env.TLS_CERT_FILE, keyFile: process.env.TLS_KEY_FILE, passphrase: process.env.TLS_PASSPHRASE };

let start = performance.now();
const one = serve({ port: 0, hostname: "127.0.0.1", tls, fetch: () => new Response("one loop") });
const oneLoop = performance.now() - start;
start = performance.now();
const every = serve({
  port: 0,
  hostname: "127.0.0.1",
  reusePort: true,
  tls,
  fetch(request, server) {
    if (request.url.endsWith("/stop")) {
      one.stop();
      server.stop();
      return new Response("bye");
    }
    return new Response("every loop");
  },
});
const everyLoop = performance.now() - start;
console.log("listening", every.port, one.port, (everyLoop / oneLoop).toFixed(2));
