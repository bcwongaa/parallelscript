// A default value must convert to its parameter's numeric type without loss (D-055).
function byte(x: u8 = 300): u8 {
  return x;
}
function whole(x: u8 = 1.5): u8 {
  return x;
}
let n = 1.5;
function wide(x: int = n): int {
  return x;
}

