// Reading a file without an encoding gives a Buffer in Node, which waits for typed arrays
// (D-117); with an encoding it is a string.
import fs, { readFileSync } from "pts:fs";

const text: string = readFileSync("a.txt", "utf8");
const bytes = readFileSync("a.txt");
const more = fs.readFileSync("a.txt", { flag: "r" });
console.log(text, bytes.length, more.toString());
// error: fs_buffers_not_yet.pts:6:15 - error PTS1001: reading a file without an encoding (into a Buffer, until typed arrays) is not supported yet
// error: fs_buffers_not_yet.pts:7:14 - error PTS1001: reading a file without an encoding (into a Buffer, until typed arrays) is not supported yet
