// C184 guard (H09b5): polymorphic recursion through a generic function declaration called by name
// is D-049's own case: PTS1001 at the instance limit (64 instances of rec deep, each made by the
// one before; an honest diagnostic), never an internal error.
// error: generic_polymorphic_recursion_direct.pts:10:29 - error PTS1001: polymorphic recursion more than 64 instances deep (`rec`) is not supported yet
class Box<T> {
  constructor(public value: T) {}
}
function rec<T>(x: T, n: number): Box<T> {
  if (n > 0) {
    const inner: Box<T[]> = rec([x], n - 1);
    return new Box(inner.value[0]);
  }
  return new Box(x);
}
try {
  const b: Box<number> = rec(5, 3);
  console.log(b.value + 1);
} catch (error: any) {
  console.log(error.name, error.message);
}
