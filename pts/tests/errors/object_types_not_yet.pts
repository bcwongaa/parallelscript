// Object types and literals that arrive later are reported: values of another object
// type or of a class where an object type is expected (M2.3b), optional properties
// (M3.1), methods, spread, numeric and computed keys.
interface Point {
  x: number;
  y: number;
}
const p3 = { x: 1, y: 2, z: 3 };
const p: Point = p3;
class Vec {
  x = 0;
  y = 0;
}
const v: Point = new Vec();
type Maybe = { value?: number };
const m: Maybe = {};
const withMethod = { run(): number { return 1; } };
const spread = { ...p3 };
const numeric = { 1: "one" };
const key = "k";
const computed = { [key]: 1 };

