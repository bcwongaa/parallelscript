// Object types and literals that arrive later are reported: values whose property types
// differ from an object type's, properties that a getter provides (M2.3b2), optional
// properties (M3.1), methods, spread, numeric and computed keys.
interface Point {
  x: number;
  y: number;
}
const p3 = { x: 1 as int, y: 2 };
const p: Point = p3;
class Vec {
  get x(): number { return 0; }
  y = 0;
}
const v: Point = new Vec();
type Maybe = { value?: number };
const m: Maybe = {};
const withMethod = { run(): number { return 1; } };
const spread = { ...p3 };
const numeric = { 1: "one" };
const key = "k";
const computed = { [key]: 1 };

