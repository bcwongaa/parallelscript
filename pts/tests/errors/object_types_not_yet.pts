// Object types and literals that arrive later are reported: members whose types differ, setter-only,
// overloaded members, optional methods, a method called with another object as `this`,
// methods beside a spread, numeric keys and computed accessor names. (`Generic` is fine since M3.3d2.)
interface Point {
  x: number;
  y: number;
}
const p3 = { x: 1 as int, y: 2 };
const p: Point = p3;
interface Sized {
  size(): number;
}
class Box {
  size(): int {
    return 1;
  }
}
const s: Sized = new Box();
type Maybe = { value?(): number };
const m: Maybe = {};
const withGetter = { get [`run`](): number { return 1; } };
const spread = { ...p3, m() { return 1; } };
const numeric = { 1: "one" };
interface WriteOnly {
  set w(value: number);
}
function write(o: WriteOnly): void {}
interface Overloaded {
  f(x: number): number;
  f(x: string): string;
}
function call(o: Overloaded): void {}
interface Generic {
  id<T>(x: T): T;
}
function identity(o: Generic): void {}
function size(o: Sized): number {
  console.log(o.size.call(new Box()));
  return 0;
}

