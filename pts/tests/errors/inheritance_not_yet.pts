// Inheritance that isn't supported yet is reported: overrides that change the types
// of parameters, using a class where a structurally equal one is expected, super(...)
// inside an expression in a class with fields, and instanceof of a non-class.
class Base {
  n = 1;
  m(x: number): number {
    return x;
  }
}
class Narrower extends Base {
  m(x: int): int {
    return x;
  }
}
class Wider extends Base {
  m(x: number | string): number {
    return 2;
  }
}
class Twin {
  n = 1;
  m(x: number): number {
    return x;
  }
}
const twin: Twin = new Base();
class Fields extends Base {
  f = 2;
  constructor() {
    console.log(super());
  }
}
console.log(new Base() instanceof Map);

