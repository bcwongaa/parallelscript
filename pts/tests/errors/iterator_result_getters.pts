// An object literal with getters or setters can't be an iterator result (D-109's result
// shapes hold done and value in fields, and a getter mustn't run before the iteration
// asks for it, D-146); the diagnostic says so in the program's types and names the
// alternative, a result typed `any` (H03, C03). `run/iterator_result_getters_any.pts`
// is that alternative.
class Completed implements Iterable<number> {
  [Symbol.iterator](): Iterator<number> {
    return {
      next(): IteratorResult<number> {
        return {
          get done(): true {
            return true;
          },
          get value(): number {
            throw new Error("value of a done result was read");
          },
        };
      },
    };
  }
}
function step(): IteratorYieldResult<number> {
  return {
    get done(): false {
      return false;
    },
    value: 1,
  };
}
function last(): IteratorResult<string, string> {
  let seen = "";
  return {
    done: true,
    get value() {
      return seen;
    },
    set value(v: string) {
      seen = v;
    },
  };
}
for (const item of new Completed()) {
  console.log(item, step(), last());
}

// error: iterator_result_getters.pts:10:16 - error PTS1001: an object literal with getters or setters as an iterator result (`IteratorResult<number, any>`) is not supported yet; a `next(): any` can return one
