// What exceptions don't support yet (D-068): destructuring a caught value, and replacing
// Error's stack.
try {
  console.log("b");
} catch ({ message }: any) {
  console.log(message);
}
class Traced extends Error {
  stack = "no trace";
}

// error: exceptions_not_yet.pts:5:10 - error PTS1001: destructuring a caught exception is not supported yet
// error: exceptions_not_yet.pts:9:3 - error PTS1001: overriding `Error.stack` is not supported yet
