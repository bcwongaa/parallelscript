// Not C176, so a narrower fallback (H09b5b) keeps it an error, though the pairing is
// speculative: a dispatched demand (D-101, every fallback level) pairs with every override of
// the method in the receiver's class's subclasses, also Sub's, though this receiver is never a
// Sub; Sub.make's instance for Dog[] makes Weird<Dog[]>, whose animals() doesn't lower (D-094).
// No level compiles the program; the compiler can't tell this pairing from one the call makes.
// error: using a Dog[] as a Animal[] where it may be changed or kept
class Box<T> {
  constructor(public value: T) {}
}
class Animal {
  name = "a";
}
class Dog extends Animal {
  bark = 1;
}
class Weird<T> {
  constructor(public value: T) {}
  animals(): Animal[] {
    const v = this.value;
    if (Array.isArray(v)) {
      return v;
    }
    return [];
  }
}
class Base {
  make<T>(x: T): Box<T> {
    return new Box(x);
  }
}
class Sub extends Base {
  override make<T>(x: T): Box<T> {
    const weird = new Weird(x);
    console.log("weird", weird.animals().length);
    return new Box(x);
  }
}
function pick(n: number): Base {
  return n > 5 ? new Sub() : new Base();
}
const b: Base = pick(1);
const dogs: Box<Dog[]> = b.make([new Dog()]);
console.log("dogs", dogs.value.length, pick(9).make(1).value);
