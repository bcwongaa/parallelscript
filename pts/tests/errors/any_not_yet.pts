// What `any` doesn't do yet (D-070, D-075): `Array.isArray` of a dynamic value (M3.3c3),
// classes as values, and `new` of a dynamic value.
class Point {}
const data: any = [1, 2];
console.log(Array.isArray(data));
const maker: any = Point;
const made = new maker();
console.log(made);

