// What `any` doesn't do yet (D-070, D-071): calls through it, and converting it to
// function types and object types with methods (M3.3c).
interface Greeter {
  greet(): string;
}
const data: any = { name: "x", greet: () => "hi" };
console.log(data.greet());
const greeter: Greeter = data;
const callback: (n: number) => number = data;
console.log(greeter, callback);

// error: any_not_yet.pts:7:13 - error PTS1001: calling a function or method through `any` is not supported yet
// error: any_not_yet.pts:8:26 - error PTS1001: converting any to {greet(): string} (an object type with methods) is not supported yet
// error: any_not_yet.pts:9:41 - error PTS1001: converting any to (number) => number (a function type) is not supported yet
