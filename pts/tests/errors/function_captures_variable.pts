// A function can use module-scope bindings, but not the variables of an enclosing function: closures arrive with M2.5.
function outer(n: number): number {
  const offset = 2;
  function inner(m: number): number {
    return m + offset;
  }
  return inner(n);
}
console.log(outer(1));

// error: function_captures_variable.pts:5:16 - error PTS1001: using `offset` from outside the function is not supported yet
