// Accessor properties that aren't supported yet are reported: a getter and setter of
// different types, reading a property that has only a setter, and an override that
// changes an accessor's type.
class Gauge {
  level: int = 0;
  get value(): int {
    return this.level;
  }
  set value(v: number) {
    this.level = v as int;
  }
  set target(v: number) {
    this.level = v as int;
  }
}
const gauge = new Gauge();
gauge.value = 3;
console.log(gauge.target);

class Meter {
  get reading(): number {
    return 1;
  }
}
class Wider extends Meter {
  get reading(): int {
    return 2;
  }
}

