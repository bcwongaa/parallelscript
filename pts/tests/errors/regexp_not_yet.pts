// What RegExp leaves out (D-133): the deprecated compile, the legacy statics, the d flag's
// indices, and classes extending RegExp.
const pattern = /a(b)/d;
pattern.compile("x");
console.log(RegExp.$1);
const found = pattern.exec("ab");
console.log(found?.indices);
class Strict extends RegExp {}

