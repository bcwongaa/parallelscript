// `parallel e`, `parallel(e)` and `parallel for` parse and type-check (D-120); running
// them waits for the multi-loop runtime (M5.2) and the fork-join pool (M5.5).
function compute(n: number): number {
    return n * 2;
}
async function main(): Promise<void> {
    const task: Promise<number> = parallel compute(21);
    const call = parallel(compute(1));
    const value: number = await parallel compute(2);
    const all: number[] = await Promise.all([1, 2, 3].map((n) => parallel compute(n)));
    console.log(task, call, value, all);
}
main();
parallel for (const x of [1, 2]) {
    console.log(x);
}
