// A class as a value is not supported yet; the message says how to test a value's class
// instead, also for pts:assert's throws (D-171, D-172).
import assert from "pts:assert";

assert.throws(() => {
  throw new TypeError("bad");
}, TypeError);

class ParseError extends Error {}
assert.throws(() => {
  throw new ParseError("bad");
}, ParseError);

