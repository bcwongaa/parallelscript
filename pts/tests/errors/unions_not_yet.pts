// Unions (D-062, D-067): writing a property that a union's members hold as different
// types, methods of a union as values, and unions of several numeric types, which the
// semantic pass can't type.
interface A {
  v: number;
  tag: "a";
}
interface B {
  v: string;
  tag: "b";
}
function set(x: A | B): void {
  x.v = 5;
}
interface C {
  f(n: number): number;
}
interface D {
  f(n: number): number;
}
function method(x: C | D): void {
  const f = x.f;
}
function mixed(x: u8 | i16 | null): void {}

// error: unions_not_yet.pts:13:3 - error PTS1001: writing `v` of a A | B, whose members hold it as different types, is not supported yet
// error: unions_not_yet.pts:22:13 - error PTS1001: using the method `f` of a C | D (a union) as a value is not supported yet
// error: unions_not_yet.pts:24:16 - error PTS1001: unions of several numeric types (u8 | i16 | null) are not supported yet
