// Unions (D-062): what waits for M3.1c (members of unions of objects, `==` beyond null
// and undefined), and unions of several numeric types, which the semantic pass can't type.
interface Circle {
  kind: "circle";
  r: number;
}
interface Square {
  kind: "square";
  side: number;
}
function area(s: Circle | Square): number {
  return s.kind === "circle" ? 1 : 2;
}
function len(either: string | string[]): number {
  return either.length;
}
function eq(loose: string | number): boolean {
  return loose == 1;
}
function mixed(x: u8 | i16 | null): void {}

