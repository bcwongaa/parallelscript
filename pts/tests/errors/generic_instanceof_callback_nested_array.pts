// H10a session 6 (parent probe a8): functions in an array literal given to the narrowed instance's own method, which calls them with the instance's array; PTS1001, not a silent copy.
// error: giving a function whose parameter is a value[] to a method of the object an `instanceof` narrowing holds as a dynamic value
interface Cache<K, V> {
  get(key: K): V | undefined;
}
class MapLRU<K, V> implements Cache<K, V> {
  items: V[] = [];
  constructor(public key: K, public val: V) {
    this.items.push(val);
  }
  get(key: K): V | undefined {
    return key === this.key ? this.val : undefined;
  }
  all(fs: ((items: V[]) => void)[]): void {
    for (const f of fs) f(this.items);
  }
}
function addOne(items: any[]): void {
  items.push(1);
}
function go(c: Cache<string, number>): void {
  if (c instanceof MapLRU) c.all([addOne]);
}
const m = new MapLRU<string, number>("k", 0);
go(m);
console.log(m.items.length);
