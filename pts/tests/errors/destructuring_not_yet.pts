// Destructuring that isn't supported yet (D-054): rest properties holding methods and
// computed property names. (A set's items in an array pattern work since D-110.)
const { a, ...others } = { a: 1, b() { return 2; } };
const key = "a";
const { [key]: value } = { a: 1 };

// error: destructuring_not_yet.pts:3:12 - error PTS1001: rest properties holding the method `b` are not supported yet
