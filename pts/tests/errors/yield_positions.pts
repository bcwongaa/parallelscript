// A yield can only come first in its statement (D-109): as the statement, as the
// initializer of the statement's first variable, as an assignment's right side or as a
// return's value.
function* counter(): Generator<number, void, number> {
  let total = 0;
  total += yield total;
  console.log("got", yield 1);
  const pair = [yield 2, yield 3];
  total = yield total;
}

