// A yield is hoisted out of the expression a statement evaluates once (D-111); one in a
// loop's condition or update, a case label, a later variable of a declaration, a default
// value or an optional chain is not supported.
function* counter(o: { f?: (n: number) => number }): Generator<number, void, number> {
  let total = 0;
  while ((yield total) > 0) total++;
  for (let i = 0; i < 3; i += yield i) total++;
  switch (total) {
    case yield 1:
      break;
  }
  const first = 1, second = yield 2;
  const totals = [total];
  const [third = yield 3] = totals;
  o.f?.(yield 4);
}

