// A class method without a default can't provide an interface method whose parameter
// is optional, and an override must keep the overridden method's defaults.
interface Labelled {
  label(suffix?: string): string;
}
class Plain {
  label(suffix: string): string {
    return suffix;
  }
}
const labelled: Labelled = new Plain();
class Base {
  n(x = 1): number {
    return x;
  }
}
class Derived extends Base {
  n(x: number): number {
    return x;
  }
}

