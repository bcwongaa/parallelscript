// Parameters that may be undefined in the body wait for unions (M3.1): optional ones
// without a default, and defaults of a type that includes undefined. A class method
// without a default can't provide an interface method whose parameter is optional, and
// an override must keep the overridden method's defaults.
function opt(x?: number): number {
  return 1;
}
function both(a: number | undefined = 5): number {
  return 1;
}
interface Labelled {
  label(suffix?: string): string;
}
class Plain {
  label(suffix: string): string {
    return suffix;
  }
}
const labelled: Labelled = new Plain();
class Base {
  n(x = 1): number {
    return x;
  }
}
class Derived extends Base {
  n(x: number): number {
    return x;
  }
}

