// Generic functions arrive in parts (M2.6b1, M2.6b2, D-049): nested ones and generic
// functions as values are reported, as is a function that would need ever more instances.
function outer(): number {
  function inner<T>(x: T): T {
    return x;
  }
  return inner(1);
}
function identity<T>(x: T): T {
  return x;
}
const f = identity;
function grow<T>(x: T, n: number): number {
  return n === 0 ? 0 : grow([x], n - 1);
}
console.log(grow(1, 3));

