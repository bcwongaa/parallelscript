// Generics arrive in parts (M2.6b1-M2.6b3, D-049, D-050): nested generic functions,
// generic functions as values, generic methods and `instanceof` of a generic class are
// reported, as is a function that would need ever more instances.
function outer(): number {
  function inner<T>(x: T): T {
    return x;
  }
  return inner(1);
}
function identity<T>(x: T): T {
  return x;
}
const f = identity;
function grow<T>(x: T, n: number): number {
  return n === 0 ? 0 : grow([x], n - 1);
}
console.log(grow(1, 3));
class Box<T> {
  constructor(public value: T) {}
  map<U>(f: (x: T) => U): U {
    return f(this.value);
  }
}
const box = new Box(1);
console.log(box instanceof Box);

