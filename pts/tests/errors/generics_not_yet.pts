// Generics that aren't supported yet are reported (D-049, D-050, D-051): generic functions
// inside generic code, nested generic functions that use their outer function's variables,
// overriding a method with a generic one or a generic method with a plain one. (`f`,
// `box.map` and `box instanceof Box` work, D-078, D-089; a function needing ever more
// instances calls its erased copy past the limit, D-198.)
function identity<T>(x: T): T {
  return x;
}
const f = identity;
function outer<T>(x: T): T {
  function inner<U>(y: U): U {
    return y;
  }
  return inner(x);
}
console.log(outer(1));
function counter(start: number): number {
  function add<T>(x: T): number {
    return start + 1;
  }
  return add("x");
}
class Box<T> {
  constructor(public value: T) {}
  map<U>(f: (x: T) => U): U {
    return f(this.value);
  }
}
class Shouting {
  say(): string {
    return "hi";
  }
}
class Echo extends Shouting {
  say<T>(): string {
    return "echo";
  }
}
const box = new Box(1);
console.log(box.map);
console.log(box instanceof Box);
class Plain extends Box<number> {
  map(f: (x: number) => any): any {
    return 0;
  }
}

