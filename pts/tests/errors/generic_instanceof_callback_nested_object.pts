// H10a session 6 (parent probe a8): a function in an object literal given to the narrowed instance's own method, which calls it with the instance's array; PTS1001, not a silent copy.
// error: using the object an `instanceof` narrowing holds as a dynamic value as a value[] where it may be changed or kept
interface Cache<K, V> {
  get(key: K): V | undefined;
}
class MapLRU<K, V> implements Cache<K, V> {
  items: V[] = [];
  constructor(public key: K, public val: V) {
    this.items.push(val);
  }
  get(key: K): V | undefined {
    return key === this.key ? this.val : undefined;
  }
  run(o: { cb: (items: V[]) => void }): void {
    o.cb(this.items);
  }
}
function addOne(items: any[]): void {
  items.push(1);
}
function go(c: Cache<string, number>): void {
  if (c instanceof MapLRU) c.run({ cb: addOne });
}
const m = new MapLRU<string, number>("k", 0);
go(m);
console.log(m.items.length);
