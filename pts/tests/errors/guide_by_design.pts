// Features left out by design (docs/SPEC.md §3.10) are PTS1002 errors that say why.
var count = 0;
function sum(): number {
  let total = 0;
  for (const n of arguments) total += n;
  return total;
}
namespace Shapes {
  export const unit = 1;
}
const big = 2n ** 64n;
const id = Symbol("id");
console.log(eval("1 + 1"));

