// Tuple features not supported yet (D-053): an index that isn't a constant, and
// converting a tuple to an array where a copy could be told apart
// from it (D-094).
// (optional and rest elements work since D-100)
const t: [string, number] = ["a", 1];
let i = 1;
console.log(t[i]);
const pair: [string, string] = ["a", "b"];
const strings: string[] = pair;
console.log(pair, strings);

