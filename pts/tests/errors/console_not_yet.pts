// console.dir's options must be an object literal of depth and showHidden properties.
const options = { depth: 1 };
const depth = 3;
console.dir({ a: 1 }, options);
console.dir({ a: 1 }, { ...options });
console.dir({ a: 1 }, { showHidden: true, depth });

