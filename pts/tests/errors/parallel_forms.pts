// The form of `parallel e` that can't mean what it says is an error (D-120): the operator
// where a binding named parallel would be called instead. (A function operand is fine since D-150.)
const run = 1;
function shadow(): void {
    const parallel = (n: number): number => n;
    console.log(parallel 5);
}
console.log(run, shadow);
// error: parallel_forms.pts:6:17 - error PTS1002: `parallel e` here would call the binding named `parallel` in scope; rename the binding to use the operator
