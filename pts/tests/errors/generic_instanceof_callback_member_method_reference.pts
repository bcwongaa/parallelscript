// H10a session 6 (parent probe a2): a function given by reference to a method of a member tsc types Inner<any> of an inferred narrowing, which hands it the member's array; PTS1001, not a silent copy.
// error: using the object an `instanceof` narrowing holds as a dynamic value as a value[] where it may be changed or kept
interface Cache<K, V> {
  get(key: K): V | undefined;
}
class Inner<T> {
  items: T[] = [];
  each(f: (items: T[]) => void): void {
    f(this.items);
  }
}
class MapLRU<K, V> implements Cache<K, V> {
  inner = new Inner<V>();
  constructor(public key: K, public val: V) {}
  get(key: K): V | undefined {
    return key === this.key ? this.val : undefined;
  }
}
function addOne(items: any[]): void {
  items.push(1);
}
function run(c: Cache<string, number>): void {
  if (c instanceof MapLRU) c.inner.each(addOne);
}
const m = new MapLRU<string, number>("k", 0);
run(m);
console.log(m.inner.items.length);
