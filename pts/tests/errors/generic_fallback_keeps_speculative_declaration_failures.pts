// Not C176, so a narrower fallback (H09b5b) keeps it an error, though the pairing is
// speculative: mkWeird escapes through `any`, and useDogs reads its factory from an any[] whose
// origins D-201 leaves unknown. Its Dog[] demand must still pair with mkWeird at every fallback
// level (D-148); that instance makes Weird<Dog[]>, whose animals() doesn't lower (D-094). No
// level compiles the program, rather than dropping a possibly real pairing. The known-source
// control useDogs(make) now compiles; run/generic_value_flow_proven_declaration.pts pins it.
// error: using a Dog[] as a Animal[] where it may be changed or kept
class Box<T> {
  constructor(public value: T) {}
}
class Animal {
  name = "a";
}
class Dog extends Animal {
  bark = 1;
}
class Weird<T> {
  constructor(public value: T) {}
  animals(): Animal[] {
    const v = this.value;
    if (Array.isArray(v)) {
      return v;
    }
    return [];
  }
}
function mkWeird<T>(x: T): Box<T> {
  const weird = new Weird(x);
  console.log("weird", weird.animals().length);
  return new Box(x);
}
function useDogs(f: <T>(x: T) => Box<T>): number {
  const b: Box<Dog[]> = f([new Dog()]);
  return b.value.length;
}
function make<T>(x: T): Box<T> {
  return new Box(x);
}
const d: any = mkWeird;
console.log("through any", d(1).value);
const actual: any[] = [make];
console.log("dogs", useDogs(actual[0]));
