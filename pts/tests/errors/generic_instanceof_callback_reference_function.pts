// H10a review round 5 (R5-F2's rest, the reviewer's probe t04_callback_references.pts): a function declaration given by reference to an array method of a member tsc types any[] gets the instance's array as a copy, so its write would be lost; PTS1001, not a silent copy.
// error: giving a function whose parameter is a value[] to a method of the object an `instanceof` narrowing holds as a dynamic value
interface Cache<K, V> {
  get(key: K): V | undefined;
}
class MapLRU<K, V> implements Cache<K, V> {
  items: V[] = [];
  constructor(public key: K, public val: V) {
    this.items.push(val);
  }
  get(key: K): V | undefined {
    return key === this.key ? this.val : undefined;
  }
}
function pushOne(_x: any, _i: number, arr: any[]): void {
  arr.push(1);
}
function run(c: Cache<string, number>): void {
  if (c instanceof MapLRU) c.items.forEach(pushOne);
}
const m = new MapLRU<string, number>("k", 0);
run(m);
console.log(m.items.length === 2);
