// Elements, keys, values and function types of the integer types and f32 follow the
// numeric rules (D-048): literals must fit, and conversions must not lose anything.
const bytes: u8[] = [1, 256];
bytes.push(1.5);
const n: number = 3;
bytes.push(n);
const wide: i32 = 5;
bytes[0] = wide;
const sizes = new Map<string, u16>();
sizes.set("a", -1);
const half: (n: number) => u8 = n => n / 2;
const takesByte: (n: number) => void = (b: u8) => {};
const amounts: u32[] = [];
[1, 2].forEach((x: u32) => amounts.push(x));

