// Function values that arrive later are reported: generic, async and generator functions
// (M2.6, M4), `this` parameters, overloaded and recursive function types, and functions
// as strings.
const identity = <T>(x: T): T => x;
const later = async () => 1;
const numbers = function* () {
  yield 1;
};
const withThis = function (this: { x: number }): number {
  return this.x;
};
type Overloaded = { (x: number): number; (x: string): string };
function useOverloaded(o: Overloaded): void {}
type Recursive = (f: Recursive) => number;
function useRecursive(r: Recursive): void {}
const text = "" + (() => 1);

