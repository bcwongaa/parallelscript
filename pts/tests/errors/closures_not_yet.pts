// Function values that arrive later are reported: integer types in their signatures
// (M2.6), generic, async and generator functions (M2.6, M4), `this` parameters,
// overloaded, recursive and optional-parameter function types, and functions as strings.
const half = (n: int): int => n / 2;
function square(x: int): int {
  return x * x;
}
const squarer = square;
const identity = <T>(x: T): T => x;
const later = async () => 1;
const numbers = function* () {
  yield 1;
};
const withThis = function (this: { x: number }): number {
  return this.x;
};
type Overloaded = { (x: number): number; (x: string): string };
function useOverloaded(o: Overloaded): void {}
type Recursive = (f: Recursive) => number;
function useRecursive(r: Recursive): void {}
function useOptional(f: (x?: number) => void): void {}
const text = "" + (() => 1);

