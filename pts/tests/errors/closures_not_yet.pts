// Function values that arrive later are reported: `this` parameters, overloaded and
// recursive function types, and functions as strings. (Generic function values work since
// M3.3d1, D-078; generator functions since M4.1a, D-109; async functions since M4.2a, D-112.)
const identity = <T>(x: T): T => x;
const withThis = function (this: { x: number }): number {
  return this.x;
};
type Overloaded = { (x: number): number; (x: string): string };
function useOverloaded(o: Overloaded): void {}
type Recursive = (f: Recursive) => number;
function useRecursive(r: Recursive): void {}
const text = "" + (() => 1);

