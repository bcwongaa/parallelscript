// The single guardrail (D-L17, D-127): a parallel body (a function passed to a `.par`
// method or join, by itself or by name, the operand of `parallel`, a `parallel for` body)
// can't assign a variable declared outside it, even in a function it makes; its own
// locals, and fields, may change. And what can't leave a `parallel for` body.
import { join, range } from "pts:parallel";
let count = 0;
let total = 0;
const xs = [1, 2, 3];
xs.par.forEach(() => {
  count++;
});
const sums = xs.par.map((x) => {
  let local = 0;
  local += x;
  return local;
});
function addTo(n: number): void {
  join(() => { n = 1; }, () => 2);
}
function bump(): void { total += 1; }
xs.par.forEach(bump);
parallel for (const x of xs) {
  total += x;
  [count, total] = [1, 2];
  ({ count } = { count: 3 });
  let mine = x;
  mine++;
}
const p = parallel (count = 5);
function g(): void {
outer: for (const y of xs) {
  parallel for (const x of xs) {
    if (x > 1) break;
    if (x > 2) continue outer;
    if (x > 3) return;
    for (const z of xs) { if (z) break; }
    inner: { break inner; }
  }
}
}
parallel for (let i = 0; i < 3; i++) {}
async function f() {
  parallel for (const x of xs) { await Promise.resolve(x); }
}

