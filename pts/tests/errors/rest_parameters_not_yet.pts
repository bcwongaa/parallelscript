// Rest and spread forms not supported yet (D-057): rest parameters of tuple types,
// spreading a tuple that isn't in a variable or a set, spreads in apply and bind, binding
// rest arguments, and adapting a rest parameter list to optional parameters.
function pairUp(...args: [number, string]): string {
  return "";
}
function add(a: number, b: number): number {
  return a + b;
}
function makePair(): [number, number] {
  return [1, 2];
}
function sum(...xs: number[]): number {
  return xs.length;
}
const letters = new Set([1]);
const nums = [1, 2];
add(...makePair());
sum(...letters);
sum.apply(null, ...[nums]);
sum.bind(null, 1);
const loose: (...xs: number[]) => number = (a: number, b = 2) => a + b;

