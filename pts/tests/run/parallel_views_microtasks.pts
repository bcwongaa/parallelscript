// A program with no event loop whose `.par` callbacks queue microtasks: the operation
// queues them on the main loop before it returns, wherever they ran (D-123).
// threads: 1 4
const order: number[] = [];
[1, 2, 3, 4, 5, 6].par.forEach((n) => {
    queueMicrotask(() => {
        order.push(n);
    });
});
console.log("queued", order.length);
queueMicrotask(() => {
    console.log("ran", order.length, [...order].sort((a, b) => a - b));
});
// expect:
// queued 0
// ran 6 [ 1, 2, 3, 4, 5, 6 ]
