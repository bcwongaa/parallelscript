// The String methods on ASCII text, with their optional arguments left out and given.
const s = "Hello, World";
console.log(s.charCodeAt(0), s.charCodeAt(99), s.charCodeAt(1.9));
console.log(s.slice(7), s.slice(-5, -1), s.slice(), s.slice(5, 2) === "", s.slice(undefined, 5));
console.log(s.substring(7), s.substring(5, 0), s.substring(-3, 2));
console.log(s.indexOf("o"), s.indexOf("o", 5), s.indexOf("xyz"), s.indexOf("", 99));
console.log(s.includes("World"), s.includes("Hello", 1), s.startsWith("Hell"), s.startsWith("World", 7));
console.log(s.endsWith("World"), s.endsWith("Hello", 5), s.endsWith("o", undefined));
console.log(s.toUpperCase(), s.toLowerCase(), "123".toUpperCase());
console.log(`[${"  \t padded \n ".trim()}]`, `[${"  x  ".trimStart()}]`, `[${"  x  ".trimEnd()}]`);
console.log("7".padStart(3, "0"), "abc".padStart(8, "12"), "abc".padEnd(6) + "|", "abc".padEnd(2, "x"), "abc".padStart(5, ""));
console.log("ab".repeat(3), "x".repeat(0) === "", "-".repeat(2.7));

// expect:
// 72 NaN 101
// World Worl Hello, World true Hello
// World Hello He
// 4 8 -1 12
// true false true true
// true true false
// HELLO, WORLD hello, world 123
// [padded] [x  ] [  x]
// 007 12121abc abc   | abc abc
// ababab true --
