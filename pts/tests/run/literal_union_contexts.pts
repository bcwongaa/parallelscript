// Object literals in union contexts (D-136): a literal for a union with one hash-map object
// member it fits (and a class it can't be) is that hash-map object, and a literal's method
// can fill an optional function-typed property.
class Bag {
  constructor(readonly items: string[]) {}
}
type BagInit = Bag | Record<string, string> | [string, string][];

function size(init: BagInit): number {
  if (init instanceof Bag) {
    return init.items.length;
  }
  if (Array.isArray(init)) {
    return init.length;
  }
  return Object.keys(init).length;
}
console.log(size({ a: "1", b: "2" }), size([["x", "y"]]), size(new Bag(["q", "r", "s"])), size({}));

interface Options {
  name: string;
  onError?: (error: unknown) => string;
  render?: (value: number) => string;
}
const handled: Options = {
  name: "handled",
  onError(error) {
    return `handled ${String(error)}`;
  },
};
const plain: Options = { name: "plain", render: (value) => `<${value}>` };
for (const options of [handled, plain]) {
  console.log(options.name, options.onError?.("boom") ?? "unhandled", options.render?.(5) ?? "-");
}
// expect:
// 2 1 3 0
// handled handled boom -
// plain unhandled <5>
