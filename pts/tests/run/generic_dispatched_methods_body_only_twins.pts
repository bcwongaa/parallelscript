// H09b5d RED (C177, body only, a dispatched generic method): the method table's entry is found by
// the IR signature, the same for both twins: the second call ran the first's instance and threw
// `Expected number, got string`.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
class Out<T> {
  constructor(public x: T, public note: string) {}
}
type K<T> = T extends { kind: "a" } ? number : string;
abstract class Base {
  abstract pick<T>(x: T, text: string): Out<T>;
}
class Picker extends Base {
  pick<T>(x: T, text: string): Out<T> {
    const k = JSON.parse(text) as K<T>;
    return new Out(x, typeof k + " " + String(k));
  }
}
const picker: Base = new Picker();
attempt("{ kind: 'a' }:", () => {
  const r = picker.pick<{ kind: "a" }>({ kind: "a" as const }, JSON.stringify(3));
  return String(r.note);
});
attempt("{ kind: 'b' }:", () => {
  const r = picker.pick<{ kind: "b" }>({ kind: "b" as const }, JSON.stringify("s"));
  return String(r.note);
});
// expect:
// { kind: 'a' }: number 3
// { kind: 'b' }: string s
