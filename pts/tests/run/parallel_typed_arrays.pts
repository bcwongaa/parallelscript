// `.par` on typed arrays (D-126): ParallelArray's methods over the elements as numbers;
// map and filter make typed arrays of the view's kind; sort is numeric and in place, a
// parallel merge sort of pieces the typed array's own sort sorts.
// threads: 1 2 4
const xs = new Float64Array(10).map((_, i) => i - 4.5);
console.log(xs.par.map((x) => x * 2), xs.par.filter((x) => x > 0));
console.log(xs.par.sum(), xs.par.min(), xs.par.max(), xs.par.reduce((a, b) => a + b, 0), xs.par.count((x) => x < 0));
console.log(xs.par.some((x) => x === 0.5), xs.par.every((x) => x > -5), xs.par.find((x) => x > 4), xs.par.find((x) => x > 5));
console.log(xs.par.toArray().length, xs.par.flatMap((x, i) => (i < 2 ? [x, -x] : [])));

// map converts as the kind does; the callback gets the index and the typed array.
const bytes = new Uint8Array([10, 20, 250]);
console.log(bytes.par.map((b, i, all) => b + i + all.length), new Uint8ClampedArray([100, 200]).par.map((b) => b * 2));
const empty = new Int16Array(0);
console.log(empty.par.map((x) => x), empty.par.filter(() => true), empty.par.sum(), empty.par.min(), empty.par.max());

// forEach writes through the view's array.
const squares = new Int32Array(50_000);
squares.par.forEach((_, i, all) => {
  all[i] = i * i;
});
console.log(squares.subarray(0, 5), squares[49_999], squares.par.count((v) => v % 2 === 1));

// sort: numeric, -0 before 0, NaN last; long enough for the merges to run.
const n = 20_000;
const values = new Float64Array(n).map((_, i) => ((i * 7919) % 10007) - 5000);
values[3] = NaN;
values[4] = -0;
values[5] = 0;
const expected = values.slice().sort();
const sorted = values.par.sort();
console.log(sorted === values, sorted.every((v, i) => Object.is(v, expected[i])), sorted.subarray(0, 3), sorted.subarray(n - 2));
const ints = new Int32Array(n).map((_, i) => (i * 104729) % 65536);
console.log(ints.par.sort((a, b) => b - a).subarray(0, 3), ints.par.sortBy((v) => v % 10).subarray(0, 3));

// expect:
// Float64Array(10) [
//   -9, -7, -5, -3, -1,
//    1,  3,  5,  7,  9
// ] Float64Array(5) [ 0.5, 1.5, 2.5, 3.5, 4.5 ]
// 0 -4.5 4.5 0 5
// true true 4.5 undefined
// 10 [ -4.5, 4.5, -3.5, 3.5 ]
// Uint8Array(3) [ 13, 24, 255 ] Uint8ClampedArray(2) [ 200, 255 ]
// Int16Array(0) [] Int16Array(0) [] 0 Infinity -Infinity
// Int32Array(5) [ 0, 1, 4, 9, 16 ] -1795067295 23170
// true true Float64Array(3) [ -5000, -5000, -4999 ] Float64Array(2) [ 5006, NaN ]
// Int32Array(3) [ 64250, 64240, 64230 ] Int32Array(3) [ 64250, 64240, 64230 ]
