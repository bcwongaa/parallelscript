// The functions and constants of Math pulled forward for the benchmarks (M2.7): JS's
// rounding, -0 and NaN rules, and max/min of any number of arguments.
const xs = [0, -0, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 0.49999999999999994, -0.49999999999999994, 4503599627370495.5, 1e300, -7.9, NaN, Infinity, -Infinity];
for (const x of xs) {
  console.log(x, Math.sqrt(x), Math.abs(x), Math.floor(x), Math.ceil(x), Math.round(x), Math.trunc(x), Math.sign(x));
}
console.log(Math.max(), Math.min(), Math.max(3), Math.max(-0), Math.max(1, 5, 3), Math.min(1, -5, 3));
console.log(Math.max(0, -0), Math.min(0, -0), Math.max(-0, 0), Math.min(-0, 0), Math.max(1, NaN, 3), Math.min(NaN));
console.log(Math.PI, Math.E, Math.LN10, Math.LN2, Math.LOG10E, Math.LOG2E, Math.SQRT1_2, Math.SQRT2);
let calls = 0;
function next(): number {
  calls++;
  return calls;
}
console.log(Math.max(next(), next(), next()), Math.min(next()), calls, Math.sqrt(2) * Math.sqrt(2));
