// The classic ordering puzzle: an async function's body runs until its first await, and
// the rest of it runs from a microtask, after the synchronous code (D-112).
console.log("script start");
async function async1(): Promise<void> {
  console.log("async1 start");
  await async2();
  console.log("async1 end");
}
async function async2(): Promise<void> {
  console.log("async2");
}
async1();
new Promise<void>((resolve) => {
  console.log("promise1");
  resolve();
}).then(() => {
  console.log("promise2");
});
console.log("script end");

// expect:
// script start
// async1 start
// async2
// promise1
// script end
// async1 end
// promise2
