// Promises over timers (D-114): sleep, awaiting in loops, top-level awaits on timers,
// unref'd timers that don't keep the program alive, performance.now().
const sleep = (ms: number): Promise<void> => new Promise<void>((resolve) => setTimeout(resolve, ms));
const start = performance.now();
async function worker(name: string, delays: number[]): Promise<string> {
  for (const d of delays) {
    await sleep(d);
    console.log(name, d);
  }
  return name;
}
const done = await Promise.all([worker("a", [10, 80]), worker("b", [20, 5])]);
console.log("done", done);
const raced = await Promise.race([sleep(50).then(() => "slow"), sleep(5).then(() => "fast")]);
console.log("raced", raced);
const timer = setTimeout(() => console.log("unref'd: never printed"), 1000);
console.log(timer.hasRef(), timer.unref() === timer, timer.hasRef());
const elapsed = performance.now() - start;
console.log("elapsed is positive", elapsed > 0, typeof performance.now());

// expect:
// a 10
// b 20
// b 5
// a 80
// done [ 'a', 'b' ]
// raced fast
// true true false
// elapsed is positive true number
