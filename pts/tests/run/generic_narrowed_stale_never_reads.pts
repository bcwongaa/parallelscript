// An instance's stale narrowing (H09b4b, C220; H09b4a review round 1's s02): tsc keeps
// `o.v` narrowed across a call that changed it, so for T = string the second test types it
// `T & number`, never for the instance, while it holds 5, which its declared type `T |
// number` has. D-195 makes it no trap (the tests' type is number); its typed uses must read
// the value it holds, converted with a check. The base and H09b4a made the read the declared
// union unconverted: PTS1001 (`converting number | string to number`). Also through a
// closure's `let`, a closure's parameter, an await, a getter, `this.v` and a generator.
type V = string | number;
function num(n: number): string {
  return "num " + (n + 1);
}
function property<T>(o: { v: T | number }, change: () => void): string {
  if (typeof o.v !== "number") {
    change();
    if (typeof o.v === "number") {
      const n: number = o.v;
      return "number now " + (n + 1);
    }
  }
  return "kept";
}
function letOfClosure<T>(init: T | number): string {
  let v: T | number = init;
  const set = () => {
    v = 5;
  };
  if (typeof v !== "number") {
    set();
    if (typeof v === "number") {
      return "let " + num(v);
    }
  }
  return "kept";
}
function parameterOfClosure<T>(p: T | number): number {
  const set = () => {
    p = 5;
  };
  if (typeof p !== "number") {
    set();
    if (typeof p === "number") {
      return p;
    }
  }
  return -1;
}
async function propertyAfterAwait<T>(o: { v: T | number }): Promise<string> {
  if (typeof o.v !== "number") {
    await Promise.resolve();
    if (typeof o.v === "number") {
      const n: number = o.v;
      return "await " + (n + 1);
    }
  }
  return "kept";
}
class Flips<T> {
  reads = 0;
  constructor(private first: T) {}
  get v(): T | number {
    return this.reads++ >= 1 ? 5 : this.first;
  }
}
function getter<T>(g: Flips<T>): string {
  if (typeof g.v !== "number") {
    if (typeof g.v === "number") {
      return "getter " + num(g.v);
    }
  }
  return "kept";
}
class Holder<T> {
  constructor(public v: T | number) {}
  run(change: () => void): string {
    if (typeof this.v !== "number") {
      change();
      if (typeof this.v === "number") {
        const n: number = this.v;
        return "this " + (n + 1);
      }
    }
    return "kept";
  }
}
function* generator<T>(o: { v: T | number }): Generator<string> {
  if (typeof o.v !== "number") {
    yield "first";
    if (typeof o.v === "number") {
      yield "generator " + num(o.v);
    }
  }
}

const o1: { v: V } = { v: "s" };
console.log(property<string>(o1, () => {
  o1.v = 5;
}));
console.log(letOfClosure<string>("s"));
console.log("parameter", parameterOfClosure<string>("s"));
const o2: { v: V } = { v: "s" };
propertyAfterAwait<string>(o2).then((r) => console.log(r));
o2.v = 5;
console.log(getter(new Flips<string>("s")));
const holder = new Holder<string>("s");
console.log(holder.run(() => {
  holder.v = 5;
}));
const o3: { v: V } = { v: "s" };
const it = generator<string>(o3);
console.log(it.next().value);
o3.v = 5;
console.log(it.next().value);
console.log(property<string>({ v: "t" }, () => {}));

// expect:
// number now 6
// let num 6
// parameter 5
// getter num 6
// this 6
// first
// generator num 6
// kept
// await 6
