// Hash-map objects (D-059) with values of the integer types, and number keys of them.
const bytes: Record<string, u8> = { a: 250 };
bytes.a += 10;
bytes.b = 7;
const sum: int = bytes.a + bytes["b"];
console.log(bytes, sum);
const byInt: Record<int, i64> = {};
for (let i: int = 0; i < 3; i++) {
  byInt[i] = i * 1000000000000 as i64;
}
console.log(byInt, Object.values(byInt), byInt[2] + 1);
const total = Object.values(bytes).reduce((a, b) => a + b, 0);
console.log(total);
const big: { [k: string]: u64 } = { max: 18446744073709551615 };
big.max++;
console.log(big);
const counts: Record<string, int> = {};
for (const c of "hello".split("")) counts[c] = (counts[c] ?? 0) + 1;
for (const c of "world".split("")) counts[c] = (counts[c] || 10) * 2;
console.log(counts);
const scaled: Record<string, f32> = { third: 1 / 3 as f32 };
console.log(scaled);

// expect:
// { a: 4, b: 7 } 11
// { '0': 0, '1': 1000000000000, '2': 2000000000000 } [ 0, 1000000000000, 2000000000000 ] 2000000000001
// 11
// { max: 0 }
// { h: 1, e: 1, l: 4, o: 2, w: 20, r: 20, d: 20 }
// { third: 0.3333333432674408 }
