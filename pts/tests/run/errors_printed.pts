// console.log of an error prints its stack as Node does (D-068): an error whose stack has
// no frames in brackets, with the class's name where it differs from the error's, then
// the properties of derived classes, its name if the stack doesn't show it, and [cause].
class HttpError extends Error {
  status = 500;
}
class Plain extends Error {}
function frameless<T extends Error>(error: T): T {
  error.stack = error.name + ": " + error.message;
  return error;
}
console.log(frameless(new Error("boom")));
console.log([frameless(new RangeError("in an array"))], { nested: frameless(new TypeError("in an object")) });
console.log(frameless(new Error("outer", { cause: frameless(new Error("inner")) })));
console.log(frameless(new HttpError("server")));
console.log(frameless(new Plain("plain")));
const renamed = new Error("x");
renamed.stack = "Error: x";
renamed.name = "Renamed";
console.log(renamed);
const deep = { a: { b: { c: frameless(new HttpError("deep")) } } };
console.log(deep);
