// Map and Set: SameValueZero keys, insertion order, live iteration, and Node's printing.
const ages = new Map<string, number>();
ages.set("ada", 36).set("alan", 41);
ages.set("grace", 85);
console.log(ages.size, ages.get("ada"), ages.get("nobody"), ages.has("alan"), ages.has("x"));
console.log(ages);
ages.set("ada", 37);
console.log(ages.delete("alan"), ages.delete("alan"), ages.get("ada")! + 1, ages);
for (const name of ages.keys()) {
  console.log("name", name, ages.get(name)!);
}
for (const age of ages.values()) {
  console.log("age", age);
}
ages.forEach((age, name) => console.log(name + "=" + age));
const words = "the cat and the hat and the bat".split(" ");
const counts = new Map<string, number>();
for (const word of words) {
  counts.set(word, (counts.has(word) ? counts.get(word)! : 0) + 1);
}
console.log(counts, Array.from(counts.keys()), Array.from(counts.values(), (n, i) => n * 10 + i));
const unique = new Set(words);
console.log(unique, unique.size, unique.has("cat"), Array.from(unique));
const s = new Set<number>();
s.add(NaN).add(0).add(-0).add(NaN).add(1);
console.log(s, s.has(-0), s.has(NaN));
for (const x of s) {
  console.log("x", x);
}
s.forEach((v, k, set) => console.log(v, k, set.size));
const copy = new Set(s);
copy.clear();
console.log(copy, s.size, new Map<string, number>(), new Map(counts).size);
const nested = new Map<string, Set<number>>();
nested.set("a", new Set([1, 2]));
console.log(nested, { m: new Map<string, number>([]) });
const big = new Set<number>();
for (let i = 0; i < 120; i++) big.add(i);
console.log(big);

// Objects are keys by identity; maps hold any value.
class Point {
  constructor(
    public x: number,
    public y: number,
  ) {}
}
const p1 = new Point(1, 2);
const labels = new Map<Point, string>();
labels.set(p1, "first").set(new Point(1, 2), "second");
console.log(labels.size, labels.get(p1), labels.has(new Point(1, 2)), labels);
const handlers = new Map<string, (n: number) => number>();
handlers.set("double", (n) => n * 2).set("square", (n) => n * n);
console.log(handlers.get("square")!(7), handlers);
const groups = new Map<string, string[]>();
for (const word of ["apple", "avocado", "banana", "blueberry", "cherry"]) {
  const letter = word[0];
  if (!groups.has(letter)) {
    groups.set(letter, []);
  }
  groups.get(letter)!.push(word);
}
console.log(groups);

// Iteration sees entries added during it, skips those deleted before they're reached,
// and continues after the map grows or is cleared.
const live = new Map<number, string>();
live.set(1, "a").set(2, "b").set(3, "c");
live.forEach((value, key) => {
  if (key === 1) {
    live.delete(2);
    live.set(4, "d");
  }
  if (key < 10) {
    live.set(key + 100, "added");
  }
  console.log("visit", key, value);
});
console.log(live.size);
const growing = new Set<number>([0]);
for (const n of growing) {
  if (n < 50) {
    growing.add(n + 1);
  }
}
console.log(growing.size);

// Nested maps and sets print nested, as `[Map]` beyond depth 2.
const self = new Map<string, Map<string, number>>();
const inner = new Map<string, number>();
inner.set("x", 1);
self.set("inner", inner);
console.log(self, [new Set([1])], [new Map<string, number>()]);
const deep = { a: { b: { c: new Map<string, number>(), d: inner } } };
console.log(deep);

