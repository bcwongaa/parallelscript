// A generic arrow function's, a declaration's and a dispatched or interface method's
// instance whose code narrows its value to a type no value of its type arguments has
// (`T & any[]` for a number or a string, `T & number` for a string), directly or in a
// generic function it calls, lowers that code as unreachable (D-195), so its typed calls
// find it and run as Node does. Before, such an instance didn't lower: the trials dropped
// it and the call kept the erased copy, whose `Box<any>` threw TypeError (C171).
class Box<T> {
  constructor(public value: T) {}
}
function inspect<T>(x: T): void {
  if (Array.isArray(x)) {
    console.log("an array of", x.length);
  }
}
function use(label: string, f: <T>(x: T) => Box<T>): void {
  try {
    const n: Box<number> = f(2);
    console.log(label, "number", n.value);
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
  try {
    const s: Box<string> = f("s");
    console.log(label, "string", s.value);
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
function main(): void {
  use("isArray", <T>(x: T) => {
    if (Array.isArray(x)) {
      console.log(x.length);
    }
    return new Box(x);
  });
  use("calls inspect", <T>(x: T) => {
    inspect(x);
    return new Box(x);
  });
  use("cond", <T>(x: T) => (typeof x === "number" ? new Box(x) : new Box(x)));
  use("cases", <T>(x: T) => {
    switch (typeof x) {
      case "string":
        console.log("a string of", x.length);
    }
    return new Box(x);
  });
  use("plain", <T>(x: T) => new Box(x));
}
main();

// A declaration through a value and a dispatched generic method (H09 review rounds 1 and
// 2, `f04` and `t01`).
function arrays<T>(x: T): Box<T> {
  if (Array.isArray(x)) {
    console.log("an array of", x.length);
  }
  return new Box(x);
}
use("declaration", arrays);
abstract class Maker {
  abstract make<T>(x: T): Box<T>;
}
class ArrayAware extends Maker {
  make<T>(x: T): Box<T> {
    if (Array.isArray(x)) {
      console.log("an array of", x.length);
    }
    return new Box(x);
  }
}
class Plain extends Maker {
  make<T>(x: T): Box<T> {
    return new Box(x);
  }
}
function dispatch(label: string, m: Maker): void {
  try {
    const b: Box<number> = m.make(2);
    console.log(label, b.value + 1);
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
dispatch("plain method", new Plain());
dispatch("method", new ArrayAware());

// Through an interface (D-191): each class's entry has its own instance, the override's
// with its dead branch, never its base class's.
interface Making {
  make<T>(x: T): Box<T>;
}
class Base implements Making {
  make<T>(x: T): Box<T> {
    console.log("base's make");
    return new Box(x);
  }
}
class Sub extends Base {
  make<T>(x: T): Box<T> {
    console.log("sub's make");
    if (Array.isArray(x)) {
      console.log("an array of", x.length);
    }
    return new Box(x);
  }
}
function viaInterface(label: string, m: Making): void {
  try {
    const b: Box<number> = m.make(2);
    console.log(label, b.value + 1);
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
viaInterface("base through an interface", new Base());
viaInterface("override through an interface", new Sub());

// expect:
// isArray number 2
// isArray string s
// calls inspect number 2
// calls inspect string s
// cond number 2
// cond string s
// cases number 2
// a string of 1
// cases string s
// plain number 2
// plain string s
// declaration number 2
// declaration string s
// plain method 3
// method 3
// base's make
// base through an interface 3
// sub's make
// override through an interface 3
