// An object literal's accessors named `[Symbol.iterator]` and `[Symbol.asyncIterator]`
// (D-045, D-111, D-115) work as JS's do: iteration reads the getter each time it opens
// the object, whether the object is held as `any`, as its own type or as an Iterable,
// and a getter can have a setter (C34). Writing `o[Symbol.iterator]` is a compile error
// (errors/symbol_iterator_element_writes.pts).
const logged: any = {
  get [Symbol.iterator]() {
    console.log("get @@iterator");
    return function* () { yield 1; yield 2; };
  },
};
for (const x of logged) console.log("item", x);
const [first] = logged;
console.log(first, [...logged]);

const untyped = { get [Symbol.iterator]() { return function* () { yield 3; yield 4; }; } };
for (const x of untyped) console.log("untyped", x);

const iterable: Iterable<number> = { get [Symbol.iterator]() { return function* () { yield 5; }; } };
console.log([...iterable], Array.from(iterable));

let steps = function* (): Generator<number> { yield 6; };
const settable = {
  get [Symbol.iterator]() { return steps; },
  set [Symbol.iterator](next: () => Generator<number>) { console.log("set @@iterator"); steps = next; },
};
console.log([...settable]);

const later = { get [Symbol.asyncIterator]() { return async function* () { yield "a"; yield "b"; }; } };
(async () => {
  for await (const x of later) console.log("async", x);
})();

// expect:
// get @@iterator
// item 1
// item 2
// get @@iterator
// get @@iterator
// 1 [ 1, 2 ]
// untyped 3
// untyped 4
// [ 5 ] [ 5 ]
// [ 6 ]
// async a
// async b
