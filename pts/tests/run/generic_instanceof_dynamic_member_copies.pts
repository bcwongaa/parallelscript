// no-diff: D-179 copies a dynamic value's typed array into an any[] local, where Node's local is the array itself
// H10: an `x: unknown` narrowed by `instanceof` to Box<any> stays a dynamic value. Its typed
// array field, called on through the narrowing (`x.items.push`), is the object's own array
// (generic_instanceof_dynamic_member_writes.pts), but bound to a local, which tsc types
// any[], it converts as D-179 and SPEC §3.5 say a dynamic value bound to a typed local does:
// by a copy, so a push through the local doesn't reach the object, as it does in Node.
class Box<T> {
  items: T[] = [];
  constructor(v: T) {
    this.items.push(v);
  }
}
function f(x: unknown): void {
  if (x instanceof Box) {
    const it = x.items;
    it.push(9);
    console.log("it", it.length, x.items.length, it === x.items);
  }
}
const b = new Box<number>(7);
f(b);
console.log("after", b.items);
// expect:
// it 2 1 false
// after [ 7 ]
