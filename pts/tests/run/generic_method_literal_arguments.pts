// An object literal's generic method whose parameter is a union of object types typed with
// its type parameters (`o: Opt<T>`), given an object literal: the argument was lowered once,
// for the erased copy's `Opt<any>` (D-191), and an object of a member of the instance's
// `Opt<number>` as it is wasn't taken as one of the union, so the call kept the erased copy,
// whose `Box<any>` a typed place rejects (C188). It finds its instance, as the same call given
// a variable of `Opt<number>` does (`generic_method_object_arguments.pts`; H09b3a, D-193).
class Box<T> {
  constructor(public value: T) {}
}
type Opt<T> = { tag: "some"; value: T } | { tag: "none" };
const Ops = {
  orElse<T>(o: Opt<T>, d: T): Box<T> {
    return new Box(o.tag === "some" ? o.value : d);
  },
};
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
attempt("an object literal argument", () => String(Ops.orElse<number>({ tag: "some", value: 3 }, 0).value + 1));
attempt("an object literal of the other member", () => String(Ops.orElse<number>({ tag: "none" }, 5).value + 1));

// expect:
// an object literal argument 4
// an object literal of the other member 6
