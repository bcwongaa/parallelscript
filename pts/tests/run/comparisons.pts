// Comparisons yield booleans; == and != on numbers mean === and !==.
let one = 1;
let two = 2;
console.log(one < two, one <= two, one > two, one >= two, one === two, one !== two);
console.log(one < 1, one <= 1, one > 1, one >= 1, one === 1, one !== 1, one == 1, one != 1);
console.log(0.1 + 0.2 === 0.3, 0.1 + 0.2 > 0.3, 0.5 + 0.25 === 0.75);
const yes = one < two;
const no = one > two;
console.log(yes === no, yes !== no, yes === true, no == false, yes != true);

// expect:
// true true false false false true
// false true false true true false true false
// false true true
// false true true true false
