// C176 (H09b5b review round 2, R2-3): Holder<Dog[]>, which only use's speculative pairing with the
// escaping arrow w makes, has a method calling f0<T>; ten generic declarations all call each other
// (instances lowered outside any trial that use each other) and each makes Weird<T>, whose method
// fails for Dog[] (D-094). Finding the blame through that graph was exponential and gave up as
// the program's own past a step budget, so the whole build fell back; it is linear per report.
class Box<T> {
  constructor(public value: T) {}
}
class Animal {
  name = "a";
}
class Dog extends Animal {
  bark = 1;
}
class Weird<T> {
  constructor(public value: T) {}
  animals(): Animal[] {
    const v = this.value;
    if (Array.isArray(v)) {
      return v;
    }
    return [];
  }
}
class Holder<T> {
  constructor(public value: T) {}
  run(): number {
    return f0(this.value, 0).value === undefined ? 0 : 1;
  }
}
interface Maker {
  make<T>(x: T): Box<T>;
}
class ClassMaker implements Maker {
  make<T>(x: T): Box<T> {
    return new Box(x);
  }
}
function f0<T>(x: T, k: number): Box<T> {
  if (k > 0) {
    f1(x, k - 1);
    f2(x, k - 1);
    f3(x, k - 1);
    f4(x, k - 1);
    f5(x, k - 1);
    f6(x, k - 1);
    f7(x, k - 1);
    f8(x, k - 1);
    f9(x, k - 1);
  }
  const w = new Weird<T>(x);
  if (k < -100) console.log(w.animals().length);
  return new Box(x);
}
