function use(f: <T>(x: T) => Box<T>): void {
  const b: Box<Dog[]> = f([new Dog()]);
  console.log("dogs", b.value.length);
}
function main(): void {
  const maker: Maker = new ClassMaker();
  console.log("interface victim", maker.make(4).value + 1);
  const named = <T,>(x: T): Box<T> => new Box(x);
  console.log("value victim", named(5).value + 1);
  const w = <T,>(x: T): Holder<T> => new Holder(x);
  const d: any = w;
  console.log("holder", d(3).run());
  console.log("direct", f0(7, 1).value);
  use(named);
}
main();
// expect:
// interface victim 5
// value victim 6
// holder 1
// direct 7
// dogs 1
