// C184 (H09b5): polymorphic recursion through an interface's generic method (D-191's demand by name),
// three levels at run time: an internal error past the instance limit under AllInstances, so the
// build fell back to ValueInstances, where the call threw `Expected Box<number>, got Box<any>`.
class Box<T> {
  constructor(public value: T) {}
}
interface Recursive {
  rec<T>(x: T, n: number): Box<T>;
}
class Recurser implements Recursive {
  rec<T>(x: T, n: number): Box<T> {
    if (n > 0) {
      const self: Recursive = this;
      const inner: Box<T[]> = self.rec([x], n - 1);
      return new Box(inner.value[0]);
    }
    return new Box(x);
  }
}
const r: Recursive = new Recurser();
try {
  const b: Box<number> = r.rec(5, 3);
  console.log(b.value + 1);
} catch (error: any) {
  console.log(error.name, error.message);
}
// expect:
// 6
