// A shorthand target's default in an object assignment pattern (`({ p = arr[3] } = o)`) is
// the value the pattern stores in p, as the renamed form's `q = arr[3]` is: an element read
// there reads undefined past the end where p's declared type takes undefined, and p is then
// loose, its reads as a string checked. It threw D-085's RangeError at the default (review
// round 3, R3-F3; pre-existing).
const arr: string[] = ["a"];
const blank: string = "";
const o: { p?: string } = {};
let p: string | undefined = "p";
({ p = arr[3] } = o);
console.log(p === undefined);
try {
  console.log(p.length);
} catch (e) {
  console.log("shorthand threw", (e as Error).name);
}
let q: string | undefined = "q";
({ p: q = arr[3] } = o);
console.log(q === undefined);
let r: string | undefined = "r";
({ r = blank || arr[3] } = {} as { r?: string });
try {
  console.log(r.length);
} catch (e) {
  console.log("|| threw", (e as Error).name);
}
let s: string | undefined = "s";
({ s = arr[0] } = {} as { s?: string });
console.log(s.length);

// expect:
// true
// shorthand threw TypeError
// true
// || threw TypeError
// 1
