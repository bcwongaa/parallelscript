// number arithmetic is IEEE-754 double arithmetic, rounded at every step.
const a = 7;
const b = 2;
console.log(a + b, a - b, a * b, a / b, a % b, a ** b);
console.log(0.1 + 0.2, 0.1 * 3, 1 / 3, 2 / 3, 1 - 0.9);
console.log(-7 % 2, 7 % -2, -7.5 % 2, 5.5 % 1.25, 2 ** -1, 2 ** 0.5, (-2) ** 3);
console.log(1 + 2 * 3, (1 + 2) * 3, 2 ** 3 ** 2, (2 ** 3) ** 2, 10 - 4 - 3, 64 / 4 / 2);
console.log(9007199254740992 + 1, 9007199254740992 + 2, 1e308 * 10, -1e308 * 10, 5e-324 / 2);
console.log(0.1 * 0.1 + 0.2, 1e16 + 1.5, 3 * 0.1 - 0.3);
const big = 123456789;
const ratio = big / 1000;
console.log(ratio, ratio * 1000 === big, -ratio, +ratio);

// expect:
// 9 5 14 3.5 1 49
// 0.30000000000000004 0.30000000000000004 0.3333333333333333 0.6666666666666666 0.09999999999999998
// -1 1 -1.5 0.5 0.5 1.4142135623730951 -8
// 7 9 512 64 3 8
// 9007199254740992 9007199254740994 Infinity -Infinity 0
// 0.21000000000000002 10000000000000002 5.551115123125783e-17
// 123456.789 true -123456.789 123456.789
