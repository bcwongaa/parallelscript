// H09b5d RED (C177, body only, a function-local generic arrow called by name): one instance for
// both twins: the second call threw `Expected number, got string`.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
class Out<T> {
  constructor(public x: T, public note: string) {}
}
type K<T> = T extends { kind: "a" } ? number : string;
function main(): void {
  const pick = <T,>(x: T, text: string): Out<T> => {
    const k = JSON.parse(text) as K<T>;
  return new Out(x, typeof k + " " + String(k));
  };
  attempt("{ kind: 'a' }:", () => {
    const r = pick<{ kind: "a" }>({ kind: "a" as const }, JSON.stringify(3));
    return String(r.note);
  });
  attempt("{ kind: 'b' }:", () => {
    const r = pick<{ kind: "b" }>({ kind: "b" as const }, JSON.stringify("s"));
    return String(r.note);
  });
}
main();
// expect:
// { kind: 'a' }: number 3
// { kind: 'b' }: string s
