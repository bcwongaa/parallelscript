// Assignment, compound assignment, ++/--, ?:, && and ||, comma, typeof, void and the
// bitwise operators on numbers (JS int32 semantics).
let a = 1, b = 2;
a = b = 5;
console.log(a, b, (a = 7) + a);
let x = 10;
x += 5; x -= 3; x *= 2; x /= 4; x %= 4; x **= 3;
console.log(x);
let y = 6;
y &= 3; y |= 8; y ^= 5; y <<= 2; y >>= 1; y >>>= 1;
console.log(y);
let s = "a";
s += "b"; s += 1; s += true; s += null;
console.log(s);
let n = 5;
console.log(n++, n, ++n, n--, n, --n);
console.log(n > 4 ? "big" : "small", n < 0 ? -1 : n === 0 ? 0 : 1);
const yes: boolean = true, no: boolean = false, none = 0, three = 3, nan = NaN, blank: string = "", ex: string = "x";
console.log(yes && no, yes || no, none || 7, three && 4, nan || -0, blank || "fallback", ex && "y");
let calls = 0;
const skipped = no && (calls = 1) > 0;
const taken = yes || (calls = 2) > 0;
console.log(skipped, taken, calls);
let flag = false;
flag ||= true;
let empty = "";
empty ||= "filled";
let zero = 0;
zero &&= 99;
console.log(flag, empty, zero);
console.log((x++, x), typeof 1, typeof "s", typeof true, typeof undefined, typeof null, typeof NaN, void 0);
console.log(5 & 3, 5 | 3, 5 ^ 3, ~5, ~-1, 1 << 31, 1 << 32, -16 >> 2, -16 >>> 28, -1 >>> 0);
console.log(2 ** 32 + 5 | 0, 4294967295 & 0xff, -2147483649 | 0, NaN | 0, Infinity & 1, 3.9 | 0, -3.9 | 0, 1e21 | 0);
const one = 1, negativeZero = -0, nothing = null, missing = undefined;
console.log(!none, !one, !blank, !ex, !nan, !nothing, !missing, !!negativeZero);

// expect:
// 5 5 14
// 8
// 15
// ab1truenull
// 5 6 7 7 6 5
// big 1
// false true 7 4 -0 fallback y
// false true 0
// true filled 0
// 9 number string boolean undefined object number undefined
// 1 7 6 -6 0 -2147483648 1 -4 15 4294967295
// 5 255 2147483647 0 0 3 -3 -559939584
// true false true false true true true false
