// A typed array held as `any` or as an Iterable<number> is iterated live, as JS's
// iterator over it is: a write ahead of the loop shows. Patterns and rest elements take
// its elements (H03, D-177).
const ta = new Float64Array([1, 2, 3]);
const viaAny: any = ta;
for (const x of viaAny) {
  console.log("any loop", x);
  if (x === 1) {
    ta[2] = 99;
  }
}
function sum(values: Iterable<number>): number {
  let total = 0;
  for (const v of values) {
    total += v;
    if (v === 5) {
      tb[2] = 70;
    }
  }
  return total;
}
const tb = new Int32Array([5, 6, 7]);
console.log("Iterable sum", sum(tb));
const [first, second, third] = new Int32Array([0, 6]) as any;
console.log("pattern", first, second, third);
const [, ...rest] = new Uint8Array([1, 2, 3]) as any;
console.log("rest", rest);

// expect:
// any loop 1
// any loop 2
// any loop 99
// Iterable sum 81
// pattern 0 6 undefined
// rest [ 2, 3 ]
