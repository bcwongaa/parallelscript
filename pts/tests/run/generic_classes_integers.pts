// Generic classes instantiated with integer types and f32 (D-048, D-050): fields,
// parameters and results of each instance keep their type.
class Counter<T> {
  constructor(public total: T) {}
  get(): T {
    return this.total;
  }
}
class Pair<A, B> {
  constructor(
    public first: A,
    public second: B,
  ) {}
}
class Ring<T> {
  items: T[] = [];
  add(item: T): Ring<T> {
    this.items.push(item);
    return this;
  }
}
const byteCounter = new Counter<u8>(250);
byteCounter.total += 10;
const bigCounter = new Counter<int>(9007199254740993);
console.log(byteCounter, byteCounter.get() + 1, bigCounter.get() + 1);
const pair = new Pair<u64, i8>(18446744073709551615, -128);
console.log(pair, pair.first + 1, pair.second - 1);
const ring = new Ring<f32>().add(0.1).add(0.5);
console.log(ring, ring.items.map(x => x * 2));

// expect:
// Counter { total: 4 } 5 9007199254740994
// Pair { first: 18446744073709551615, second: -128 } 0 127
// Ring { items: [ 0.10000000149011612, 0.5 ] } [ 0.20000000298023224, 1 ]
