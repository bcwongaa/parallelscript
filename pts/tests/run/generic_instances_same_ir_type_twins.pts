// skip: known issue (H09b5d, C177): structural twins are one shape, so the calls share an instance whose result is the first call's: PTS1001 `using a Box as a Box`
// C177 (H09b5): { kind: "a" } and { kind: "b" } are one shape (IR type), so pick's two calls shared
// one instance, made for the first, whose R<T> is Box<number>: the second call's Box<string> was
// PTS1001 `using a Box as a Box`. Each call alone matches Node.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
type R<T> = Box<T extends { kind: "a" } ? number : string>;
function pick<T>(x: T, v: R<T>): R<T> {
  return new Box(v.value);
}
attempt("{ kind: 'a' }:", () => {
  const r = pick<{ kind: "a" }>({ kind: "a" as const }, new Box(3));
  return String(r.value + 1);
});
attempt("{ kind: 'b' }:", () => {
  const r = pick<{ kind: "b" }>({ kind: "b" as const }, new Box("s"));
  return String(r.value + "!");
});
// expect:
// { kind: 'a' }: 4
// { kind: 'b' }: s!
