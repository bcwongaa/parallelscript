// A generic function's overloads may have other type parameters than its implementation,
// or the same in another order (M6.0b5): the implementation's instance is the one for
// the type arguments its signature takes in the overload's place.
function pair<A, B>(a: A, b: B): [A, B];
function pair<T>(a: T, b: T): [T, T] {
  return [a, b];
}
console.log(pair(1, 2), pair("x", "y"));
function tag<B, A>(a: A, b: B): string;
function tag<X, Y>(a: X, b: Y): string {
  return `${typeof a}:${String(a)} ${typeof b}:${String(b)}`;
}
console.log(tag(1, "one"), tag("two", 2));
