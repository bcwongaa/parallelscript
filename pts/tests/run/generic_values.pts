// Generic functions as values (D-078): a generic function declaration where a function
// type that isn't generic goes is the instance for the type arguments the context implies;
// anywhere else, and every generic arrow function, is an erased copy whose type parameters
// take dynamic values, with its results converted back where it is called.
function identity<T>(x: T): T {
  return x;
}
function first<T>(xs: T[]): T | undefined {
  return xs.length > 0 ? xs[0] : undefined;
}
function wrap<T>(x: T): T[] {
  return [x];
}
function box<T>(value: T): { value: T } {
  return { value };
}
function pushTwice<T>(xs: T[], x: T): number {
  xs.push(x);
  xs.push(x);
  return xs.length;
}

// Declarations used as values without a context: their erased copies.
const id = identity;
console.log(id(1), id("two"), id(true), id(null), id([1, 2]));
const f = first;
console.log(f([3, 4]), f<string>([]), f(["a"]));
const w = wrap;
const ws: number[] = w(7);
console.log(ws, w("s"));
const b = box;
console.log(b(1), b("x").value);
const nums = [1, 2];
const p = pushTwice;
console.log(p(nums, 9), nums); // the same array, not a copy
console.log(identity, typeof id, id === identity);

// In a context of a function type: the instance it implies.
console.log([1, 2, 3].map(identity), ["a"].map(wrap));
const strs: (x: string) => string[] = wrap;
console.log(strs("z"));
function apply<T>(fn: (x: T) => T, x: T): T {
  return fn(x);
}
console.log(apply(identity, 5), apply(id, "s"));
const wrapNumber = wrap<number>;
console.log(wrapNumber(3));

// Generic arrow functions and function expressions.
const arrow = <T>(x: T): T[] => [x, x];
console.log(arrow(3), arrow("q"));
const generic: <T>(x: T) => T = (x) => x;
console.log(generic(42));
const g = <T>(x: T): T => x;
console.log([1, 2].map(g), ["a", "b"].filter(g));
const fact = function f<T>(n: number, x: T): T[] {
  return n <= 0 ? [] : [x, ...f(n - 1, x)];
};
console.log(fact(3, "z"));

// Constraints, narrowing and the operators on type parameters' values.
const getName = <T extends { name: string }>(o: T): string => o.name;
console.log(getName({ name: "ann", age: 3 }));
const inc = <T extends number>(x: T): number => x + 1;
console.log(inc(41));
const describe = <T>(x: T): string => (typeof x === "number" ? `n${x + 1}` : `v${String(x)}`);
console.log(describe(1), describe("s"), describe(true));

// Rest parameters, optional and default parameters.
const count = <T>(...xs: T[]): number => xs.length;
console.log(count(1, 2, 3), count());
const orElse = <T>(x: T | undefined, fallback: T): T => (x === undefined ? fallback : x);
console.log(orElse(undefined, 5), orElse("a", "b"));
const repeat = <T>(x: T, times: number = 2): T[] => {
  const out: T[] = [];
  for (let i = 0; i < times; i++) out.push(x);
  return out;
};
console.log(repeat("x"), repeat(1, 3));

// Closures: capturing, nested in generic functions' instances.
function makeTagger(tag: string) {
  return <T>(x: T): [string, T] => [tag, x];
}
const tagger = makeTagger("t");
console.log(tagger(1), tagger("y"));
function outer<T>(x: T): T[] {
  const pair = <U>(y: U): [T, U] => [x, y];
  console.log(pair(1), pair("u"));
  return [x];
}
console.log(outer(true), outer("o"));

// Arrays, tuples, maps, sets and strings in erased code.
const swap = <A, B>(pair: [A, B]): [B, A] => [pair[1], pair[0]];
console.log(swap([1, "one"]));
const keys = <T extends object>(o: T): string[] => Object.keys(o);
console.log(keys({ a: 1, b: 2 }));
const len = <T>(xs: T[]): number => {
  let n = 0;
  for (const x of xs) n++;
  return n;
};
console.log(len([1, 2, 3]));
const last = <T>(xs: T[]): T => xs[xs.length - 1];
const lastNum: number = last([4, 5, 6]);
console.log(lastNum, last(["p", "q"]).toUpperCase());
const mapped = <T, U>(xs: T[], fn: (x: T) => U): U[] => xs.map(fn);
console.log(mapped([1, 2], (x) => x * 10), mapped(["a"], (s) => s + "!"));
const mapAll = <T, U>(xs: T[], fn: (x: T) => U): U[] => {
  const out: U[] = [];
  for (let i = 0; i < xs.length; i++) {
    out.push(fn(xs[i]));
  }
  return out;
};
console.log(mapAll([1, 2, 3], (x) => x * 2), mapAll(["a"], (s) => s.length));
const pick = <V>(k: string, v: V): Record<string, V> => {
  const r: Record<string, V> = {};
  r[k] = v;
  return r;
};
console.log(pick("a", 1));
const entries = <V>(m: Map<string, V>): [string, V][] => [...m];
console.log(entries(new Map([["x", 1]])));
const sizeOf = <T>(s: Set<T>): number => s.size;
console.log(sizeOf(new Set([1, 2, 2])));
const chars = <T extends string>(s: T): string[] => [...s];
console.log(chars("héllo"));
const firstOf = <T>(xs: T[]): T | undefined => xs.find((x) => x !== undefined);
console.log(firstOf([7, 8]), firstOf<number>([]));

// Generic function types of properties and parameters.
interface Api {
  id: <T>(x: T) => T;
  name: string;
}
const api: Api = { id: identity, name: "api" };
console.log(api.id(5), api.id("s"), api);
const api2: Api = { id: (x) => x, name: "two" };
console.log(api2.id([1]));
function useId(fn: <T>(x: T) => T): [number, string] {
  return [fn(1), fn("a")];
}
console.log(useId(identity), useId((x) => x));
const fns = [identity, <U>(u: U): U => u];
console.log(fns.length, fns[1](3));
