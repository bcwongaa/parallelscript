// C176 (H09b5b review round 2, R2-2): in Bad.make<Dog[]> (only m.make's demand by name makes it,
// speculatively), a statement starts with a value call with a rest parameter, which lowers, and then
// keeps the Dog[] as an Animal[] (D-094): the trial's own failure, taken back as on the base, not
// the call site's, so the build stays at AllInstances and m.make keeps its instance.
class Box<T> {
  constructor(public value: T) {}
}
class Animal {
  name = "a";
}
class Dog extends Animal {
  bark = 1;
}
const kept: Animal[][] = [];
function keepAnimals(a: Animal[]): number {
  kept.push(a);
  return a.length;
}
interface Maker {
  make<T>(x: T): Box<T>;
}
class Good implements Maker {
  make<T>(x: T): Box<T> {
    return new Box(x);
  }
}
class Bad implements Maker {
  make<T>(x: T): Box<T> {
    const g = <U,>(a: number, ...xs: U[]): Box<U[]> => new Box(xs);
    console.log("bad", g(1, x).value.length, Array.isArray(x) ? keepAnimals(x) : 0);
    return new Box(x);
  }
}
const makers: Maker[] = [new Good(), new Bad()];
const m: Maker = makers[0];
console.log("by name", m.make([new Dog()]).value.length);
// expect:
// by name 1
