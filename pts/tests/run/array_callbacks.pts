// The array methods that take callbacks, as Node runs them.

const nums = [5, 3, 8, 1, 9, 2];
console.log(nums.map((n) => n * 2), nums.map((n, i) => n + ":" + i));
console.log(nums.filter((n) => n % 2 === 1), nums.filter((n, i, all) => all.length > i * 2));
let total = 0;
nums.forEach((n) => (total += n));
console.log("total", total);
console.log(nums.reduce((a, b) => a + b), nums.reduce((acc, n) => acc + n, 100), nums.reduce((s, n) => s + n, ""));
console.log(nums.reduceRight((acc, n) => acc + "," + n, "start"), nums.reduceRight((a, b) => a - b));
console.log(nums.find((n) => n > 4), nums.find((n) => n > 100), nums.findIndex((n) => n === 8), nums.findIndex((n) => n > 100));
console.log(nums.findLast((n) => n < 5), nums.findLastIndex((n) => n < 5), nums.findLast((n) => n > 100));
console.log(nums.some((n) => n > 8), nums.every((n) => n > 0), nums.every((n) => n > 1));
console.log(nums.flatMap((n) => [n, n * 10]), ["a b", "c"].flatMap((s) => s.split(" ")), nums.flatMap((n) => n + 1));
console.log([[1], [2, 3]].flatMap((inner) => inner), [[[1]], [[2]]].flatMap((x) => x));

// Results that are truthy or falsy rather than booleans.
console.log(["", "a", "b", ""].filter((s) => s), [0, 1, 2, NaN].findIndex((n) => n), ["x"].some((s) => s.length));

// Chained calls, and callbacks that capture variables.
const threshold = 3;
const scale = 10;
console.log(
  nums
    .filter((n) => n > threshold)
    .map((n) => n * scale)
    .reduce((sum, n) => sum + n, 0),
);

// Named functions and function values as callbacks.
function isEven(n: number): boolean {
  return n % 2 === 0;
}
const square = (n: number) => n * n;
console.log(nums.filter(isEven), nums.map(square), nums.some(isEven));

// Arrays of objects.
class Person {
  constructor(
    public name: string,
    public age: number,
  ) {}
}
const people = [new Person("Ada", 36), new Person("Alan", 41), new Person("Grace", 36), new Person("Edsger", 72)];
console.log(people.map((p) => p.name).join(", "));
console.log(people.filter((p) => p.age < 40));
console.log(people.find((p) => p.name.startsWith("G"))!.age, people.findIndex((p) => p.age > 70));
const byAge = people.reduce((acc, p) => acc + p.age, 0) / people.length;
console.log("average age", byAge);
interface Named {
  name: string;
}
const shout = (n: Named) => n.name.toUpperCase();
console.log(people.map(shout));

// sort with a comparator is stable, like V8's.
const sortedByAge = people.slice().sort((a, b) => a.age - b.age);
console.log(sortedByAge.map((p) => p.name + " " + p.age));
console.log(nums.slice().sort((a, b) => b - a), nums);
const words = ["banana", "Apple", "cherry", "apple", "Banana"];
console.log(
  words.sort((a, b) => {
    const x = a.toLowerCase();
    const y = b.toLowerCase();
    return x < y ? -1 : x > y ? 1 : 0;
  }),
);
console.log([3, 1, 2].sort(() => NaN), [3, 1, 2].sort((a, b) => (a < b ? -1 : 1)));

// Each method reads the length once: elements pushed by the callback aren't visited.
const growing = [1, 2, 3];
growing.forEach((n) => {
  growing.push(n * 10);
});
console.log(growing);
const visited: number[] = [];
const shrinking = [1, 2, 3, 4];
shrinking.forEach((n) => {
  visited.push(n);
  shrinking.pop();
});
console.log(visited, shrinking);

// Empty arrays.
const empty: number[] = [];
console.log(empty.map((n) => n), empty.some((n) => n > 0), empty.every((n) => n > 0), empty.reduce((a, n) => a + n, 7));

// Array.from with a mapping function.
console.log(Array.from([1, 2, 3], (x) => x * x), Array.from("héllo👍", (c, i) => c + i));

