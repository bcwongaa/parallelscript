// Typed calls of generic function values find the instance of their signature that the
// value lists (D-148): a factory whose instance narrows its value to a type it can't have
// (`typeof x === "number"` for a string) lowers that branch as code that can't run
// (D-195), so its instances for number and string are listed (before, the string's
// wasn't, and the call took the erased copy: TypeError, C171). An inline generic arrow
// function lists its instances too, which run with its closure (D-190).
class Box<T> {
  constructor(public value: T) {}
}
function show<T>(x: T): Box<T> {
  if (typeof x === "number") {
    console.log("a number", x + 1);
  }
  return new Box(x);
}
function use(f: <T>(x: T) => Box<T>): void {
  try {
    const n: Box<number> = f(2);
    console.log("number", n.value);
  } catch (error: any) {
    console.log(error.name, error.message);
  }
  try {
    const s: Box<string> = f("s");
    console.log("string", s.value);
  } catch (error: any) {
    console.log(error.name, error.message);
  }
}
use(show);
use(<T>(x: T) => new Box(x));
const anyShow: any = show;
console.log(anyShow(5).value);

// expect:
// a number 3
// number 2
// string s
// number 2
// string s
// a number 6
// 5
