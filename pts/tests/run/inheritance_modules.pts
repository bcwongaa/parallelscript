// Classes extend classes of other modules, named, through a namespace or as a default
// export; a class of the same name in two modules stays distinct.
import { Rect as BaseRect, Shape } from "./inheritance_modules/shapes.pts";
import * as shapes from "./inheritance_modules/shapes.pts";
import Unit from "./inheritance_modules/shapes.pts";

class Square extends shapes.Rect {
  constructor(side: number) {
    super(side, side);
    this.name = "square";
  }
}

class Twice extends Unit {
  area(): number {
    return 2 * super.area();
  }
}

// Not the module's Rect.
class Rect extends BaseRect {
  area(): number {
    return -super.area();
  }
}

const square: Shape = new Square(3);
const twice: Shape = new Twice();
console.log(square.report(), "|", twice.report(), "|", new Rect(2, 5).report(), new BaseRect(2, 5).report());
console.log(square, twice instanceof Unit, twice instanceof shapes.Rect, square instanceof Unit);

// expect:
// square 9 | unit: rect 2 | rect -10 rect 10
// Square { name: 'square', w: 3, h: 3 } true true false
