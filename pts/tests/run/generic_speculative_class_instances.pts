// C172 (H09b5): mkA is called with 25 class types and needs Box<Ai> and Box<Ai[]>; mkB, of the
// same function type, is called with number only. Pairing every value demand with every value
// of its erased type (D-148, D-190) gives mkB instances for mkA's demands, whose Box<Ai[][]>
// class instances no call uses count against the 64-instance limit and fill it, so mkA's own
// instances for A18 on fail their trials and those calls throw `Expected Box<A18>, got Box<any>`.
// The limit is polymorphic recursion's depth now, which side-by-side instances don't reach
// (D-198); mkB's speculative instances are still made (C172's growth, H09b5c).
class Box<T> {
  constructor(public value: T) {}
}
class A0 {
  tag = 0;
}
class A1 {
  tag = 1;
}
class A2 {
  tag = 2;
}
class A3 {
  tag = 3;
}
class A4 {
  tag = 4;
}
class A5 {
  tag = 5;
}
class A6 {
  tag = 6;
}
class A7 {
  tag = 7;
}
class A8 {
  tag = 8;
}
class A9 {
  tag = 9;
}
class A10 {
  tag = 10;
}
class A11 {
  tag = 11;
}
class A12 {
  tag = 12;
}
class A13 {
  tag = 13;
}
class A14 {
  tag = 14;
}
class A15 {
  tag = 15;
}
class A16 {
  tag = 16;
}
class A17 {
  tag = 17;
}
class A18 {
  tag = 18;
}
class A19 {
  tag = 19;
}
class A20 {
  tag = 20;
}
class A21 {
  tag = 21;
}
class A22 {
  tag = 22;
}
class A23 {
  tag = 23;
}
class A24 {
  tag = 24;
}
function mkA<T>(x: T): Box<T> {
  const w = new Box([x]);
  return new Box(w.value[0]);
}
function mkB<T>(x: T): Box<T> {
  const w = new Box([[x]]);
  return new Box(w.value[0][0]);
}
function useA(f: <T>(x: T) => Box<T>): void {
  try {
    const b0: Box<A0> = f(new A0());
    console.log(0, b0.value.tag);
  } catch (e: any) {
    console.log(0, e.message);
  }
  try {
    const b1: Box<A1> = f(new A1());
    console.log(1, b1.value.tag);
