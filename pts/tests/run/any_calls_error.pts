// What calls through `any` check (D-074), where JS carries on: each argument must be of
// its parameter's type (a missing one is undefined), dynamic data passed for an object
// type is copied into it, and a function of another type is adapted (D-075).
interface Size {
  w: number;
  h: number;
}
function area(size: Size): number {
  return size.w * size.h;
}
function greet(name: string): string {
  return "hello " + name;
}
function apply(f: (x: number) => number, x: number): number {
  return f(x);
}
class Account {
  balance: int = 0;
  deposit(amount: int): int {
    this.balance += amount;
    return this.balance;
  }
}
function attempt(what: string, f: () => void): void {
  try {
    f();
    console.log(what, "ok");
  } catch (e: any) {
    console.log(what, "->", e.name + ": " + e.message);
  }
}
const anyArea: any = area;
const anyGreet: any = greet;
const account: any = new Account();
const data: Record<string, any> = { w: 3, h: 4, d: 5 };
console.log(anyArea(data), anyArea({ w: 2, h: 2 }));
attempt("a number for a string", () => { anyGreet(5); });
attempt("a missing argument", () => { anyGreet(); });
attempt("a fraction for an int", () => { account.deposit(1.5); });
attempt("data that isn't a Size", () => { anyArea({ w: 1 }); });
attempt("a function argument", () => { const anyApply: any = apply; console.log(anyApply((x: number) => x + 1, 1)); });
attempt("a number for a function", () => { const anyApply: any = apply; anyApply(1, 1); });
attempt("a method of a string", () => { const s: any = "abc"; s.toUpperCase(1, 2); });
console.log(account.deposit(7), account.balance);

// no-diff: JS checks no arguments
// expect:
// 12 4
// a number for a string -> TypeError: Expected string, got number
// a missing argument -> TypeError: Expected string, got undefined
// a fraction for an int -> TypeError: Expected i64, got number
// data that isn't a Size -> TypeError: Expected {h: number; w: number}, got Object
// 2
// a function argument ok
// a number for a function -> TypeError: Expected (number) => number, got number
// a method of a string ok
// 7 7
