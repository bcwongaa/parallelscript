// skip: known issue (H14, C367): macOS resets connects past its 128-entry listen queue; 200 simultaneous fetches from the same program lose requests where Node's node:http loses none in H36's recorded probe
// Keep the unthrottled workload visible while signal correctness tests use waves on macOS.
// Historical native-Mac RED: h36-parent-probes.tar.gz, macci/r3, burst.pts (2 to 69 resets of 200).
// threads: 1 2 4
import { serve } from "pts:http";

const server = serve({
    port: 0,
    hostname: "127.0.0.1",
    fetch() {
        return new Response("ok");
    },
});
const url = `http://127.0.0.1:${server.port}`;
const outcomes = await Promise.all(Array.from({ length: 200 }, () => fetch(url).then(
    (response) => response.text(),
    () => "failed",
)));
console.log(outcomes.every((outcome) => outcome === "ok"));
server.stop();

// expect:
// true
