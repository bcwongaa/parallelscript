// C172 (H09b5): two generic declarations of one function type, each passed to its own consumer
// that calls it with 33 class types of its own: each needs 33 instances, but pairing every
// demand with every value of the type gives each 66, past the 64-instance limit (D-049), which
// was PTS1001 `a generic function with more than 64 instances (mapOf0)`.
function mapOf0<T>(x: T): Map<string, T> {
  return new Map([["k0", x]]);
}
