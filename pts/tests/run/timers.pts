// Timers (D-114): order by delay, then creation; microtasks after each callback;
// intervals, clearing, arguments, nesting, immediates after timers within a callback.
const log: string[] = [];
setTimeout(() => log.push("30"), 30);
setTimeout(() => log.push("10"), 10);
setTimeout(() => log.push("10 again"), 10);
setTimeout((a: number, b: string) => log.push(`args ${a} ${b}`), 20, 7, "x");
const cancelled = setTimeout(() => log.push("never"), 15);
clearTimeout(cancelled);
clearTimeout(undefined);
let ticks = 0;
const interval = setInterval(() => {
  ticks++;
  log.push(`tick ${ticks}`);
  if (ticks === 3) clearInterval(interval);
}, 5);
setTimeout(() => {
  log.push("timer A");
  Promise.resolve().then(() => log.push("microtask after A"));
  queueMicrotask(() => log.push("queued after A"));
  setImmediate(() => log.push("immediate from A"));
  setTimeout(() => log.push("timer from A"), 0);
}, 40);
setTimeout(() => log.push("timer B"), 40);
setTimeout(() => {
  console.log(log.join("\n"));
}, 100);
queueMicrotask(() => log.push("first microtask"));
Promise.resolve().then(() => log.push("promise microtask"));
log.push("sync end");

// expect:
// sync end
// first microtask
// promise microtask
// tick 1
// 10
// 10 again
// tick 2
// tick 3
// args 7 x
// 30
// timer A
// microtask after A
// queued after A
// timer B
// immediate from A
// timer from A
