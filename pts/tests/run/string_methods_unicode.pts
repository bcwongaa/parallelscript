// Indices count UTF-16 code units: "é" is one, "😀" is two (a surrogate pair), and
// cutting a pair in half leaves a lone surrogate, which console.log prints as U+FFFD.
const s = "héllo 😀 wörld";
console.log(s.length, s[1], s[6], s.charCodeAt(6), s.charCodeAt(7), s.slice(6, 8), s.slice(7).length);
console.log(s.indexOf("😀"), s.indexOf("w"), s.indexOf("\uDE00"), s.includes("\uD83D"), s.includes("\uD83D", 7));
console.log(s.slice(-5), s.substring(1, 3), s.toUpperCase(), "ÀÉÎ".toLowerCase());
console.log(s.startsWith("😀", 6), s.startsWith("\uDE00", 7), s.endsWith("\uD83D", 7), s.endsWith("lo 😀", 8));
console.log("\u00A0\u3000\uFEFFx\u2028".trim(), "\u2003é\u2003".trimStart().length, "\u2003é\u2003".trimEnd().length);
console.log("😀".padStart(5, "é"), "x".padEnd(4, "😀"), "x".padEnd(4, "😀").length, "😀".repeat(3));
const high = "a\uD83D";
const low = "\uDE00b";
console.log(high.padEnd(3, low), (high + low).length, ("\uDE00x\uD83D").repeat(2).length);

// expect:
// 14 é � 55357 56832 😀 7
// 6 9 7 true false
// wörld él HÉLLO 😀 WÖRLD àéî
// true true true true
// x 2 2
// ééé😀 x😀� 4 😀😀😀
// a😀 4 6
