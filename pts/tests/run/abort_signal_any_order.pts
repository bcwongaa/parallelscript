// AbortSignal.any's followers abort as the DOM standard's "signal abort" orders it (C121,
// H07b1): a source's followers have their reasons before the source's "abort" event fires, and
// their own events fire after the source's, whichever was made first.
const first = new AbortController();
const follower = AbortSignal.any([first.signal]);
follower.addEventListener("abort", () => console.log("follower's listener; source aborted:", first.signal.aborted));
first.signal.addEventListener("abort", () => console.log("source's listener; follower aborted:", follower.aborted));
first.abort();

const second = new AbortController();
second.signal.addEventListener("abort", () => console.log("earlier source listener; follower aborted:", late.aborted));
const late = AbortSignal.any([second.signal]);
late.addEventListener("abort", () => console.log("later follower's listener"));
second.abort();
