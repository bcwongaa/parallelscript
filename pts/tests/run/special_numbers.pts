// NaN, Infinity and -0 behave exactly as in JavaScript.
console.log(NaN, Infinity, -Infinity, -0, 0 * -1, -0 + 0, -0 - 0);
console.log(0 / 0, 1 / 0, -1 / 0, 1 / -0, Infinity - Infinity, Infinity * 0, Infinity / Infinity);
const nan = 0 / 0; // tsc rejects comparisons with the NaN literal itself (TS2845)
console.log(nan === nan, nan !== nan, nan < 1, nan >= 1, 0 === -0, 1 / 0 === Infinity, -Infinity < -1e308);
console.log(5 % 0, 5 % Infinity, -0 % 5, Infinity % 2, 0 % -3);
console.log(1 ** NaN, 1 ** Infinity, (-1) ** -Infinity, NaN ** 0, 0 ** -1, (-0) ** -1, (-0) ** 3, 0.5 ** Infinity);
console.log(2 ** 1024, 2 ** -1075, 2 ** -1074, (-8) ** (1 / 3));

// expect:
// NaN Infinity -Infinity -0 -0 0 -0
// NaN Infinity -Infinity -Infinity NaN NaN NaN
// false true false false true true true
// NaN 5 -0 NaN 0
// NaN NaN NaN 1 Infinity -Infinity -0 0
// Infinity 0 5e-324 NaN
