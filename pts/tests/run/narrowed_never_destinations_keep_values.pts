// Guard (passes on the base): a value that reaches code tsc types never must arrive as it is
// where never goes (H09b4b2, C220). A D-090 loose local (an element read past the end, a
// record's missing key) holds undefined: `assertNever(y)` gets undefined and throws its own
// Error. (A never function's `return c` for an enum's other number, and `return x` after a
// lying predicate, are `never_functions_return_values.pts`, C239.)
function assertNever(x: never): never {
  throw new Error("unexpected " + String(x)); // not JSON.stringify, whose undefined is C151's
}
function elementAssertNever(i: number): string {
  const a: string[] = ["a"];
  const y = a[i];
  if (y === undefined) {
    return assertNever(y);
  }
  return "element " + y;
}
function recordAssertNever(k: string): string {
  const d: Record<string, number> = { a: 1 };
  const y = d[k];
  if (y === undefined) {
    assertNever(y);
  }
  return "record " + y;
}

for (const f of [() => elementAssertNever(5), () => elementAssertNever(0), () => recordAssertNever("z"), () => recordAssertNever("a")]) {
  try {
    console.log(f());
  } catch (error: any) {
    console.log("caught", error.message);
  }
}

// expect:
// caught unexpected undefined
// element a
// caught unexpected undefined
// record 1
