// threads: 1 4
// fetch (D-160, D-162) cleans up after itself: after thousands of requests, some aborted
// at every stage, the process has the files it had before and hasn't grown much. The
// server's side too: it closes the connections of aborted requests that it holds, whose
// clients have gone, without waiting for their answers, which never come (D-163; which
// requests get that far depends on timing: TestHTTPServerLifecycle checks it exactly).
import { serve } from "pts:http";
import { readdirSync } from "pts:fs";

const held: ((response: Response) => void)[] = [];
const server = serve({
  port: 0,
  hostname: "127.0.0.1",
  fetch(request) {
    if (request.url.endsWith("/hold")) {
      return new Promise<Response>((resolve) => held.push(resolve));
    }
    return new Response("x".repeat(1000));
  },
});
const base = `http://127.0.0.1:${server.port}`;

// /dev/fd lists this process's open files on Linux (where it is /proc/self/fd) and macOS.
function openFiles(): number {
  return readdirSync("/dev/fd").length;
}

function residentMB(): number {
  return process.memoryUsage().rss / (1024 * 1024);
}

function pause(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

// count requests, concurrency at a time; returns how many bodies were whole.
async function fetchAll(count: number, concurrency: number): Promise<number> {
  let whole = 0;
  for (let done = 0; done < count; done += concurrency) {
    const bodies = await Promise.all(Array.from({ length: concurrency }, () => fetch(base).then((r) => r.text())));
    whole += bodies.filter((body) => body.length === 1000).length;
  }
  return whole;
}

// count requests to /hold, each aborted after a delay of 0 to 4 ms (some before they connect); returns how many rejected with AbortError.
async function abortAll(count: number): Promise<number> {
  const outcomes: Promise<string>[] = [];
  for (let i = 0; i < count; i++) {
    const controller = new AbortController();
    outcomes.push(fetch(`${base}/hold`, { signal: controller.signal }).then(() => "fulfilled", (e: Error) => e.name));
    if (i % 5 === 0) {
      controller.abort();
    } else {
      setTimeout(() => controller.abort(), i % 5);
    }
  }
  return (await Promise.all(outcomes)).filter((name) => name === "AbortError").length;
}

console.log("warm-up:", await fetchAll(200, 20), await abortAll(100));
await pause(200); // for the server to see the last aborted requests' clients leave
const files = openFiles();
const resident = residentMB();
console.log("requests:", await fetchAll(3000, 50));
console.log("aborted:", await abortAll(1000));
await pause(200);
console.log("files as before:", openFiles() === files || `${files} before, ${openFiles()} after`);
const grown = residentMB() - resident;
console.log("grew less than 40 MB:", grown < 40 || `${grown} MB`);
server.stop();

// expect:
// warm-up: 200 100
// requests: 3000
// aborted: 1000
// files as before: true
// grew less than 40 MB: true
