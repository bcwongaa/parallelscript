// [[1],[2]]
// [[2],[1]]
// [[2,0],[1,0]]
// [[0],[1]]
// [[1],[2]]
// [[2]]
// [[1],[2],[2],[3]]
// [[1],[2]]
// [[1],[2,2]]
// 1 5 true true
// [[[1],[2]]]
// [[[1],[2]],[[2],[3]]]
// 1 d
// [
//   { name: 'n1', size: 1 },
//   { name: 'n2', size: 2 },
//   { name: 'n3', size: 3 }
// ]
// [{"arr":[1]},{"arr":[2]}]
// [{"arr":[1]},{"arr":[2]}]
// [["a","b"],["c"]]
// [ 1, 's', 't' ]
// [[1],[2]]
// [[[2],[3]]]
// [[[1],[2]],[[2],[3]]]
// [[[1],[2]],[[2],[3]]]
// ["a","b"]
// [{"name":"u1","age":1},{"name":"u2","age":2},{"name":"u3","age":3}]
// [{"a":1,"z":1},{"a":2,"z":2}]
