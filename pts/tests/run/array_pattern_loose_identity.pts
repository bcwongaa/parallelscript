// A name a declaration's array pattern binds to a map's entry holds that entry, one
// array, as in JS: writes through it and through aliases stay, and it is itself, through
// a typed Map, its iterators, an Iterable holder and a generic parameter (H03 review
// round 3, R3-B1; loose locals, D-172, D-177).
const m = new Map([["a", 1], ["b", 2]]);
const [e] = m;
e[1] += 10;
console.log("mutated", e, e[1]);
const alias = e;
alias[1] = 99;
console.log("alias", e[1], alias === e, e === e);
const list = [e];
console.log("in array", list[0] === e);
function bump(entry: [string, number]): void {
  entry[1]++;
}
bump(e);
console.log("after call", e, m.get("a"));
const [g] = m.entries();
g[1] = 5;
console.log("entries()", g, g === g);
const held: Iterable<[string, number]> = m;
const [h] = held;
h[1] = 2;
console.log("Iterable holder", h, h === h);
function first<T extends Iterable<[string, number]>>(x: T): [string, number] {
  const [entry] = x;
  entry[1] = 3;
  return entry;
}
console.log("generic", first(m));
const [it] = m[Symbol.iterator]();
it[1] = 4;
console.log("Symbol.iterator", it, it === it);
const nested = new Map([["n", [1, 2]]]);
const [ne] = nested;
ne[1].push(3);
console.log("nested array value", ne, nested.get("n"));
const [p, q, r] = m;
console.log("past the end", p, q, r);

// expect:
// mutated [ 'a', 11 ] 11
// alias 99 true true
// in array true
// after call [ 'a', 100 ] 1
// entries() [ 'a', 5 ] true
// Iterable holder [ 'a', 2 ] true
// generic [ 'a', 3 ]
// Symbol.iterator [ 'a', 4 ] true
// nested array value [ 'n', [ 1, 2, 3 ] ] [ 1, 2, 3 ]
// past the end [ 'a', 1 ] [ 'b', 2 ] undefined
