// skip: known issue (H09b5d, C177): direct calls whose type arguments have the same IR types share an instance whose Box<Awaited<T>> is the first call's: PTS1001 `using a Box as a Box`
// C177 (H09b5): instances are keyed by their type arguments' IR types (D-049), so the direct calls
// pick<Promise<number>> and pick<Promise<string>> (both IR value) shared one instance, made for the
// first, whose parameter and result are Box<number>: the second call's Box<string> was PTS1001
// `using a Box as a Box`. Each call alone matches Node.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
type R<T> = Box<T extends Promise<infer U> ? U : T>;
function pick<T>(x: T, v: R<T>): R<T> {
  return new Box(v.value);
}
attempt("Promise<number>:", () => {
  const r = pick<Promise<number>>(Promise.resolve(1), new Box(2));
  return String(r.value + 1);
});
attempt("Promise<string>:", () => {
  const r = pick<Promise<string>>(Promise.resolve("s"), new Box("t"));
  return String(r.value + "!");
});
// expect:
// Promise<number>: 3
// Promise<string>: t!
