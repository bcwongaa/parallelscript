// Integer types wrap on overflow, divide by truncating, and print exactly.
const max: i32 = 2147483647;
console.log(max + 1, max * 2, -max - 2);
const byte: u8 = 250;
console.log(byte + 10, byte * 2, byte - 251);
const big: int = 9223372036854775807;
console.log(big, big + 1, -big - 1);
const huge: u64 = 18446744073709551615;
console.log(huge, huge + 1);
const exact: int = 9007199254740993;
console.log(exact, exact + 1, 9007199254740993 as int);
const seven: int = 7;
console.log(seven / 2, -seven / 2, seven % 3, -seven % 3, seven % -3, seven ** 2, seven * 1.5);
const three: i8 = 3;
console.log(three / 2 * 2, (three as number) / 2);
const tenth: f32 = 0.1;
console.log(tenth, tenth + tenth, (tenth as number) + 0.2, tenth < 0.2);

// expect:
// -2147483648 -2 2147483647
// 4 244 255
// 9223372036854775807 -9223372036854775808 -9223372036854775808
// 18446744073709551615 0
// 9007199254740993 9007199254740994 9007199254740992
// 3 -3 1 -1 1 49 10.5
// 2 1.5
// 0.10000000149011612 0.20000000298023224 0.30000000149011613 true
