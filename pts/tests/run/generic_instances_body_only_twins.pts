// H09b5d RED (C177, body only): { kind: "a" } and { kind: "b" } are one IR shape, and pick's IR
// signature (shape, string) => Out<shape> is the same for both, so the direct calls shared the
// instance made for the first, whose body parses the text as K<T> = number: the second call threw
// `Expected number, got string`. Each call alone matches Node. A key of IR arguments plus the IR
// signature can't tell them apart; only the type arguments' checker identity can.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
class Out<T> {
  constructor(public x: T, public note: string) {}
}
type K<T> = T extends { kind: "a" } ? number : string;
function pick<T>(x: T, text: string): Out<T> {
  const k = JSON.parse(text) as K<T>;
  return new Out(x, typeof k + " " + String(k));
}
attempt("{ kind: 'a' }:", () => {
  const r = pick<{ kind: "a" }>({ kind: "a" as const }, JSON.stringify(3));
  return String(r.note);
});
attempt("{ kind: 'b' }:", () => {
  const r = pick<{ kind: "b" }>({ kind: "b" as const }, JSON.stringify("s"));
  return String(r.note);
});
// expect:
// { kind: 'a' }: number 3
// { kind: 'b' }: string s
