// H10a review round 6 (R6-F3) and session 6's reproducer (N13): the objects stay the
// instance's own in Node. The base copied them into the containers' any[] elements, so the
// writes were lost silently. H10b: such containers hold them as dynamic values (C285, D-219).
interface Cache<K, V> {
  get(key: K): V | undefined;
}
class MapLRU<K, V> implements Cache<K, V> {
  matrix: V[][] = [[], []];
  store = new Map<K, V[]>();
  constructor(public key: K, public val: V) {
    this.store.set(key, []);
  }
  get(key: K): V | undefined {
    return key === this.key ? this.val : undefined;
  }
}
async function run(c: Cache<string, number>): Promise<void> {
  if (!(c instanceof MapLRU)) return;
  [...c.matrix][0].push(1);
  [...c.matrix, []][1].push(2);
  for (const [, row] of c.matrix.entries()) row.push(3);
  for (const row of new Set(c.matrix)) row.push(4);
  Array.from(c.store.values())[0].push(5);
  [...c.store][0][1].push(6);
  new Map(c.store).get("k")!.push(7);
  c.store.values().next().value!.push(8);
  const rows = await Promise.all(c.matrix);
  rows[0].push(9);
}
const m = new MapLRU<string, number>("k", 0);
await run(m);
console.log(m.matrix, m.store.get("k"));
// expect:
// [ [ 1, 3, 4, 9 ], [ 2, 3, 4 ] ] [ 5, 6, 7, 8 ]
