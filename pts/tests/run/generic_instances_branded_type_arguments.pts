// skip: known issue (H09b5d, C177): a branded type argument gets its primitive's instance, whose R<T> isn't the call's: PTS1001 `using a Box as a Box`
// C177 (H09b5): pick<Id> (Id a branded number, IR number) gets an instance whose R<T> isn't
// Box<string> (the reproducer suspects instantiate's unbranded, generics.go, which makes the
// instance's type argument number), so the call's Box<string> was PTS1001 `using a Box as a Box`;
// plain code's R<Id> is Box<string>.
class Box<T> {
  constructor(public value: T) {}
}
type Id = number & { readonly __brand: "id" };
type R<T> = Box<T extends Id ? string : number>;
const plain: R<Id> = new Box("s");
console.log("plain", plain.value + "!");
function pick<T>(x: T, v: R<T>): R<T> {
  return v;
}
const r = pick<Id>(5 as Id, new Box("s"));
console.log("instance", r.value + "!");
// expect:
// plain s!
// instance s!
