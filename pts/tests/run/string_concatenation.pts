// + with a string converts the other side with ToString.
const name = "Ada";
const age = 36;
console.log("name: " + name + ", age: " + age);
console.log(1 + 2 + "3", "1" + 2 + 3, "x" + 0.1 * 3, "big " + 1e21 + " small " + 1e-7);
console.log("" + true + false, "" + null + undefined, "nan " + NaN + " inf " + -Infinity, "zero " + -0);
const greeting = "Hello" + ", " + "world";
console.log(greeting);

// expect:
// name: Ada, age: 36
// 33 123 x0.30000000000000004 big 1e+21 small 1e-7
// truefalse nullundefined nan NaN inf -Infinity zero 0
// Hello, world
