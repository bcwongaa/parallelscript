// JSON.parse (D-080): objects become hash-map objects of `any` (keys in JS's order:
// array indices first), arrays `any[]`, and the rest numbers, strings, booleans and null;
// malformed text throws V8's SyntaxError, positions in UTF-16 code units.
const data = JSON.parse('{"name": "ann", "tags": ["a", "b"], "n": 1.5e3, "ok": true, "none": null, "nested": {"x": [1, {"y": -0}]}}');
console.log(data);
console.log(data.name.toUpperCase(), data.tags.length, data.n + 1, data.nested.x[1].y, 1 / data.nested.x[1].y);
const typed: { name: string; tags: string[] } = data;
console.log(typed.name, typed.tags);
const r: Record<string, any> = JSON.parse('{"b": 1, "2": 2, "1": 3, "a": {"c": [true]}, "b": 4}');
console.log(r, Object.keys(r));
console.log(JSON.parse('"\\ud83d\\ude00 \\u00e9\\n\\t\\"\\\\\\/"'), JSON.parse("[]"), JSON.parse("{}"), JSON.parse(" 42 "));
console.log(JSON.parse("[1e999, -0, 0.1, 123456789012345678901234567890, 5e-324, 1E2, -12.5e-1]"));
console.log(JSON.parse('{"__proto__": 1, "constructor": 2}'), JSON.parse('"\\ud800"').length);
const items: { id: number; label: string }[] = JSON.parse('[{"id": 1, "label": "one"}, {"id": 2, "label": "two"}]');
console.log(items.map((item) => item.id * 10), items[1].label);

const cases = [
  "", " ", "x", "abc", "[1, b]", "{", '{"a"', '{"a":', '{"a":1', '{"a":1,}', "{a:1}", "[1,]", "[1 2]", '{"a" 1}', '"abc',
  '"a\u0001b"', '"\\x"', '"\\u12G4"', '"\\u12', "1e", "1e+", "-", "-x", "1.", "1.e3", "01", "-01", "1 2", "tru", "nul", "nope",
  "true false", "[", "[1", '{"a":1}}', '  {"a": [1, {"b": nope}]}  ',
  '["a long string that goes on and on and on", unexpected, "and more text after it to make it long"]',
  "[bad, and a long tail after it ......]", "[1, 2, 3, 4, 5, 6, 7, 8, 9, x]", "\n\n  [1,\n  x]", "1\n2",
  "  1", "NaN", "Infinity", "undefined", "[object Object]", '["é", x, "long enough to need context"]',
];
for (const text of cases) {
  try {
    console.log(JSON.stringify(text), "=>", JSON.parse(text));
  } catch (e) {
    console.log(JSON.stringify(text), "=>", (e as Error).name + ": " + (e as Error).message);
  }
}
