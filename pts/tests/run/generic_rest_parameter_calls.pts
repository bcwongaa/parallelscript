// Typed calls of generic functions and methods with a rest parameter typed with their type
// parameters (`<T>(...xs: T[]) => Box<T[]>`) find their instances (H09b3a, C170): a generic
// function value, one with a parameter before the rest, with no rest arguments, through `?.`,
// an interface's method of a class and of an object literal, an object literal's method
// through its own type, a dispatched method and a union of object types' method; for number,
// string and class elements and a promise result, and elements of a union of object types
// typed with the type parameters (`...xs: Opt<T>[]`, object literals or variables, whose
// erased copy takes `Opt<any>`s, not dynamic values). D-148's demands
// left out rest parameters, so each took the erased copy and threw
// `TypeError: Expected Box<number[]>, got Box<any[]>`. Direct calls of generic declarations,
// methods and module-scope generic consts with rest parameters, and a call whose arguments are
// `any`, worked and must keep working; each argument is evaluated once, in order.
class Box<T> {
  constructor(public value: T) {}
}
class Point {
  constructor(public x: number) {}
}
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}
function pick<X>(flag: boolean, x: X): X | undefined {
  return flag ? x : undefined;
}
function many<T>(...xs: T[]): Box<T[]> {
  return new Box(xs);
}
function labelled<T>(label: string, ...xs: T[]): Box<T[]> {
  return new Box(xs.length > 0 ? xs : []);
}
async function later<T>(...xs: T[]): Promise<Box<T[]>> {
  return new Box(xs);
}
interface Many {
  many<T>(...xs: T[]): Box<T[]>;
}
class ClassMany implements Many {
  many<T>(...xs: T[]): Box<T[]> {
    return new Box(xs);
  }
}
abstract class Base {
  abstract many<T>(...xs: T[]): Box<T[]>;
}
class Impl extends Base {
  many<T>(...xs: T[]): Box<T[]> {
    return new Box(xs);
  }
}
const literal = {
  many<T>(...xs: T[]): Box<T[]> {
    return new Box(xs);
  },
};
type A = { kind: "a"; many<T>(...xs: T[]): Box<T[]> };
type B = { kind: "b"; many<T>(...xs: T[]): Box<T[]> };
const arrow = <T,>(...xs: T[]): Box<T[]> => new Box(xs);

const value: <T>(...xs: T[]) => Box<T[]> = many;
const withLabel: <T>(label: string, ...xs: T[]) => Box<T[]> = labelled;
const promised: <T>(...xs: T[]) => Promise<Box<T[]>> = later;
const maybe: (<T>(...xs: T[]) => Box<T[]>) | undefined = pick(true, many);
const viaInterface: Many = new ClassMany();
const literalMany: Many = {
  many<T>(...xs: T[]): Box<T[]> {
    return new Box(xs);
  },
};
const dispatched: Base = new Impl();
const union: A | B = {
  kind: "a",
  many<T>(...xs: T[]): Box<T[]> {
    return new Box(xs);
  },
};
const numbers = [4, 5, 6];

attempt("value", () => {
  const b: Box<number[]> = value(1, 2);
  const s: Box<string[]> = value("a", "bc");
  return `${b.value.length + b.value[0]} ${s.value[1].length}`;
});
attempt("a parameter before the rest", () => {
  const b: Box<Point[]> = withLabel("points", new Point(3));
  return String(b.value[0].x + 1);
});
attempt("no rest arguments", () => {
  const b: Box<number[]> = value<number>();
  return String(b.value.length);
});
attempt("optional chain", () => {
  const b: Box<number[]> | undefined = maybe?.(1, 2);
  return String(b!.value.length + b!.value[0]);
});
attempt("interface of a class", () => {
  const b: Box<number[]> = viaInterface.many(1, 2);
  return String(b.value.length + b.value[0]);
});
attempt("interface of a literal", () => {
  const b: Box<string[]> = literalMany.many("a", "bc");
  return String(b.value[1].length);
});
attempt("literal's own type", () => {
  const b: Box<number[]> = literal.many(1, 2);
  return String(b.value.length + b.value[0]);
});
attempt("dispatched method", () => {
  const b: Box<number[]> = dispatched.many(1, 2);
  return String(b.value.length + b.value[0]);
});
attempt("union of object types", () => {
  const b: Box<number[]> = union.many(1, 2);
  return String(b.value.length + b.value[0]);
});

type Opt<T> = { tag: "some"; value: T } | { tag: "none" };
interface Opts {
  opts<T>(...xs: Opt<T>[]): Box<T[]>;
}
function opts<T>(...xs: Opt<T>[]): Box<T[]> {
  const out: T[] = [];
  for (const x of xs) {
    if (x.tag === "some") {
      out.push(x.value);
    }
  }
  return new Box(out);
}
class ClassOpts implements Opts {
  opts<T>(...xs: Opt<T>[]): Box<T[]> {
    return opts(...xs);
  }
}
const viaOpts: Opts = new ClassOpts();
const optsValue: <T>(...xs: Opt<T>[]) => Box<T[]> = opts;
const someTwo: Opt<number> = { tag: "some", value: 2 };
attempt("union elements, literals", () => {
  const b: Box<number[]> = viaOpts.opts({ tag: "some", value: 1 }, { tag: "none" }, { tag: "some", value: 3 });
  return b.value.join(",");
});
attempt("union elements, variables", () => {
  const b: Box<number[]> = viaOpts.opts(someTwo, someTwo);
  return String(b.value[0] + b.value[1]);
});
attempt("union elements, a value call", () => {
  const b: Box<string[]> = optsValue({ tag: "some", value: "ab" }, { tag: "none" });
  return String(b.value[0].length);
});

// Guards: these worked before and must keep working.
const order: string[] = [];
function argument(n: number): number {
  order.push(`argument ${n}`);
  return n;
}
attempt("direct calls", () => {
  const b: Box<number[]> = many(1, 2);
  const c: Box<number[]> = new ClassMany().many(3);
  const d: Box<number[]> = arrow(4, 5);
  const e: Box<number[]> = many(...numbers);
  return `${b.value.length} ${c.value[0]} ${d.value[1]} ${e.value[2]}`;
});
attempt("evaluation order", () => {
  const b = viaInterface.many(argument(1), argument(2), argument(3));
  return `${b.value.join("")} ${order.join(",")}`;
});
attempt("any arguments", () => {
  const loose: any = 7;
  const anys: any[] = [8, 9];
  const b = value(loose, 1);
  const c = value(...anys);
  return `${b.value[0]} ${c.value.length}`;
});
async function main(): Promise<void> {
  try {
    const b: Box<number[]> = await promised(1, 2);
    console.log("promise result", b.value.length + b.value[0]);
  } catch (error: any) {
    console.log("promise result", error.name, error.message);
  }
}
main();

// expect:
// value 3 2
// a parameter before the rest 4
// no rest arguments 0
// optional chain 3
// interface of a class 3
// interface of a literal 2
// literal's own type 3
// dispatched method 3
// union of object types 3
// union elements, literals 1,3
// union elements, variables 4
// union elements, a value call 2
// direct calls 2 3 5 6
// evaluation order 123 argument 1,argument 2,argument 3
// any arguments 7 2
// promise result 3
