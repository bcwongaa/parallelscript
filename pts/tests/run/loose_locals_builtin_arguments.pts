// A loose local given to a builtin goes as tsc's type, which the builtin's lowering reads
// (`n.toFixed(d)`, `new Set(xs)`, `Array.from(xs)`, `concat`): a present value works as
// in JS. The change's first form passed the union to builtins' optional parameters and
// to parameters of any or object types, and these failed to compile (PTS1001, PTS9001 in
// `Object.keys(first)`; H11a review round 1, R1-F2, R1-F3, and the snapshot suite). A
// builtin parameter declared with the builtin's type parameter (`push(...items: T[])`,
// `set(key, value: V)`) takes the union where its type argument holds undefined.
const [value, digits, radix] = "3.14159 2 16".split(" ").map(Number);
console.log(value.toFixed(digits), (255).toString(radix), parseInt("ff", radix));
const rows: string[][] = [["a", "b", "a"], ["c"]];
for (const [first, ...rest] of rows) console.log(first, rest.length);
const [left, right] = rows;
console.log(new Set(left).size, new Set(right).size, new Map([["k", left]]).size);
console.log(Array.from(rows[0]), rows[0].concat(rows[1]));
const records: Record<string, number>[] = [{ a: 1 }];
const record = records[0];
if (record) console.log(Object.keys(record), Object.values(record));
const [, missing] = "a".split(":");
const maybe: (string | undefined)[] = [];
maybe.push(missing);
const map = new Map<string, string | undefined>();
map.set("k", missing);
const set = new Set<unknown>();
set.add(missing);
console.log(maybe, map, set);

// expect:
// 3.14 ff 255
// a 2
// c 0
// 2 1 1
// [ 'a', 'b', 'a' ] [ 'a', 'b', 'a', 'c' ]
// [ 'a' ] [ 1 ]
// [ undefined ] Map(1) { 'k' => undefined } Set(1) { undefined }
