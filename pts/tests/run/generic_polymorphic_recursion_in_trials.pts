// Polymorphic recursion that a call looking up an instance reaches (H09b5, C184, D-198): the
// instance its trial makes (D-190, D-191) recurses by direct calls, so the depth limit is met
// inside the trial. Past it the direct call calls the erased copy and the trial stands, so
// each call runs as Node, and the unrelated interface call keeps its instance. The fix commit
// let the limit's PTS1001 stand there, which sent the whole program to a fallback build where
// these calls threw (review round 1's interface_this_rec, iface_then_direct and
// localarrow_then_direct). generic_polymorphic_recursion_value_and_{declaration,class}.pts
// recurse through values.
class Box<T> {
  constructor(public value: T) {}
}
function attempt(label: string, f: () => number): void {
  try {
    console.log(label, f());
  } catch (error: any) {
    console.log(label, error.name, error.message);
  }
}

interface Maker {
  make<T>(x: T): Box<T>;
}
class ClassMaker implements Maker {
  make<T>(x: T): Box<T> {
    return new Box(x);
  }
}
const maker: Maker = new ClassMaker();
attempt("unrelated interface call", () => maker.make(4).value + 1);

interface Recursive {
  rec<T>(x: T, n: number): Box<T>;
}
class Recurser implements Recursive {
  rec<T>(x: T, n: number): Box<T> {
    if (n > 0) {
      const inner: Box<T[]> = this.rec([x], n - 1);
      return new Box(inner.value[0]);
    }
    return new Box(x);
  }
}
const recursive: Recursive = new Recurser();
attempt("interface, then direct calls", () => recursive.rec(5, 3).value + 1);

function rec<T>(x: T, n: number): Box<T> {
  if (n > 0) {
    const inner: Box<T[]> = rec([x], n - 1);
    return new Box(inner.value[0]);
  }
  return new Box(x);
}
function local(): number {
  const viaArrow = <T,>(x: T, n: number): Box<T> => rec(x, n);
  const b: Box<number> = viaArrow(5, 3);
  return b.value + 1;
}
attempt("local arrow, then direct calls", local);

// expect:
// unrelated interface call 5
// interface, then direct calls 6
// local arrow, then direct calls 6
