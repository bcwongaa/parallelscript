// A closure that an erased copy makes for a union member's function-typed property takes
// dynamic values and returns one; typed code that narrows the union and calls it through
// the member's signature passed a double or a string pointer where the closure reads a
// dynamic value, and read its dynamic result as a double or a pointer: SIGSEGV (H09b2, C187).
// The read must give a function of the member's type (an adapter, D-075), as Node calls the
// closure. Honest values; the erased copy comes from an element access (C185).
type Fn<T> = { readonly tag: "some"; readonly value: (y: T) => T } | { readonly tag: "none" };
const Ops = {
  twice<T>(x: T): Fn<T> {
    return { tag: "some", value: (y: T) => (typeof y === "number" ? (y as any) * 2 : (y as any) + (y as any)) };
  },
};
function attempt(label: string, f: () => string): void {
  try {
    console.log(label, f());
  } catch (e: any) {
    console.log(label, e.name, e.message);
  }
}
attempt("a closure taking a number", () => {
  const o: Fn<number> = Ops["twice"](0);
  return o.tag === "some" ? String(o.value(7) + 1) : "none";
});
attempt("a closure taking a string", () => {
  const o: Fn<string> = Ops["twice"]("");
  return o.tag === "some" ? o.value("ab").toUpperCase() : "none";
});

// expect:
// a closure taking a number 15
// a closure taking a string ABAB
