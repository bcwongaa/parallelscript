// Arrays of the integer types and f32 (D-048): elements are stored unboxed, literals and
// method arguments take the element type, callbacks get it, arithmetic on it keeps it
// (and wraps), and console.log prints every digit.
const bytes: u8[] = [1, 2, 255];
bytes.push(7);
bytes[0] = 254;
console.log(bytes, bytes.length, bytes[3], bytes[9]);
let sum: int = 0;
for (const b of bytes) {
  sum += b;
}
console.log(sum);
const doubled = bytes.map(b => b * 2);
const firstDoubled: u8 = doubled[0];
console.log(doubled, firstDoubled);
console.log(bytes.reduce((a, b) => a + b), bytes.reduce<int>((a, b) => a + b, 0));

const xs: Array<i32> = [10, 9, -3, 100, 2];
console.log(xs.indexOf(9), xs.includes(100), xs.join("-"), xs.slice(1, 3), xs.concat([7], xs.slice(4)));
const sorted = xs.slice();
console.log(sorted.sort(), sorted.sort((a, b) => a - b), xs.filter(x => x > 5).reverse());
console.log(xs.find(x => x > 50), xs.findIndex(x => x === -3), xs.some(x => x < 0), xs.every(x => x < 1000));
console.log(xs.flatMap(x => [x, -x]).length, Array.from(xs, x => x / 4), new Set(xs).has(-3));
xs.forEach((x, i) => {
  if (i < 2) console.log(i, x);
});

const big: int[] = [9007199254740993, -9223372036854775807 - 1];
console.log(big, big.map(x => x + 1), big.pop()!, big);
const huge: readonly u64[] = [18446744073709551615, 0];
console.log(huge, huge[0] + 1, huge[1] - 1);
const halves: f32[] = [0.1, 0.25];
console.log(halves, halves.map(x => x * 2));
const grid: i8[][] = [[1, -2], [3]];
grid[1].push(-128);
console.log(grid, grid.flat(), grid[1][1] - 1);
const shorts: u16[] = [1, 2, 3];
console.log(shorts.pop(), shorts.shift(), shorts.unshift(65535), shorts);

// expect:
// [ 254, 2, 255, 7 ] 4 7 undefined
// 518
// [ 252, 4, 254, 14 ] 252
// 6 518
// 1 true 10-9--3-100-2 [ 9, -3 ] [
//   10, 9, -3, 100,
//    2, 7,  2
// ]
// [ -3, 2, 9, 10, 100 ] [ -3, 2, 9, 10, 100 ] [ 100, 9, 10 ]
// 100 2 true true
// 10 [ 2, 2, 0, 25, 0 ] true
// 0 10
// 1 9
// [ 9007199254740993 ] [ 9007199254740994, -9223372036854775807 ] -9223372036854775808 [ 9007199254740993 ]
// [ 18446744073709551615, 0 ] 0 18446744073709551615
// [ 0.10000000149011612, 0.25 ] [ 0.20000000298023224, 0.5 ]
// [ [ 1, -2 ], [ 3, -128 ] ] [ 1, -2, 3, -128 ] 127
// 3 1 2 [ 65535, 2 ]
