// H09b5d review round 2 (c12), a guard: the base ran it as Node does; lowered splitting classes it didn't,
// so a build splits them only where it doesn't lower otherwise (D-216).
// c01 with two split instances: Task<Promise<number>> and Task<Promise<string>> don't share
// (number and string don't convert), and Task<unknown> shares only the first, so widening
// the second to Task<unknown>, which TypeScript allows, has no class to convert to.
class Task<T> {
  result: Awaited<T> | undefined = undefined;
  constructor(public p: T) {}
}
function wide(t: Task<unknown>): string {
  return "wide " + (t.p instanceof Promise) + " " + String(t.result);
}
const n = new Task(Promise.resolve(1));
const s = new Task(Promise.resolve("s"));
console.log(wide(n), wide(s), wide(new Task<unknown>(3)));
// expect:
// wide true undefined wide true undefined wide false undefined
