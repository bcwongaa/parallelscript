// console.table as Node draws it (D-088): a row per key of the data, a column per property
// of the rows (array indices first), a "Values" column for rows that are primitives.
class Person { constructor(public name: string, public age: number) {} }
console.table([{ a: 1, b: "x" }, { a: 2, c: true }]);
console.table([new Person("Ada", 36), new Person("Linus", 54)]);
console.table([1, "two", null, undefined, { a: 1 }]);
console.table([[1, 2], [3, 4, 5]]);
console.table({ first: { x: 1 }, second: { y: 2 } });
console.table(new Map<string, number>([["a", 1], ["b", 2]]));
console.table(new Set(["x", "y"]));
console.table([{ name: "日本語", v: [1, 2, 3, 4, 5] }, { name: "😀", v: { deep: { deeper: 1 }, k: 2, j: 3 } }]);
console.table([{ a: 1, b: 2, c: 3 }], ["a", "c"]);
console.table([1, 2], ["a"]);
console.table([]);
console.table({});
console.table("not tabular");
console.table(42);
const rec: Record<string, number> = { x: 1, y: 2 };
console.table(rec);
console.table([{ d: new Date(0), m: new Map([[1, 2]]), s: "quote's" }]);
console.group("in a group");
console.table([{ a: 1 }]);
console.groupEnd();
const tuples: [string, number][] = [["a", 1], ["b", 2]];
console.table(tuples);
console.table([{ k: [1, [2, [3]]], o: { p: { q: 1 } } }]);
const numbered: Record<string, number> = {};
numbered["2"] = 2;
numbered["10"] = 10;
const lettered: Record<string, number> = { z: 1 };
console.table([lettered, numbered]);

// expect:
// ┌─────────┬───┬─────┬──────┐
// │ (index) │ a │ b   │ c    │
// ├─────────┼───┼─────┼──────┤
// │ 0       │ 1 │ 'x' │      │
// │ 1       │ 2 │     │ true │
// └─────────┴───┴─────┴──────┘
// ┌─────────┬─────────┬─────┐
// │ (index) │ name    │ age │
// ├─────────┼─────────┼─────┤
// │ 0       │ 'Ada'   │ 36  │
// │ 1       │ 'Linus' │ 54  │
// └─────────┴─────────┴─────┘
// ┌─────────┬───┬───────────┐
// │ (index) │ a │ Values    │
// ├─────────┼───┼───────────┤
// │ 0       │   │ 1         │
// │ 1       │   │ 'two'     │
// │ 2       │   │ null      │
// │ 3       │   │ undefined │
// │ 4       │ 1 │           │
// └─────────┴───┴───────────┘
// ┌─────────┬───┬───┬───┐
// │ (index) │ 0 │ 1 │ 2 │
// ├─────────┼───┼───┼───┤
// │ 0       │ 1 │ 2 │   │
// │ 1       │ 3 │ 4 │ 5 │
// └─────────┴───┴───┴───┘
// ┌─────────┬───┬───┐
// │ (index) │ x │ y │
// ├─────────┼───┼───┤
// │ first   │ 1 │   │
// │ second  │   │ 2 │
// └─────────┴───┴───┘
// ┌───────────────────┬─────┬────────┐
// │ (iteration index) │ Key │ Values │
// ├───────────────────┼─────┼────────┤
// │ 0                 │ 'a' │ 1      │
// │ 1                 │ 'b' │ 2      │
// └───────────────────┴─────┴────────┘
// ┌───────────────────┬────────┐
// │ (iteration index) │ Values │
// ├───────────────────┼────────┤
// │ 0                 │ 'x'    │
// │ 1                 │ 'y'    │
// └───────────────────┴────────┘
// ┌─────────┬──────────┬───────────────────────────────┐
// │ (index) │ name     │ v                             │
// ├─────────┼──────────┼───────────────────────────────┤
// │ 0       │ '日本語' │ [ 1, 2, 3, ... 2 more items ] │
// │ 1       │ '😀'     │ [Object]                      │
// └─────────┴──────────┴───────────────────────────────┘
// ┌─────────┬───┬───┐
// │ (index) │ a │ c │
// ├─────────┼───┼───┤
// │ 0       │ 1 │ 3 │
// └─────────┴───┴───┘
// ┌─────────┬───┐
// │ (index) │ a │
// ├─────────┼───┤
// │ 0       │   │
// │ 1       │   │
// └─────────┴───┘
// ┌─────────┐
// │ (index) │
// ├─────────┤
// └─────────┘
// ┌─────────┐
// │ (index) │
// ├─────────┤
// └─────────┘
// not tabular
// 42
// ┌─────────┬────────┐
// │ (index) │ Values │
// ├─────────┼────────┤
// │ x       │ 1      │
// │ y       │ 2      │
// └─────────┴────────┘
// ┌─────────┬──────────────────────────┬───────────────────┬───────────┐
// │ (index) │ d                        │ m                 │ s         │
// ├─────────┼──────────────────────────┼───────────────────┼───────────┤
// │ 0       │ 1970-01-01T00:00:00.000Z │ Map(1) { 1 => 2 } │ "quote's" │
// └─────────┴──────────────────────────┴───────────────────┴───────────┘
// in a group
//   ┌─────────┬───┐
//   │ (index) │ a │
//   ├─────────┼───┤
//   │ 0       │ 1 │
//   └─────────┴───┘
// ┌─────────┬─────┬───┐
// │ (index) │ 0   │ 1 │
// ├─────────┼─────┼───┤
// │ 0       │ 'a' │ 1 │
// │ 1       │ 'b' │ 2 │
// └─────────┴─────┴───┘
// ┌─────────┬────────────────┬─────────────────┐
// │ (index) │ k              │ o               │
// ├─────────┼────────────────┼─────────────────┤
// │ 0       │ [ 1, [Array] ] │ { p: [Object] } │
// └─────────┴────────────────┴─────────────────┘
// ┌─────────┬───┬────┬───┐
// │ (index) │ 2 │ 10 │ z │
// ├─────────┼───┼────┼───┤
// │ 0       │   │    │ 1 │
// │ 1       │ 2 │ 10 │   │
// └─────────┴───┴────┴───┘
