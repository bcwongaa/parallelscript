// Instances are told apart by IR types (a function's also by literal type arguments), so
// type arguments of one IR type run the same instance: a branded string and unknown (IR
// value), "a" and string for a class, two object types that differ only in a literal
// property's type, `() => 1` and `() => number`, a recursive union (IR value) and unknown,
// also inside a function's result, a property or a class's type argument (review rounds 1
// and 2, F2, R2-F2). Deciding this asks no IR types of a type argument's parts: a phantom
// type argument's (`Tagged<Weird<string>>`) would make a class instance whose code doesn't
// lower (round 3, R3-F1); a union that recurs through an index signature is dynamic too
// (round 4, R4-F1).
// Code is dead in an instance only if it is for
// every type argument that may run it (D-195): each branch below is dead for the first
// call's type argument and live for the second's, and runs as in Node.
type Id = string & { __brand: "id" };
interface Add {
  type: "add";
  value: number;
}
interface Sub {
  type: "sub";
  value: number;
}
class Holder<T> {
  constructor(public value: T) {}
  describe(): string {
    const v = this.value;
    if (typeof v === "number") {
      return "number " + (v + 1);
    }
    return "other " + String(v);
  }
  isB(): string {
    const v = this.value;
    if (v === "b") {
      return "is b";
    }
    return "not b";
  }
}
function numbers<T>(x: T): string {
  if (typeof x === "number") {
    return "number " + (x + 1);
  }
  return "other " + String(x);
}
function kind<T extends { type: string }>(a: T): string {
  if (a.type === "add") {
    const t: "add" = a.type;
    return "adds " + t;
  }
  return "other " + a.type;
}
console.log(new Holder<Id>("id1" as Id).describe(), new Holder<unknown>(5).describe());
console.log(new Holder<"a">("a").isB(), new Holder<string>("b").isB());
console.log(numbers<Id>("id2" as Id), numbers<unknown>(6));
const sub: Sub = { type: "sub", value: 1 };
const add: Add = { type: "add", value: 2 };
console.log(kind<Sub>(sub), kind<Add>(add));
function isTwo(v: unknown): v is 2 {
  return v === 2;
}
function run<F extends () => number>(f: F): string {
  const r: ReturnType<F> = f() as ReturnType<F>;
  if (isTwo(r)) {
    const k: number = r + 10;
    return "two " + k;
  }
  return "not two";
}
class Caller<F extends () => number> {
  constructor(public f: F) {}
  check(): string {
    const r = this.f() as ReturnType<F>;
    if (isTwo(r)) {
      const k: number = r * 10;
      return "two " + k;
    }
    return "not two";
  }
}
const one = (): 1 => 1;
console.log(run(one), run((): number => 2));
console.log(new Caller(one).check(), new Caller((): number => 2).check());
type Json = string | number | null | Json[] | { [k: string]: Json };
function undefinedOrNot<T>(x: T): string {
  if (typeof x === "undefined") {
    const u: undefined = x;
    return "undefined " + (u === undefined);
  }
  return "other";
}
const parsed: Json = JSON.parse("1") as Json;
console.log(undefinedOrNot<Json>(parsed), undefinedOrNot<unknown>(undefined));
function isUndef(v: unknown): v is undefined {
  return v === undefined;
}
function runUnknown<F extends () => unknown>(f: F): string {
  const r = f() as ReturnType<F>;
  if (isUndef(r)) {
    const k = r;
    return "undefined " + (k === undefined);
  }
  return "defined";
}
function isUnset(o: unknown): o is { v: undefined } {
  return typeof o === "object" && o !== null && (o as { v?: unknown }).v === undefined;
}
function check<T>(x: T): string {
  if (isUnset(x)) {
    const y = x;
    return "unset " + typeof y;
  }
  return "set";
}
class Box<T> {
  constructor(public value: T) {}
}
function holdsUndefined(b: unknown): b is Box<undefined> {
  return b instanceof Box && b.value === undefined;
}
class Boxes<T> {
  constructor(public item: T) {}
  describe(): string {
    const it = this.item;
    if (holdsUndefined(it)) {
      const b = it;
      return "empty box " + typeof b;
    }
    return "full";
  }
}
const json = (): Json => 1;
console.log(runUnknown(json), runUnknown((): unknown => undefined));
const withJson: { v: Json } = { v: 1 };
console.log(check<{ v: Json }>(withJson), check<{ v: unknown }>({ v: undefined }));
console.log(new Boxes<Box<Json>>(new Box<Json>(1)).describe(), new Boxes<Box<unknown>>(new Box<unknown>(undefined)).describe());
class Weird<T> {
  constructor(public value: T) {}
  isOne(): boolean {
    return this.value == 1;
  }
}
interface Tagged<Tag> {
  v: number;
}
function numberOrNot<T>(x: T): string {
  if (typeof x === "number") {
    return "number";
  }
  return "other";
}
const tagged: Tagged<Weird<string>> = { v: 1 };
console.log(numberOrNot(tagged), numberOrNot(2), new Weird(1).isOne());
type Hashed = string | number | { [k: string]: Hashed };
function checkHashed<T>(x: T): string {
  if (isUnset(x)) {
    const y = x;
    return "unset " + typeof y;
  }
  return "set";
}
const hashed: { v: Hashed } = { v: 1 };
console.log(checkHashed<{ v: Hashed }>(hashed), checkHashed<{ v: unknown }>({ v: undefined }));

// expect:
// other id1 number 6
// not b is b
// other id2 number 7
// other sub adds add
// not two two 12
// not two two 20
// other undefined true
// defined undefined true
// set unset object
// full empty box object
// other number true
// set unset object
