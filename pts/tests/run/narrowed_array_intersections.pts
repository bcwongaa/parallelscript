// An honest `v is string[]` predicate on a T of an array type narrows x to `T & string[]`,
// which for T = `(string | number)[]` is a string[] (as tsc narrows it in plain code) and
// for T = `number[]` is `number[] & string[]`, an intersection no IR type holds that an
// array of no elements has: there x is read dynamically (C227, H09b4a review round 2's
// i01), as a plain number[] is that the predicate narrows the same way. Each was PTS1001
// (`` `x.length` is not supported yet ``, `calling `x.join``), and taking `number[] &
// string[]` as a number[] read `x[0].length` from a double (PTS9001); `for…of` over the
// dynamic one was PTS1001 (`converting number to string`, H09b4b1 review round 1's a06),
// and so was an optional chain on its element (`converting undefined to string`, round 2's
// a10).
// (`array_type_intersections.pts` has the reads' other forms; iterating a mixed array
// narrowed to string[] is C228's: `narrowed_array_aliases.pts`.)
function isStrings(v: unknown): v is string[] {
  return Array.isArray(v) && v.every((e) => typeof e === "string");
}
function takes(xs: string[]): number {
  return xs.length;
}
function iterate<T>(x: T): string {
  if (isStrings(x)) {
    let out = "n=" + x.length;
    for (const s of x) out += " " + s.toUpperCase();
    const copy = [...x];
    const [first] = x;
    return out + " copy " + copy.length + " first " + first;
  }
  return "other";
}
console.log(iterate<number[]>([]), iterate<number[]>([1]), iterate<string[]>(["ab", "c"]));
function grow<T>(x: T): string {
  if (isStrings(x)) {
    const upper = x.length > 0 ? x[0].toUpperCase() : "-";
    x.push("z");
    return upper + " " + x.length + " " + takes(x) + " " + x.join("");
  }
  return "other";
}
const words: (string | number)[] = ["ab"];
console.log(grow(words), words, grow([1]));
function plain(ns: number[]): string {
  if (isStrings(ns)) {
    return "plain strings " + ns.length + " " + ns.join("-") + " " + ns.indexOf("a") + " " + ns.slice(0).length;
  }
  return "plain other";
}
console.log(plain([]), plain([1, 2]));
function first<T>(x: T): string {
  if (isStrings(x)) {
    return "first " + (x[0]?.toUpperCase() ?? "none");
  }
  return "other";
}
console.log(first<number[]>([]), first<string[]>(["a"]), first<string[]>([]));

// expect:
// n=0 copy 0 first undefined other n=2 AB C copy 2 first ab
// AB 2 2 abz [ 'ab', 'z' ] other
// plain strings 0  -1 0 plain other
// first none first A first none
