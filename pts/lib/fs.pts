// pts:fs: Node's fs module (D-117). The synchronous functions run libuv's synchronous
// calls, as Node's do, and throw Node's errors: an Error with errno, code, syscall, path
// and dest, its message "ENOENT: no such file or directory, open 'x'". Files are read as
// text with an encoding (UTF-8) and as bytes without one, a Uint8Array where Node gives a
// Buffer (D-165); text or a Uint8Array is written. The promise API is pts:fs/promises,
// also this module's `promises` (D-118).

import { join, relative, resolve } from "pts:path";
import promisesObject from "pts:fs/promises";
import {
    constants, Dirent, direntTypeOf, F_OK, isDirectoryMode, mkdirOptions, R_OK, readdirOptions, readFlags, readsText, S_IFLNK, S_IFMT, Stats,
    symlinkFlags, UV_DIRENT_DIR, UV_DIRENT_UNKNOWN, UV_EACCES, UV_EEXIST, UV_ENOENT, UV_ENOSPC, UV_ENOTDIR, UV_EPERM, W_OK, writeOptions, X_OK,
} from "pts:internal/fs";
import type {
    Buffer, BufferEncoding, MakeDirectoryOptions, PathLike, ReaddirOptions, ReadFileBufferOptions, ReadFileOptions, RmOptions, StatSyncOptions,
    WriteFileOptions,
} from "pts:internal/fs";

export { constants, Dirent, Stats } from "pts:internal/fs";
export type {
    Buffer, BufferEncoding, MakeDirectoryOptions, PathLike, ReaddirOptions, ReadFileBufferOptions, ReadFileOptions, RmOptions, StatSyncOptions,
    WriteFileOptions,
} from "pts:internal/fs";
export { default as promises } from "pts:fs/promises";

declare function pts_fs_read_file(path: string, flags: number): string;
declare function pts_fs_read_file_bytes(path: string, flags: number): Uint8Array;
declare function pts_fs_write_file(path: string, data: string, flags: number, mode: number): void;
declare function pts_fs_write_file_bytes(path: string, data: Uint8Array, flags: number, mode: number): void;
declare function pts_fs_access(path: string, mode: number): number;
declare function pts_fs_stat(path: string, follow: boolean, stats: number[]): number;
declare function pts_fs_mkdir(path: string, mode: number): number;
declare function pts_fs_scandir(path: string, types: number[]): string[];
declare function pts_fs_unlink(path: string): number;
declare function pts_fs_rmdir(path: string): number;
declare function pts_fs_rename(from: string, to: string): number;
declare function pts_fs_copy_file(source: string, destination: string, mode: number): number;
declare function pts_fs_symlink(target: string, path: string, flags: number): number;
declare function pts_fs_chmod(path: string, mode: number): number;
declare function pts_fs_readlink(path: string): string;
declare function pts_fs_mkdtemp(prefix: string): string;
declare function pts_fs_error(error: number, syscall: string, path: string, dest: string): Error;
declare function pts_fs_rm_directory_error(path: string): Error;
// Orders what this thread stored before it before what it stores after (D-226): a builder
// publishes the object it made and filled before handing it out.
declare function pts_publish(): void;

// Throws Node's error for a call that returned error (a negative errno).
function check(error: number, syscall: string, path: string, dest: string = ""): void {
    if (error < 0) {
        throw pts_fs_error(error, syscall, path, dest);
    }
}

// Node's getDirent: an entry whose type the directory didn't tell is lstat'ed.
function direntOf(parentPath: string, name: string, type: number): Dirent {
    if (type === UV_DIRENT_UNKNOWN) {
        const stats: number[] = [];
        const path = join(parentPath, name);
        check(pts_fs_stat(path, false, stats), "lstat", path);
        type = direntTypeOf(stats[1]);
    }
    return new Dirent(name, type, parentPath);
}

// ---------------------------------------------------------------- reading and writing

export function readFileSync(path: PathLike, options?: ReadFileBufferOptions | null): Buffer;
export function readFileSync(path: PathLike, options: BufferEncoding | ReadFileOptions): string;
export function readFileSync(path: PathLike, options?: BufferEncoding | ReadFileOptions | ReadFileBufferOptions | null): string | Buffer {
    if (readsText(options)) {
        return pts_fs_read_file(path, readFlags(options));
    }
    return pts_fs_read_file_bytes(path, readFlags(options));
}

export function writeFileSync(file: PathLike, data: string | Uint8Array, options?: BufferEncoding | WriteFileOptions | null): void {
    writeSync(file, data, writeOptions(options, "w"));
}

export function appendFileSync(path: PathLike, data: string | Uint8Array, options?: BufferEncoding | WriteFileOptions | null): void {
    writeSync(path, data, writeOptions(options, "a"));
}

function writeSync(path: PathLike, data: string | Uint8Array, [flags, mode]: [number, number]): void {
    if (typeof data === "string") {
        pts_fs_write_file(path, data, flags, mode);
    } else {
        pts_fs_write_file_bytes(path, data, flags, mode);
    }
}

// ---------------------------------------------------------------- files and directories

export function existsSync(path: PathLike): boolean {
    return pts_fs_access(path, F_OK) === 0;
}

export function accessSync(path: PathLike, mode: number = F_OK): void {
    check(pts_fs_access(path, mode), "access", path);
}

function statWith(path: PathLike, follow: boolean, options: StatSyncOptions | undefined): Stats | undefined {
    const values: number[] = [];
    const error = pts_fs_stat(path, follow, values);
    if ((error === UV_ENOENT || error === UV_ENOTDIR) && options !== undefined && options.throwIfNoEntry === false) {
        return undefined;
    }
    check(error, follow ? "stat" : "lstat", path);
    return new Stats(values);
}

export function statSync(path: PathLike, options: { bigint?: false; throwIfNoEntry: false }): Stats | undefined;
export function statSync(path: PathLike, options?: StatSyncOptions): Stats;
export function statSync(path: PathLike, options?: StatSyncOptions): Stats | undefined {
    return statWith(path, true, options);
}

export function lstatSync(path: PathLike, options: { bigint?: false; throwIfNoEntry: false }): Stats | undefined;
export function lstatSync(path: PathLike, options?: StatSyncOptions): Stats;
export function lstatSync(path: PathLike, options?: StatSyncOptions): Stats | undefined {
    return statWith(path, false, options);
}

// Node's MKDirpSync: makes path and the directories missing above it; the first it made.
function makeDirectories(path: string, mode: number): string | undefined {
    const paths = [path];
    let first: string | undefined = undefined;
    while (paths.length > 0) {
        const next = paths.pop() as string;
        let error = pts_fs_mkdir(next, mode);
        if (error === 0) {
            first ??= next;
            continue;
        }
        if (error === UV_EACCES || error === UV_ENOSPC || error === UV_ENOTDIR || error === UV_EPERM) {
            throw pts_fs_error(error, "mkdir", path, "");
        }
        if (error === UV_ENOENT) {
            const slash = next.lastIndexOf("/");
            const dirname = slash < 0 ? next : next.slice(0, slash);
            if (dirname !== next) {
                paths.push(next, dirname);
                continue;
            } else if (paths.length > 0) {
                continue;
            }
            error = UV_EEXIST;
        }
        const values: number[] = [];
        const statError = pts_fs_stat(next, true, values);
        if (statError === 0 && !isDirectoryMode(values[1])) {
            throw pts_fs_error(error === UV_EEXIST && paths.length > 0 ? UV_ENOTDIR : UV_EEXIST, "mkdir", path, "");
        }
        check(statError, "mkdir", path);
    }
    return first;
}

export function mkdirSync(path: PathLike, options?: number | MakeDirectoryOptions): string | undefined {
    const [mode, recursive] = mkdirOptions(options);
    if (recursive) {
        return makeDirectories(path, mode);
    }
    check(pts_fs_mkdir(path, mode), "mkdir", path);
    return undefined;
}

// Node's readdirSyncRecursive: the entries of base and of every directory below it,
// breadth first.
function readTree(base: string, withFileTypes: boolean): string[] | Dirent[] {
    const queue = [base];
    const names: string[] = [];
    const dirents: Dirent[] = [];
    for (let i = 0; i < queue.length; i++) {
        const current = queue[i];
        const types: number[] = [];
        const entries = pts_fs_scandir(current, types);
        for (let j = 0; j < entries.length; j++) {
            const full = join(current, entries[j]);
            const stats: number[] = [];
            const isDirectory = pts_fs_stat(full, true, stats) === 0 && isDirectoryMode(stats[1]);
            if (withFileTypes) {
                const dirent = direntOf(current, entries[j], types[j]);
                dirents.push(dirent);
                if (dirent.isDirectory() || isDirectory) {
                    queue.push(full);
                }
            } else {
                names.push(relative(base, full));
                if (isDirectory) {
                    queue.push(full);
                }
            }
        }
    }
    pts_publish();
    return withFileTypes ? dirents : names;
}

export function readdirSync(path: PathLike, options: { encoding?: BufferEncoding | null; withFileTypes: true; recursive?: boolean }): Dirent[];
export function readdirSync(path: PathLike, options?: BufferEncoding | { encoding?: BufferEncoding | null; withFileTypes?: false; recursive?: boolean } | null): string[];
export function readdirSync(path: PathLike, options?: BufferEncoding | ReaddirOptions | null): string[] | Dirent[] {
    return readdirWith(path, options);
}

function readdirWith(path: PathLike, options: BufferEncoding | ReaddirOptions | null | undefined): string[] | Dirent[] {
    const [withFileTypes, recursive] = readdirOptions(options);
    if (recursive) {
        return readTree(path, withFileTypes);
    }
    const types: number[] = [];
    const names = pts_fs_scandir(path, types);
    if (!withFileTypes) {
        return names;
    }
    return names.map((name, i) => direntOf(path, name, types[i]));
}

export function unlinkSync(path: PathLike): void {
    check(pts_fs_unlink(path), "unlink", path);
}

export function rmdirSync(path: PathLike): void {
    check(pts_fs_rmdir(path), "rmdir", path);
}

// Removes the directory path and everything in it.
function removeTree(path: string): void {
    const types: number[] = [];
    const names = pts_fs_scandir(path, types);
    for (let i = 0; i < names.length; i++) {
        const child = join(path, names[i]);
        let type = types[i];
        if (type === UV_DIRENT_UNKNOWN) {
            const stats: number[] = [];
            check(pts_fs_stat(child, false, stats), "rm", child);
            type = direntTypeOf(stats[1]);
        }
        if (type === UV_DIRENT_DIR) {
            removeTree(child);
        } else {
            check(pts_fs_unlink(child), "rm", child);
        }
    }
    check(pts_fs_rmdir(path), "rm", path);
}

export function rmSync(path: PathLike, options?: RmOptions): void {
    const stats: number[] = [];
    const error = pts_fs_stat(path, false, stats);
    if (error === UV_ENOENT && options?.force === true) {
        return;
    }
    check(error, "lstat", path);
    if (!isDirectoryMode(stats[1])) {
        check(pts_fs_unlink(path), "rm", path);
    } else if (options?.recursive === true) {
        removeTree(path);
    } else {
        throw pts_fs_rm_directory_error(path);
    }
}

export function renameSync(oldPath: PathLike, newPath: PathLike): void {
    check(pts_fs_rename(oldPath, newPath), "rename", oldPath, newPath);
}

export function copyFileSync(src: PathLike, dest: PathLike, mode: number = 0): void {
    check(pts_fs_copy_file(src, dest, mode), "copyfile", src, dest);
}

export function symlinkSync(target: PathLike, path: PathLike, type?: "file" | "dir" | "junction" | null): void {
    check(pts_fs_symlink(target, path, symlinkFlags(type)), "symlink", target, path);
}

export function readlinkSync(path: PathLike): string {
    return pts_fs_readlink(path);
}

export function chmodSync(path: PathLike, mode: number): void {
    check(pts_fs_chmod(path, mode), "chmod", path);
}

export function mkdtempSync(prefix: string): string {
    return pts_fs_mkdtemp(prefix);
}

// Node's realpathSync: the path resolved, each link along it replaced by its target,
// with Node's errors (lstat of the first part that is missing, stat of a broken link).
export function realpathSync(path: PathLike): string {
    let p = resolve(path);
    const seenLinks = new Map<string, string>();
    const knownHard = new Set<string>();
    let current = "/";
    let base = "/";
    let previous = "";
    let pos = 1;
    while (pos < p.length) {
        const next = p.indexOf("/", pos);
        previous = current;
        if (next === -1) {
            const last = p.slice(pos);
            current += last;
            base = previous + last;
            pos = p.length;
        } else {
            current += p.slice(pos, next + 1);
            base = previous + p.slice(pos, next);
            pos = next + 1;
        }
        if (knownHard.has(base)) {
            continue;
        }
        const stats: number[] = [];
        check(pts_fs_stat(base, false, stats), "lstat", base);
        if ((stats[1] & S_IFMT) !== S_IFLNK) {
            knownHard.add(base);
            continue;
        }
        const id = `${stats[0].toString(32)}:${stats[7].toString(32)}`;
        let linkTarget = seenLinks.get(id);
        if (linkTarget === undefined) {
            check(pts_fs_stat(base, true, []), "stat", base);
            linkTarget = pts_fs_readlink(base);
        }
        const resolvedLink = resolve(previous, linkTarget);
        seenLinks.set(id, linkTarget);
        p = resolve(resolvedLink, p.slice(pos));
        current = "/";
        base = "/";
        pos = 1;
    }
    return p;
}

// ---------------------------------------------------------------- the module as an object

// The default export, as Node's fs object: the functions as methods.
export class FileSystem {
    readonly constants = constants;

    get promises(): typeof promisesObject {
        return promisesObject;
    }

    readonly F_OK: number = F_OK;
    readonly R_OK: number = R_OK;
    readonly W_OK: number = W_OK;
    readonly X_OK: number = X_OK;

    readFileSync(path: PathLike, options?: ReadFileBufferOptions | null): Buffer;
    readFileSync(path: PathLike, options: BufferEncoding | ReadFileOptions): string;
    readFileSync(path: PathLike, options?: BufferEncoding | ReadFileOptions | ReadFileBufferOptions | null): string | Buffer {
        if (readsText(options)) {
            return pts_fs_read_file(path, readFlags(options));
        }
        return pts_fs_read_file_bytes(path, readFlags(options));
    }

    writeFileSync(file: PathLike, data: string | Uint8Array, options?: BufferEncoding | WriteFileOptions | null): void {
        writeFileSync(file, data, options);
    }

    appendFileSync(path: PathLike, data: string | Uint8Array, options?: BufferEncoding | WriteFileOptions | null): void {
        appendFileSync(path, data, options);
    }

    existsSync(path: PathLike): boolean {
        return existsSync(path);
    }

    accessSync(path: PathLike, mode: number = F_OK): void {
        accessSync(path, mode);
    }

    statSync(path: PathLike, options: { bigint?: false; throwIfNoEntry: false }): Stats | undefined;
    statSync(path: PathLike, options?: StatSyncOptions): Stats;
    statSync(path: PathLike, options?: StatSyncOptions): Stats | undefined {
        return statWith(path, true, options);
    }

    lstatSync(path: PathLike, options: { bigint?: false; throwIfNoEntry: false }): Stats | undefined;
    lstatSync(path: PathLike, options?: StatSyncOptions): Stats;
    lstatSync(path: PathLike, options?: StatSyncOptions): Stats | undefined {
        return statWith(path, false, options);
    }

    mkdirSync(path: PathLike, options?: number | MakeDirectoryOptions): string | undefined {
        return mkdirSync(path, options);
    }

    readdirSync(path: PathLike, options: { encoding?: BufferEncoding | null; withFileTypes: true; recursive?: boolean }): Dirent[];
    readdirSync(path: PathLike, options?: BufferEncoding | { encoding?: BufferEncoding | null; withFileTypes?: false; recursive?: boolean } | null): string[];
    readdirSync(path: PathLike, options?: BufferEncoding | ReaddirOptions | null): string[] | Dirent[] {
        return readdirWith(path, options);
    }

    unlinkSync(path: PathLike): void {
        unlinkSync(path);
    }

    rmdirSync(path: PathLike): void {
        rmdirSync(path);
    }

    rmSync(path: PathLike, options?: RmOptions): void {
        rmSync(path, options);
    }

    renameSync(oldPath: PathLike, newPath: PathLike): void {
        renameSync(oldPath, newPath);
    }

    copyFileSync(src: PathLike, dest: PathLike, mode: number = 0): void {
        copyFileSync(src, dest, mode);
    }

    symlinkSync(target: PathLike, path: PathLike, type?: "file" | "dir" | "junction" | null): void {
        symlinkSync(target, path, type);
    }

    readlinkSync(path: PathLike): string {
        return readlinkSync(path);
    }

    chmodSync(path: PathLike, mode: number): void {
        chmodSync(path, mode);
    }

    mkdtempSync(prefix: string): string {
        return mkdtempSync(prefix);
    }

    realpathSync(path: PathLike): string {
        return realpathSync(path);
    }
}

const fs: FileSystem = new FileSystem();
export default fs;
