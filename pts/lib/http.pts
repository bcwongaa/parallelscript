// pts:http: an HTTP/1.1 server (D-136) in the style of Bun's serve, with the Fetch
// standard's Request, Response and Headers: serve({ port, fetch }) listens and calls
// fetch for each request, then sends the Response it returns (or a promise of one).
// The connections, parsing and keep-alive are the runtime's (http.c). The global fetch
// (D-160) is this module's: it makes requests over HTTP/1.1 (fetch.c), over TLS for
// https (tls.c, D-223), and fetch, Request, Response and Headers are globals. An
// AbortSignal (D-162) aborts a fetch.

import { AbortController, AbortSignal, type EventListener } from "pts:internal/abort";

declare function pts_http_listen(port: number, hostname: string, everyLoop: boolean,
    onRequest: (connection: number, method: string, target: string, headers: string[], body: string) => unknown,
    onDisconnect: (request: unknown) => void): number;
declare function pts_http_respond(connection: number, status: number, statusText: string, headers: string[], body: string): void;
declare function pts_http_port(server: number): number;
declare function pts_http_stop(server: number, closeActive: boolean): void;
declare function pts_http_fetch(method: string, host: string, port: number, secure: boolean, target: string, headers: string[], body: string,
    hasBody: boolean, done: (ok: boolean, parts: string[], failure: unknown) => void): number;
declare function pts_http_fetch_abort(request: number): void;
declare function pts_sync_lock(lock: ArrayBuffer): void;
declare function pts_sync_unlock(lock: ArrayBuffer): void;

export type HeadersInit = Headers | Record<string, string> | [string, string][];

// 1 for the characters of an HTTP token (RFC 9110's tchar), by character code.
const TOKEN_CODES = tokenCodes();

function tokenCodes(): Uint8Array {
    const codes = new Uint8Array(128);
    for (const ch of "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz") {
        codes[ch.charCodeAt(0)] = 1;
    }
    return codes;
}

// Checked by character codes rather than a regex: every header of every response goes through here.
function headerName(name: string): string {
    let valid = name.length > 0;
    for (let i = 0; i < name.length && valid; i++) {
        const code = name.charCodeAt(i);
        valid = code < 128 && TOKEN_CODES[code] === 1;
    }
    if (!valid) {
        throw new TypeError(`Headers: invalid header name "${name}"`);
    }
    return name.toLowerCase();
}

function isHttpWhitespace(ch: string): boolean {
    return ch === " " || ch === "\t" || ch === "\n" || ch === "\r";
}

function headerValue(value: string): string {
    let trimmed = value;
    if (value.length > 0 && (isHttpWhitespace(value[0]) || isHttpWhitespace(value[value.length - 1]))) {
        trimmed = value.replace(/^[\t\n\r ]+|[\t\n\r ]+$/g, "");
    }
    if (trimmed.includes("\0") || trimmed.includes("\r") || trimmed.includes("\n")) {
        throw new TypeError(`Headers: invalid header value "${trimmed}"`);
    }
    return trimmed;
}

// Adds fields (names and values in turn) the server has already checked to headers, as
// they came; Headers' static block sets it, since only the class sees its fields.
let addReceived: (headers: Headers, fields: string[]) => void;

// Header fields: names (lowercase, as HTTP compares them) and values, in the order added.
export class Headers {
    readonly #names: string[] = [];
    readonly #values: string[] = [];

    constructor(init?: HeadersInit) {
        if (init instanceof Headers) {
            init.forEach((value, name) => this.append(name, value));
        } else if (Array.isArray(init)) {
            for (const [name, value] of init) {
                this.append(name, value);
            }
        } else if (init !== undefined) {
            for (const name of Object.keys(init)) {
                this.append(name, init[name]);
            }
        }
    }

    append(name: string, value: string): void {
        this.#names.push(headerName(name));
        this.#values.push(headerValue(value));
    }

    delete(name: string): void {
        const key = headerName(name);
        for (let i = this.#names.length - 1; i >= 0; i--) {
            if (this.#names[i] === key) {
                this.#names.splice(i, 1);
                this.#values.splice(i, 1);
            }
        }
    }

    // The field's values, joined by ", " as the Fetch standard combines them; null if it has none.
    get(name: string): string | null {
        return this.#combined(headerName(name));
    }

    getSetCookie(): string[] {
        return this.#values.filter((_, i) => this.#names[i] === "set-cookie");
    }

    has(name: string): boolean {
        return this.#names.includes(headerName(name));
    }

    // Replaces the field's first value and drops the others, or adds the field.
    set(name: string, value: string): void {
        const key = headerName(name);
        const first = this.#names.indexOf(key);
        if (first < 0) {
            this.append(key, value);
            return;
        }
        this.#values[first] = headerValue(value);
        for (let i = this.#names.length - 1; i > first; i--) {
            if (this.#names[i] === key) {
                this.#names.splice(i, 1);
                this.#values.splice(i, 1);
            }
        }
    }

    // Each field in name order, its values combined (set-cookie's one by one), as the Fetch standard iterates them.
    forEach(callback: (value: string, name: string, headers: Headers) => void): void {
        for (const [name, value] of this.#sorted()) {
            callback(value, name, this);
        }
    }

    static {
        addReceived = (headers, fields) => {
            for (let i = 0; i + 1 < fields.length; i += 2) {
                headers.#names.push(fields[i]);
                headers.#values.push(fields[i + 1]);
            }
        };
    }

    *entries(): Generator<[string, string]> {
        yield* this.#sorted();
    }

    *keys(): Generator<string> {
        for (const [name] of this.#sorted()) {
            yield name;
        }
    }

    *values(): Generator<string> {
        for (const [, value] of this.#sorted()) {
            yield value;
        }
    }

    [Symbol.iterator](): Generator<[string, string]> {
        return this.entries();
    }

    #sorted(): [string, string][] {
        const names = [...new Set(this.#names)].sort();
        const fields: [string, string][] = [];
        for (const name of names) {
            if (name === "set-cookie") {
                for (const cookie of this.getSetCookie()) {
                    fields.push([name, cookie]);
                }
            } else {
                fields.push([name, this.#combined(name) ?? ""]);
            }
        }
        return fields;
    }

    #combined(key: string): string | null {
        let combined: string | null = null;
        for (let i = 0; i < this.#names.length; i++) {
            if (this.#names[i] === key) {
                combined = combined === null ? this.#values[i] : `${combined}, ${this.#values[i]}`;
            }
        }
        return combined;
    }
}

export type RequestRedirect = "follow" | "error" | "manual";

export interface RequestInit {
    method?: string;
    headers?: HeadersInit;
    body?: string | null;
    // What fetch does with a redirect: follow it (the default), fail, or return it.
    redirect?: RequestRedirect;
    // Aborts the fetch: it rejects with the signal's reason, and its connection closes.
    signal?: AbortSignal | null;
}

// The body of a request, or null if it has none; Request's static block sets it.
let bodyOf: (request: Request) => string | null;
// The signal a request follows, or null if it was given none.
let signalOf: (request: Request) => AbortSignal | null;
// Aborts the signal of a request the server received, whose client has gone (D-163).
let disconnect: (request: Request) => void;
// Guards a request's own signal, made when first read, against the server's disconnect, which
// may run on another thread than the read (C116). One lock for every request, rather than one
// each, keeps the server's requests from allocating; it is held for a few stores.
const OWN_SIGNAL_LOCK = new ArrayBuffer(4);

// A request: its method, its absolute URL, its headers, its body as text and its signal.
// Made from a URL, or from another request, whose parts init replaces.
export class Request {
    readonly method: string;
    readonly url: string;
    readonly headers: Headers;
    readonly redirect: RequestRedirect;
    readonly #body: string | null;
    #signal: AbortSignal | null;
    #controller: AbortController | null = null; // of the signal made when first read
    #gone = false; // a server's request whose client has left

    constructor(input: string | Request, init?: RequestInit) {
        const from = typeof input === "string" ? null : input;
        this.method = (init?.method ?? (from === null ? "GET" : from.method)).toUpperCase();
        this.url = typeof input === "string" ? input : input.url;
        this.headers = new Headers(init?.headers ?? (from === null ? undefined : from.headers));
        this.redirect = init?.redirect ?? (from === null ? "follow" : from.redirect);
        const body = init?.body;
        this.#body = body !== undefined ? body : from === null ? null : from.#body;
        const signal = init?.signal !== undefined ? init.signal : from === null ? null : from.#signal;
        this.#signal = signal === null ? null : AbortSignal.any([signal]); // a signal of its own that follows the one given, as the Fetch standard's
    }

    // The request's signal. A request given none has one of its own, which aborts when the
    // request is one a server received and its client leaves before the answer.
    get signal(): AbortSignal {
        return this.#signal ?? this.#ownSignal();
    }

    // The request's own signal, made at its first read. Threads reading at once all get the one
    // made first, which is aborted if the client has gone.
    #ownSignal(): AbortSignal {
        const made = new AbortController();
        pts_sync_lock(OWN_SIGNAL_LOCK);
        let signal = this.#signal;
        const first = signal === null;
        if (signal === null) {
            signal = made.signal;
            this.#signal = signal;
            this.#controller = made;
        }
        const gone = this.#gone;
        pts_sync_unlock(OWN_SIGNAL_LOCK);
        if (first && gone) {
            made.abort();
        }
        return signal;
    }

    text(): Promise<string> {
        return Promise.resolve(this.#body ?? "");
    }

    async json(): Promise<any> {
        return JSON.parse(this.#body ?? "");
    }

    static {
        bodyOf = (request) => request.#body;
        signalOf = (request) => request.#signal;
        disconnect = (request) => {
            pts_sync_lock(OWN_SIGNAL_LOCK);
            request.#gone = true;
            const controller = request.#controller;
            pts_sync_unlock(OWN_SIGNAL_LOCK);
            controller?.abort();
        };
    }
}

// WebIDL's conversion to an unsigned short, which the Fetch standard's status goes through.
function unsignedShort(n: number): number {
    if (!Number.isFinite(n)) {
        return 0;
    }
    const wrapped = Math.trunc(n) % 65536;
    return wrapped < 0 ? wrapped + 65536 : wrapped;
}

export interface ResponseInit {
    status?: number;
    statusText?: string;
    headers?: HeadersInit;
}

// What fetch received: the Response it makes keeps the status and the header fields as
// they came, and its URL.
interface Received {
    status: number;
    statusText: string;
    fields: string[];
    url: string;
    redirected: boolean;
}

// A response: its status, its headers and its body as text; one that fetch made has the
// URL it came from, and whether a redirect led there.
export class Response {
    readonly status: number;
    readonly statusText: string;
    readonly headers: Headers;
    readonly url: string;
    readonly redirected: boolean;
    readonly #body: string | null;

    constructor(body: string | null = null, init?: ResponseInit, received?: Received) {
        this.#body = body;
        if (received !== undefined) {
            this.status = received.status;
            this.statusText = received.statusText;
            this.headers = new Headers();
            addReceived(this.headers, received.fields);
            this.url = received.url;
            this.redirected = received.redirected;
            return;
        }
        const status = unsignedShort(init?.status ?? 200);
        if (status < 200 || status > 599) {
            throw new RangeError(`init["status"] must be in the range of 200 to 599, inclusive.`);
        }
        this.status = status;
        this.statusText = init?.statusText ?? "";
        this.headers = new Headers(init?.headers);
        this.url = "";
        this.redirected = false;
        if (body !== null && !this.headers.has("content-type")) {
            this.headers.set("content-type", "text/plain;charset=UTF-8");
        }
    }

    get ok(): boolean {
        return this.status >= 200 && this.status <= 299;
    }

    text(): Promise<string> {
        return Promise.resolve(this.#body ?? "");
    }

    async json(): Promise<any> {
        return JSON.parse(this.#body ?? "");
    }

    // A response whose body is data as JSON, with the content type application/json unless init gives one.
    static json(data: any, init?: ResponseInit): Response {
        const response = new Response(JSON.stringify(data), init);
        if (init === undefined || !new Headers(init.headers).has("content-type")) {
            response.headers.set("content-type", "application/json");
        }
        return response;
    }
}

export interface ServeOptions {
    // The port to listen on (default 3000; 0 for any free port).
    port?: number;
    // The address to listen on (default "0.0.0.0", every IPv4 address).
    hostname?: string;
    // Accept connections on every event loop (D-136), each with its own SO_REUSEPORT socket.
    reusePort?: boolean;
    // The response to each request.
    fetch: (request: Request, server: Server) => Response | Promise<Response>;
    // The response when fetch throws (default: the error on stderr and a 500 response).
    error?: (error: unknown) => Response | Promise<Response>;
}

// A listening server: where it listens, and stop().
export class Server {
    readonly #id: number;
    readonly port: number;
    readonly hostname: string;
    readonly url: string;

    constructor(options: ServeOptions) {
        this.hostname = options.hostname ?? "0.0.0.0";
        this.#id = pts_http_listen(options.port ?? 3000, this.hostname, options.reusePort ?? false,
            (connection, method, target, headers, body) => receive(options, this, connection, method, target, headers, body),
            (request) => disconnect(request as Request)); // the runtime keeps what receive returned
        this.port = pts_http_port(this.#id);
        this.url = `http://${this.hostname === "0.0.0.0" ? "localhost" : this.hostname}:${this.port}/`;
    }

    // Stops listening; idle connections close, and the others after their responses, or at
    // once if closeActiveConnections (their requests' signals abort), as Bun's stop does.
    stop(closeActiveConnections: boolean = false): void {
        pts_http_stop(this.#id, closeActiveConnections);
    }
}

export function serve(options: ServeOptions): Server {
    return new Server(options);
}

// A request the server received, as a Request, which the handler's answer will go to;
// the server keeps it to abort its signal if the client leaves first.
function receive(options: ServeOptions, server: Server, connection: number, method: string, target: string, fields: string[], body: string): Request {
    let host = `${server.hostname}:${server.port}`;
    for (let i = 0; i + 1 < fields.length; i += 2) {
        if (fields[i] === "host") {
            host = fields[i + 1];
            break;
        }
    }
    const url = target.startsWith("/") ? `http://${host}${target}` : target;
    const request = new Request(url, { method, body });
    addReceived(request.headers, fields);
    answer(options, server, connection, request);
    return request;
}

async function answer(options: ServeOptions, server: Server, connection: number, request: Request): Promise<void> {
    let response: Response;
    try {
        response = await options.fetch(request, server);
    } catch (error) {
        response = await failed(options, error);
    }
    const sent: string[] = [];
    response.headers.forEach((value, name) => {
        sent.push(name, value);
    });
    pts_http_respond(connection, response.status, response.statusText, sent, await response.text());
}

// The response to a request whose handler threw: the error handler's, or a 500.
async function failed(options: ServeOptions, error: unknown): Promise<Response> {
    const handler = options.error;
    if (handler !== undefined) {
        try {
            return await handler(error);
        } catch (thrown) {
            error = thrown;
        }
    }
    console.error(error);
    return new Response("Internal Server Error", { status: 500 });
}

// ---------------------------------------------------------------- fetch (D-160)

// Where a URL points: its parts, and the URL as the URL standard writes it.
interface Target {
    scheme: string;
    host: string; // without the brackets of an IPv6 address
    port: number;
    path: string; // the path and query
    href: string;
}

// The ports the Fetch standard blocks.
const BAD_PORTS = [1, 7, 9, 11, 13, 15, 17, 19, 20, 21, 22, 23, 25, 37, 42, 43, 53, 69, 77, 79, 87, 95, 101, 102, 103, 104, 109, 110, 111, 113, 115,
    117, 119, 123, 135, 137, 139, 143, 161, 179, 389, 427, 465, 512, 513, 514, 515, 526, 530, 531, 532, 540, 548, 554, 556, 563, 587, 601, 636, 989,
    990, 993, 995, 1719, 1720, 1723, 2049, 3659, 4045, 4190, 5060, 5061, 6000, 6566, 6665, 6666, 6667, 6668, 6669, 6679, 6697, 10080];

// The request headers the client writes itself.
const OWN_HEADERS = ["connection", "content-length", "expect", "host", "keep-alive", "transfer-encoding", "upgrade"];

// Percent-encodes the characters of a path or query that the URL standard encodes.
function encodePath(path: string): string {
    let encoded = "";
    for (const ch of path) {
        const code = ch.codePointAt(0) ?? 0;
        encoded += code <= 32 || code > 126 || ch === '"' || ch === "<" || ch === ">" || ch === "`" || ch === "{" || ch === "}" ? encodeURIComponent(ch) : ch;
    }
    return encoded;
}

// Parses an absolute URL with an authority (scheme://host:port/path?query#fragment), or null if it isn't one.
function parseUrl(url: string): Target | null {
    const m = /^([A-Za-z][A-Za-z0-9+.-]*):\/\/(?:[^@\/?#]*@)?(\[[0-9A-Fa-f:.]*\]|[^:\/?#\[\]]*)(?::([0-9]*))?([\/?][^#]*)?(?:#.*)?$/.exec(url.trim());
    if (m === null || m[2] === "") {
        return null;
    }
    const scheme = m[1].toLowerCase();
    const bracketed = m[2].startsWith("[");
    const host = bracketed ? m[2].slice(1, -1).toLowerCase() : m[2].toLowerCase();
    const defaultPort = scheme === "https" ? 443 : 80;
    const port = m[3] === undefined || m[3] === "" ? defaultPort : Number(m[3]);
    if (port > 65535) {
        return null;
    }
    let path = encodePath(m[4] ?? "/");
    if (path.startsWith("?")) {
        path = "/" + path;
    }
    const authority = (bracketed ? `[${host}]` : host) + (port === defaultPort ? "" : `:${port}`);
    return { scheme, host, port, path, href: `${scheme}://${authority}${path}` };
}

// A redirect's location, against the URL it answered.
function resolveUrl(base: Target, location: string): string {
    if (/^[A-Za-z][A-Za-z0-9+.-]*:/.test(location)) {
        return location;
    }
    const origin = base.href.slice(0, base.href.length - base.path.length);
    if (location.startsWith("//")) {
        return `${base.scheme}:${location}`;
    }
    if (location.startsWith("/")) {
        return origin + location;
    }
    const path = base.path.split("?")[0];
    if (location.startsWith("?")) {
        return origin + path + location;
    }
    return origin + path.slice(0, path.lastIndexOf("/") + 1) + location;
}

// fetch's error: a TypeError whose cause says what went wrong, as Node's.
function fetchFailed(cause: unknown): TypeError {
    return new TypeError("fetch failed", { cause });
}

// One request over a connection of its own (fetch.c): the response's status, status text,
// body and header fields, in turn. If signal aborts first, the connection closes and the
// promise rejects with undefined.
function exchange(method: string, target: Target, fields: string[], body: string, sendsBody: boolean, signal: AbortSignal | null): Promise<string[]> {
    return new Promise((resolve, reject) => {
        let ended = false;
        let request = -1;
        const onAbort: EventListener = () => pts_http_fetch_abort(request);
        request = pts_http_fetch(method, target.host, target.port, target.scheme === "https", target.path, fields, body, sendsBody, (ok, parts, failure) => {
            ended = true;
            signal?.removeEventListener("abort", onAbort);
            if (ok) {
                resolve(parts);
            } else {
                reject(failure);
            }
        });
        if (!ended && signal !== null) {
            signal.addEventListener("abort", onAbort);
            if (signal.aborted) {
                pts_http_fetch_abort(request); // it aborted on another thread before onAbort was added (C116)
            }
        }
    });
}

// Fetches a resource over HTTP/1.1 (D-O10): http:// and https:// URLs (TLS with the
// server's certificate verified, D-223), one connection per request, redirects followed
// (up to 20) unless init.redirect says otherwise. The promise rejects with a TypeError
// for a URL it can't parse, an unsupported scheme or a network failure (a certificate
// that doesn't verify among them), and with the signal's reason if the request's signal
// aborts before the response is in.
export async function fetch(input: string | Request, init?: RequestInit): Promise<Response> {
    const request = new Request(input, init);
    let target = parseUrl(request.url);
    if (target === null) {
        throw new TypeError(`Failed to parse URL from ${request.url}`, { cause: new TypeError("Invalid URL") });
    }
    const signal = signalOf(request);
    signal?.throwIfAborted();
    let method = request.method;
    let body = bodyOf(request);
    if (body !== null && (method === "GET" || method === "HEAD")) {
        throw new TypeError("Request with GET/HEAD method cannot have body.");
    }
    const headers = new Headers(request.headers);
    for (let redirects = 0; ; redirects++) {
        if (target.scheme !== "http" && target.scheme !== "https") {
            throw fetchFailed(new Error("unknown scheme"));
        }
        if (BAD_PORTS.includes(target.port)) {
            throw fetchFailed(new Error("bad port"));
        }
        const fields: string[] = ["host", target.href.slice(target.scheme.length + 3, target.href.length - target.path.length)];
        headers.forEach((value, name) => {
            if (!OWN_HEADERS.includes(name)) {
                fields.push(name, value);
            }
        });
        if (!headers.has("accept")) {
            fields.push("accept", "*/*");
        }
        if (!headers.has("user-agent")) {
            fields.push("user-agent", "ParallelScript");
        }
        if (body !== null && !headers.has("content-type")) {
            fields.push("content-type", "text/plain;charset=UTF-8");
        }
        const sendsBody = body !== null || method === "POST" || method === "PUT" || method === "PATCH";
        let parts: string[];
        try {
            parts = await exchange(method, target, fields, body ?? "", sendsBody, signal);
        } catch (cause) {
            signal?.throwIfAborted();
            throw fetchFailed(cause);
        }
        signal?.throwIfAborted(); // aborted while the response was on its way to this function
        const status = Number(parts[0]);
        const received: Received = { status, statusText: parts[1], fields: parts.slice(3), url: target.href, redirected: redirects > 0 };
        const text: string | null = method === "HEAD" || status === 204 || status === 304 ? null : parts[2];
        const response = new Response(text, undefined, received);
        const location = response.headers.get("location");
        if (location === null || ![301, 302, 303, 307, 308].includes(status) || request.redirect === "manual") {
            return response;
        }
        if (request.redirect === "error") {
            throw fetchFailed(new Error("unexpected redirect"));
        }
        if (redirects === 20) {
            throw fetchFailed(new Error("redirect count exceeded"));
        }
        const next = parseUrl(resolveUrl(target, location));
        if (next === null) {
            throw fetchFailed(new TypeError("Invalid URL"));
        }
        if (next.scheme !== target.scheme || next.host !== target.host || next.port !== target.port) {
            // Credentials don't go to another origin (the Fetch standard's step for
            // Authorization; undici drops these three).
            for (const name of ["authorization", "proxy-authorization", "cookie"]) {
                headers.delete(name);
            }
        }
        if ((status === 303 && method !== "GET" && method !== "HEAD") || ((status === 301 || status === 302) && method === "POST")) {
            method = "GET"; // a 303, or a 301 or 302 of a POST, is fetched with GET and no body
            body = null;
            for (const name of ["content-encoding", "content-language", "content-location", "content-type", "content-length"]) {
                headers.delete(name);
            }
        }
        target = next;
    }
}
