// pts:sync: synchronization for code that runs on several threads at once (D-L18, D-128,
// D-129): atomic integers, a mutex whose lock can be awaited, a once-only initializer and
// channels. Each
// keeps its lock word or cell in a small ArrayBuffer, which the runtime's intrinsics read
// atomically; the waiting of `lock()` is a promise, settled on the loop that made it.

declare function pts_atomic_load(cell: ArrayBuffer): int;
declare function pts_atomic_store(cell: ArrayBuffer, value: int): void;
declare function pts_atomic_add(cell: ArrayBuffer, delta: int): int;
declare function pts_atomic_compare_exchange(cell: ArrayBuffer, expected: int, desired: int): int;
declare function pts_sync_lock(lock: ArrayBuffer): void;
declare function pts_sync_try_lock(lock: ArrayBuffer): boolean;
declare function pts_sync_unlock(lock: ArrayBuffer): void;

// An int (i64) that threads read and change atomically, in sequential consistency.
export class AtomicInt {
    readonly #cell = new ArrayBuffer(8);

    constructor(value: int = 0) {
        pts_atomic_store(this.#cell, value);
    }

    load(): int {
        return pts_atomic_load(this.#cell);
    }

    store(value: int): void {
        pts_atomic_store(this.#cell, value);
    }

    // Adds delta (wrapping, as int arithmetic does) and returns the value before, as Atomics.add does.
    add(delta: int): int {
        return pts_atomic_add(this.#cell, delta);
    }

    // Stores desired if the value is expected, and returns the value before, as Atomics.compareExchange does.
    compareExchange(expected: int, desired: int): int {
        return pts_atomic_compare_exchange(this.#cell, expected, desired);
    }
}

// Atomic<int> is AtomicInt; int is the family's one member for now.
export class Atomic<T extends int = int> extends AtomicInt {}

// What `Mutex.lock()` gives: the protected value while it holds the lock.
export interface MutexGuard<T> {
    value: T;
    // Releases the lock; the guard can't be used after.
    unlock(): void;
}

// A value that one thread at a time may use: withLock blocks the thread until it gets
// the lock (for short critical sections), lock() waits without blocking the loop.
export class Mutex<T> {
    readonly #lock = new ArrayBuffer(4);
    readonly #waitersLock = new ArrayBuffer(4); // guards #waiters
    readonly #waiters: ((guard: MutexGuard<T>) => void)[] = [];
    #value: T;

    constructor(value: T) {
        this.#value = value;
    }

    // Runs fn with the value while holding the lock, which it waits for by blocking the thread.
    withLock<R>(fn: (value: T) => R): R {
        pts_sync_lock(this.#lock);
        try {
            return fn(this.#value);
        } finally {
            this.#release();
        }
    }

    // A guard of the value once the lock is this caller's; the loop goes on meanwhile.
    lock(): Promise<MutexGuard<T>> {
        if (pts_sync_try_lock(this.#lock)) {
            return Promise.resolve(this.#guard());
        }
        pts_sync_lock(this.#waitersLock);
        if (pts_sync_try_lock(this.#lock)) { // released while the waiters' lock was taken
            pts_sync_unlock(this.#waitersLock);
            return Promise.resolve(this.#guard());
        }
        const waiting = Promise.withResolvers<MutexGuard<T>>();
        this.#waiters.push(waiting.resolve);
        pts_sync_unlock(this.#waitersLock);
        return waiting.promise;
    }

    // Releases the lock: it passes, still held, to the first caller of lock() waiting, if any.
    #release(): void {
        pts_sync_lock(this.#waitersLock);
        const next = this.#waiters.shift();
        if (next === undefined) {
            pts_sync_unlock(this.#lock);
            pts_sync_unlock(this.#waitersLock);
            return;
        }
        pts_sync_unlock(this.#waitersLock);
        next(this.#guard());
    }

    #guard(): MutexGuard<T> {
        const mutex = this;
        const state = { held: true };
        const check = (): void => {
            if (!state.held) {
                throw new Error("The mutex guard was used after unlock()");
            }
        };
        return {
            get value(): T {
                check();
                return mutex.#value;
            },
            set value(value: T) {
                check();
                mutex.#value = value;
            },
            unlock(): void {
                check();
                state.held = false;
                mutex.#release();
            },
        };
    }
}

// Runs a function once: the first run() runs it, a run() meanwhile waits for it to finish
// (blocking its thread), and later ones return at once. If it throws, it hasn't run.
export class Once {
    readonly #ran = new AtomicInt(0);
    readonly #lock = new ArrayBuffer(4);

    run(fn: () => void): void {
        if (this.#ran.load() === 1) {
            return;
        }
        pts_sync_lock(this.#lock);
        try {
            if (this.#ran.load() === 0) {
                fn();
                this.#ran.store(1);
            }
        } finally {
            pts_sync_unlock(this.#lock);
        }
    }

    get done(): boolean {
        return this.#ran.load() === 1;
    }
}

// What a receiver gets: an item, or done once the channel is closed and empty.
interface Received<T> {
    done: boolean;
    value: T | undefined;
}

// A sender waiting for room, with its item.
interface WaitingSender<T> {
    value: T;
    resolve: (value: void) => void;
    reject: (reason: unknown) => void;
}

// A queue of items between loops and threads (D-129): send waits while a bounded channel
// is full, recv while it is empty; after close, receivers get what is queued, then done.
export class Channel<T> {
    readonly #lock = new ArrayBuffer(4); // guards everything below
    readonly #items: T[] = [];
    readonly #receivers: ((received: Received<T>) => void)[] = [];
    readonly #senders: WaitingSender<T>[] = [];
    readonly #capacity: number;
    #closed = false;

    // A channel that queues up to capacity items for receivers: Infinity (unbounded) by
    // default; 0 makes each send wait until a receiver takes its item.
    constructor(capacity: number = Infinity) {
        if (!(capacity >= 0)) {
            throw new RangeError("A channel's capacity must be 0 or more");
        }
        this.#capacity = capacity;
    }

    // Sends value: resolves once a receiver has it or it is queued; rejects if the channel
    // is closed, or closes while the send waits.
    send(value: T): Promise<void> {
        pts_sync_lock(this.#lock);
        if (this.#closed) {
            pts_sync_unlock(this.#lock);
            return Promise.reject(new Error("Send on a closed channel"));
        }
        const receiver = this.#receivers.shift();
        if (receiver !== undefined) {
            pts_sync_unlock(this.#lock);
            receiver({ done: false, value });
            return Promise.resolve();
        }
        if (this.#items.length < this.#capacity) {
            this.#items.push(value);
            pts_sync_unlock(this.#lock);
            return Promise.resolve();
        }
        const waiting = Promise.withResolvers<void>();
        this.#senders.push({ value, resolve: waiting.resolve, reject: waiting.reject });
        pts_sync_unlock(this.#lock);
        return waiting.promise;
    }

    // The next item, or undefined once the channel is closed and empty.
    async recv(): Promise<T | undefined> {
        return (await this.#next()).value;
    }

    // Closes the channel: later sends reject, as do those waiting; receivers get the items
    // queued, then done. Closing a closed channel does nothing.
    close(): void {
        pts_sync_lock(this.#lock);
        if (this.#closed) {
            pts_sync_unlock(this.#lock);
            return;
        }
        this.#closed = true;
        const receivers = this.#receivers.splice(0);
        const senders = this.#senders.splice(0);
        pts_sync_unlock(this.#lock);
        for (const receiver of receivers) {
            receiver({ done: true, value: undefined });
        }
        for (const sender of senders) {
            sender.reject(new Error("Send on a closed channel"));
        }
    }

    get closed(): boolean {
        pts_sync_lock(this.#lock);
        const closed = this.#closed;
        pts_sync_unlock(this.#lock);
        return closed;
    }

    // The items until the channel is closed and empty.
    async *[Symbol.asyncIterator](): AsyncGenerator<T, void, undefined> {
        while (true) {
            const received = await this.#next();
            if (received.done) {
                return;
            }
            yield received.value as T;
        }
    }

    #next(): Promise<Received<T>> {
        pts_sync_lock(this.#lock);
        if (this.#items.length > 0) {
            const value = this.#items.shift() as T;
            const sender = this.#senders.shift(); // there is room for the first sender waiting
            if (sender !== undefined) {
                this.#items.push(sender.value);
            }
            pts_sync_unlock(this.#lock);
            if (sender !== undefined) {
                sender.resolve();
            }
            return Promise.resolve({ done: false, value });
        }
        const sender = this.#senders.shift(); // a channel of capacity 0: the sender hands its item over
        if (sender !== undefined) {
            pts_sync_unlock(this.#lock);
            sender.resolve();
            return Promise.resolve({ done: false, value: sender.value });
        }
        if (this.#closed) {
            pts_sync_unlock(this.#lock);
            return Promise.resolve({ done: true, value: undefined });
        }
        const waiting = Promise.withResolvers<Received<T>>();
        this.#receivers.push(waiting.resolve);
        pts_sync_unlock(this.#lock);
        return waiting.promise;
    }
}
