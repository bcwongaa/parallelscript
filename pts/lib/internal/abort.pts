// pts:internal/abort: AbortController and what it stands on, as Node's globals (D-162):
// DOMException, Event, EventTarget, AbortSignal and AbortController. Only the library's
// modules may import it; programs see its classes as globals.

declare function pts_sync_lock(lock: ArrayBuffer): void;
declare function pts_sync_unlock(lock: ArrayBuffer): void;

// The legacy codes of DOMException's names (WebIDL); other names have code 0.
const DOM_EXCEPTION_CODES = new Map<string, number>([
    ["IndexSizeError", 1], ["HierarchyRequestError", 3], ["WrongDocumentError", 4], ["InvalidCharacterError", 5],
    ["NoModificationAllowedError", 7], ["NotFoundError", 8], ["NotSupportedError", 9], ["InvalidStateError", 11],
    ["SyntaxError", 12], ["InvalidModificationError", 13], ["NamespaceError", 14], ["InvalidAccessError", 15],
    ["TypeMismatchError", 17], ["SecurityError", 18], ["NetworkError", 19], ["AbortError", 20], ["URLMismatchError", 21],
    ["QuotaExceededError", 22], ["TimeoutError", 23], ["InvalidNodeTypeError", 24], ["DataCloneError", 25],
]);

// WebIDL's error for the web platform's failures: a name ("AbortError") and its legacy code.
export class DOMException extends Error {
    readonly #code: number;

    constructor(message: string = "", name: string = "Error") {
        super(message);
        this.name = name;
        this.#code = DOM_EXCEPTION_CODES.get(name) ?? 0;
    }

    get code(): number {
        return this.#code;
    }
}

export interface EventInit {
    bubbles?: boolean;
    cancelable?: boolean;
    composed?: boolean;
}

// What dispatchEvent needs of an event, which only Event's own code can reach; its static block sets them.
let beginDispatch: (event: Event, target: EventTarget) => void;
let endDispatch: (event: Event) => boolean;
let stopped: (event: Event) => boolean;
let markTrusted: (event: Event) => Event;
// The lock of a target's listeners, which AbortSignal's state shares; EventTarget's static block sets it.
let lockOf: (target: EventTarget) => ArrayBuffer;

// An event an EventTarget dispatches to its listeners. Events have no propagation path
// (there is no document tree), so an event is always at its target while dispatched.
export class Event {
    static readonly NONE = 0;
    static readonly CAPTURING_PHASE = 1;
    static readonly AT_TARGET = 2;
    static readonly BUBBLING_PHASE = 3;

    readonly type: string;
    readonly bubbles: boolean;
    readonly cancelable: boolean;
    readonly composed: boolean;
    readonly timeStamp: number;
    #target: EventTarget | null = null;
    #dispatching = false;
    #canceled = false;
    #stopped = false;
    #trusted = false;

    constructor(type: string, init?: EventInit) {
        this.type = type;
        this.bubbles = init?.bubbles ?? false;
        this.cancelable = init?.cancelable ?? false;
        this.composed = init?.composed ?? false;
        this.timeStamp = performance.now();
    }

    get target(): EventTarget | null {
        return this.#target;
    }

    get currentTarget(): EventTarget | null {
        return this.#dispatching ? this.#target : null;
    }

    get srcElement(): EventTarget | null {
        return this.#target;
    }

    get eventPhase(): number {
        return this.#dispatching ? Event.AT_TARGET : Event.NONE;
    }

    get defaultPrevented(): boolean {
        return this.#canceled;
    }

    // Whether the runtime fired the event (an AbortSignal's abort) rather than the program.
    get isTrusted(): boolean {
        return this.#trusted;
    }

    preventDefault(): void {
        if (this.cancelable) {
            this.#canceled = true;
        }
    }

    // Nothing to stop: an event never goes past its target.
    stopPropagation(): void {}

    stopImmediatePropagation(): void {
        this.#stopped = true;
    }

    composedPath(): EventTarget[] {
        return this.#dispatching && this.#target !== null ? [this.#target] : [];
    }

    static {
        beginDispatch = (event, target) => {
            if (event.#dispatching) {
                throw new DOMException("The event is already being dispatched.", "InvalidStateError");
            }
            event.#target = target;
            event.#dispatching = true;
            event.#stopped = false;
        };
        endDispatch = (event) => {
            event.#dispatching = false;
            return !event.#canceled;
        };
        stopped = (event) => event.#stopped;
        markTrusted = (event) => {
            event.#trusted = true;
            return event;
        };
    }
}

export type EventListener = (event: Event) => void;

export interface EventListenerOptions {
    capture?: boolean;
}

export interface AddEventListenerOptions extends EventListenerOptions {
    once?: boolean;
    passive?: boolean;
    // Removes the listener when the signal aborts.
    signal?: AbortSignal;
}

interface Registration {
    type: string;
    callback: EventListener;
    once: boolean;
    removed: boolean;
    // Called even after a listener before it stopped the event's propagation: the `signal`
    // option's listener, which removes another, as Node's is.
    resists: boolean;
}

// Something events are dispatched to: listeners by event type, each added once, called in
// the order added. A listener that throws doesn't stop the others; its error is reported
// as uncaught, as Node reports it.
export class EventTarget {
    readonly #registrations: Registration[] = [];
    // Threads may share a target (one signal that many threads follow, C116): this lock guards
    // the listener list, and an AbortSignal's state too. It is held only while the library reads
    // or writes them, never while a listener runs; a section that calls code unlocks in a finally.
    readonly #lock = new ArrayBuffer(4);

    addEventListener(type: string, callback: EventListener | null, options?: AddEventListenerOptions | boolean): void {
        const once = typeof options === "object" && options.once === true;
        const signal = typeof options === "object" ? options.signal : undefined;
        if (callback === null || signal?.aborted === true) {
            return;
        }
        // As Node does: the signal's listener first, and for a listener that is there already too,
        // so that the signal's abort removes it even when it is the signal's own listener. It is
        // used up once, as Node's once listener is, by a flag rather than by leaving the list: an
        // abort taking n of them out of it one by one would cost O(n²).
        if (signal !== undefined) {
            let used = false;
            const remove: EventListener = () => {
                if (!used) {
                    used = true;
                    this.removeEventListener(type, callback);
                }
            };
            signal.#append({ type: "abort", callback: remove, once: false, removed: false, resists: true });
        }
        this.#add({ type, callback, once, removed: false, resists: false });
        if (signal !== undefined && abortedNow(signal)) {
            this.removeEventListener(type, callback); // it aborted on another thread meanwhile
        }
    }

    removeEventListener(type: string, callback: EventListener | null, options?: EventListenerOptions | boolean): void {
        if (callback === null) {
            return;
        }
        pts_sync_lock(this.#lock);
        try {
            const found = this.#find(type, callback);
            if (found >= 0) {
                this.#registrations[found].removed = true; // a dispatch already under way skips it
                this.#registrations.splice(found, 1);
            }
        } finally {
            pts_sync_unlock(this.#lock);
        }
    }

    // Calls the listeners of the event's type; false if one of them canceled the event.
    dispatchEvent(event: Event): boolean {
        beginDispatch(event, this);
        for (const registration of this.#listeners()) {
            if (registration.removed || registration.type !== event.type || (stopped(event) && !registration.resists)) {
                continue;
            }
            if (registration.once && !this.#take(registration)) {
                continue; // a dispatch on another thread took it first
            }
            try {
                registration.callback(event);
            } catch (error) {
                queueMicrotask(() => {
                    throw error;
                });
            }
        }
        return endDispatch(event);
    }

    // Adds registration unless its listener is there for its type already.
    #add(registration: Registration): void {
        pts_sync_lock(this.#lock);
        try {
            if (this.#find(registration.type, registration.callback) < 0) {
                this.#registrations.push(registration);
            }
        } finally {
            pts_sync_unlock(this.#lock);
        }
    }

    // Adds a registration whose callback is new, so that it can't be there already.
    #append(registration: Registration): void {
        pts_sync_lock(this.#lock);
        this.#registrations.push(registration);
        pts_sync_unlock(this.#lock);
    }

    // The listeners as a dispatch begins: those added later wait for the next one.
    #listeners(): Registration[] {
        pts_sync_lock(this.#lock);
        const listeners = this.#registrations.slice();
        pts_sync_unlock(this.#lock);
        return listeners;
    }

    // Removes a once listener for the dispatch that calls it; false if it was removed already.
    #take(registration: Registration): boolean {
        pts_sync_lock(this.#lock);
        const taken = !registration.removed;
        if (taken) {
            registration.removed = true;
            this.#registrations.splice(this.#registrations.indexOf(registration), 1);
        }
        pts_sync_unlock(this.#lock);
        return taken;
    }

    #find(type: string, callback: EventListener): number {
        return this.#registrations.findIndex((registration) => registration.type === type && registration.callback === callback);
    }

    static {
        lockOf = (target) => target.#lock;
    }
}

// Whether signal has aborted by now: another thread may have aborted it since a check that
// tsc's narrowing would otherwise carry over.
function abortedNow(signal: AbortSignal): boolean {
    return signal.aborted;
}

// Programs get signals from AbortController and AbortSignal's statics, never from AbortSignal's
// constructor, which wants a key only this module has. A key rather than a flag the statics set
// around the call: threads making signals at once would clear each other's flag (C07).
const SIGNAL_KEY = {};
let signalAbort: (signal: AbortSignal, reason: any) => void;

// Whether an operation should stop, and why: aborted once, with a reason, firing an
// "abort" event at its listeners (onabort among them).
export class AbortSignal extends EventTarget {
    // A field rather than a getter, so that console.log shows it as Node does: `AbortSignal { aborted: false }`.
    readonly aborted: boolean = false;
    #reason: any = undefined;
    #onabort: EventListener | null = null;
    #handlerAdded = false;
    // The DOM standard's dependent signals: those AbortSignal.any made that follow this one, which
    // abort with it (C119, C121). Made by the first; given up when the signal aborts.
    #dependents: AbortSignal[] | null = null;
    // A signal AbortSignal.any made follows these, none of them made by any; null for other signals.
    #sources: AbortSignal[] | null = null;

    // The key is unknown rather than its own class, so that any other argument, also through
    // `any`, gets Node's TypeError rather than a failed conversion naming the class.
    constructor(key?: unknown) {
        super();
        if (key !== SIGNAL_KEY) {
            throw new TypeError("Illegal constructor");
        }
    }

    get reason(): any {
        return this.#reasonUnderLock();
    }

    get onabort(): EventListener | null {
        return this.#onabort;
    }

    // The handler is called from a listener added the first time one is set, as event handler attributes are.
    set onabort(handler: EventListener | null) {
        this.#onabort = handler;
        if (handler !== null && this.#claimHandler()) {
            this.addEventListener("abort", (event) => this.#onabort?.(event));
        }
    }

    throwIfAborted(): void {
        if (this.aborted) {
            throw this.#reasonUnderLock();
        }
    }

    // The reason, read under the lock #settle stores it under: a thread that saw the signal
    // aborted without the lock then sees the reason stored before aborted, which aarch64 may
    // otherwise show it after aborted (D-226).
    #reasonUnderLock(): any {
        const lock = lockOf(this);
        pts_sync_lock(lock);
        const reason = this.#reason;
        pts_sync_unlock(lock);
        return reason;
    }

    // A signal aborted already, with reason (an AbortError DOMException if none is given).
    static abort(reason?: any): AbortSignal {
        const signal = new AbortSignal(SIGNAL_KEY);
        signalAbort(signal, reason);
        return signal;
    }

    // A signal that aborts with a TimeoutError after ms milliseconds; its timer doesn't keep the program running.
    static timeout(ms: number): AbortSignal {
        const signal = new AbortSignal(SIGNAL_KEY);
        setTimeout(() => signalAbort(signal, new DOMException("The operation was aborted due to timeout", "TimeoutError")), ms).unref();
        return signal;
    }

    // A signal that aborts when the first of signals does, with its reason: the DOM standard's
    // dependent signal, which follows the signals that signals made by any follow, not those.
    static any(signals: AbortSignal[]): AbortSignal {
        const signal = new AbortSignal(SIGNAL_KEY);
        for (const source of signals) {
            if (source.aborted) {
                signalAbort(signal, source.reason);
                return signal;
            }
        }
        const sources: AbortSignal[] = [];
        for (const given of signals) {
            for (const source of given.#sources ?? [given]) {
                if (!sources.includes(source)) {
                    sources.push(source);
                }
            }
        }
        signal.#sources = sources;
        for (const source of sources) {
            const reason = AbortSignal.#follow(source, signal);
            if (reason !== undefined) {
                signalAbort(signal, reason); // the source aborted on another thread after the check above
                break;
            }
        }
        return signal;
    }

    // Whether this caller set the first handler, whose listener calls onabort.
    #claimHandler(): boolean {
        const lock = lockOf(this);
        pts_sync_lock(lock);
        const first = !this.#handlerAdded;
        this.#handlerAdded = true;
        pts_sync_unlock(lock);
        return first;
    }

    // Makes signal a dependent of source unless source has aborted, and returns source's reason:
    // undefined until it aborts, never after.
    static #follow(source: AbortSignal, signal: AbortSignal): any {
        const lock = lockOf(source);
        pts_sync_lock(lock);
        const reason = source.#reason;
        if (!source.aborted) {
            const dependents = source.#dependents ?? [];
            dependents.push(signal);
            source.#dependents = dependents;
        }
        pts_sync_unlock(lock);
        return reason;
    }

    // Marks signal aborted with reason and hands over its dependents, or null if it had aborted.
    static #settle(signal: AbortSignal, reason: any): AbortSignal[] | null {
        if (Object.isFrozen(signal) && !signal.aborted) {
            (signal as { aborted: boolean }).aborted = true; // throws, as Node's abort of a frozen signal does
        }
        const lock = lockOf(signal);
        pts_sync_lock(lock);
        if (signal.aborted) {
            pts_sync_unlock(lock);
            return null;
        }
        signal.#reason = reason; // before aborted, which threads read without the lock (then the reason with it, #reasonUnderLock)
        try {
            (signal as { aborted: boolean }).aborted = true;
        } catch (error) {
            signal.#reason = undefined; // frozen by another thread since the check above: it stays as it was
            pts_sync_unlock(lock);
            throw error;
        }
        const dependents = signal.#dependents;
        signal.#dependents = null;
        pts_sync_unlock(lock);
        return dependents ?? [];
    }

    static {
        // The DOM standard's "signal abort": the dependents that haven't aborted take the reason
        // before the signal's abort event fires, and fire theirs after it (C121). A frozen
        // dependent can't abort; its TypeError is thrown once the others have.
        signalAbort = (signal, reason) => {
            if (signal.aborted) {
                return;
            }
            const given = reason === undefined ? new DOMException("This operation was aborted", "AbortError") : reason;
            const dependents = AbortSignal.#settle(signal, given);
            if (dependents === null) {
                return; // another thread aborted it first
            }
            const aborting: AbortSignal[] = [];
            const failures: unknown[] = [];
            for (const dependent of dependents) {
                try {
                    if (AbortSignal.#settle(dependent, given) !== null) {
                        aborting.push(dependent);
                    }
                } catch (error) {
                    failures.push(error);
                }
            }
            signal.dispatchEvent(markTrusted(new Event("abort")));
            for (const dependent of aborting) {
                dependent.dispatchEvent(markTrusted(new Event("abort")));
            }
            if (failures.length > 0) {
                throw failures[0];
            }
        };
    }
}

// Aborts its signal: abort(reason) aborts it with reason, or an AbortError DOMException.
export class AbortController {
    readonly signal: AbortSignal = new AbortSignal(SIGNAL_KEY);

    abort(reason?: any): void {
        signalAbort(this.signal, reason);
    }
}
