// pts:parallel: data parallelism over the fork-join pool (D-122, D-123). `xs.par` is a
// ParallelArray view of an array (a ParallelTypedArray of a typed array, D-126), range(start, end) the integers start..end-1, whose
// `.par` is a ParallelRange, and join(a, b) runs two closures, perhaps at once. Every
// method is synchronous: it returns once every piece is done, its results in the order of
// the elements. A callback may run on several threads at once (D-L16, D-L17).

declare function pts_parallel_for(leaf: (from: number, to: number) => void, count: number): void;
declare function pts_parallel_reduce(leaf: (from: number, to: number) => any, combine: (left: any, right: any) => any, count: number): any;
declare function pts_parallel_join(a: () => void, b: () => void): void;
declare function pts_parallel_threads(): number;

// What marks a callback that runs on several threads at once: the function type F,
// branded, so that the compiler knows its body is a parallel body (D-L17).
export interface ParallelBrand {
    readonly __ptsParallel?: undefined;
}
export type ParallelCallback<F> = F & ParallelBrand;

// The result of a search over a piece: whether it found something, and what.
interface Found<T> {
    found: boolean;
    value: T | undefined;
}

export class ParallelArray<T> {
    constructor(private readonly items: T[]) {}

    // A new array of callback's value for each element, in order.
    map<U>(callback: ParallelCallback<(value: T, index: number, array: T[]) => U>): U[] {
        const items = this.items;
        const results = new Array<U>(items.length);
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                results[i] = callback(items[i], i, items);
            }
        }, items.length);
        return results;
    }

    forEach(callback: ParallelCallback<(value: T, index: number, array: T[]) => void>): void {
        const items = this.items;
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                callback(items[i], i, items);
            }
        }, items.length);
    }

    // The elements predicate holds for, in order.
    filter(predicate: ParallelCallback<(value: T, index: number, array: T[]) => unknown>): T[] {
        const items = this.items;
        const kept = pts_parallel_reduce((from, to) => {
            const piece: T[] = [];
            for (let i = from; i < to; i++) {
                if (predicate(items[i], i, items)) {
                    piece.push(items[i]);
                }
            }
            return piece;
        }, (left, right) => {
            const joined = left as T[];
            joined.push(...(right as T[]));
            return joined;
        }, items.length);
        return kept as T[];
    }

    // The elements folded with callback, which must be associative, from initial, as
    // `reduce` folds them (D-151): each piece folds its own elements, the pieces' results
    // are combined, and initial comes first, once; initial itself for no elements.
    reduce(callback: ParallelCallback<(left: T, right: T) => T>, initial: T): T {
        const items = this.items;
        if (items.length === 0) {
            return initial;
        }
        const total = pts_parallel_reduce((from, to) => {
            let accumulator = items[from];
            for (let i = from + 1; i < to; i++) {
                accumulator = callback(accumulator, items[i]);
            }
            return accumulator;
        }, (left, right) => callback(left as T, right as T), items.length);
        return callback(initial, total as T);
    }

    // Whether predicate holds for some element; it stops looking once one piece finds one.
    some(predicate: ParallelCallback<(value: T, index: number, array: T[]) => unknown>): boolean {
        return this.findFound(predicate).found;
    }

    // Whether predicate holds for every element; it stops looking once one piece finds one it doesn't hold for.
    every(predicate: ParallelCallback<(value: T, index: number, array: T[]) => unknown>): boolean {
        return !this.findFound((value, index, array) => !predicate(value, index, array)).found;
    }

    // An element predicate holds for (any one, not necessarily the first), or undefined.
    find(predicate: ParallelCallback<(value: T, index: number, array: T[]) => unknown>): T | undefined {
        return this.findFound(predicate).value;
    }

    // How many elements predicate holds for.
    count(predicate: ParallelCallback<(value: T, index: number, array: T[]) => unknown>): number {
        const items = this.items;
        const total = pts_parallel_reduce((from, to) => {
            let n = 0;
            for (let i = from; i < to; i++) {
                if (predicate(items[i], i, items)) {
                    n++;
                }
            }
            return n;
        }, (left, right) => (left as number) + (right as number), items.length);
        return total as number;
    }

    // The sum of the elements as numbers (0 for none).
    sum(): number {
        const items = this.items;
        const total = pts_parallel_reduce((from, to) => {
            let sum = 0;
            for (let i = from; i < to; i++) {
                sum += Number(items[i]);
            }
            return sum;
        }, (left, right) => (left as number) + (right as number), items.length);
        return total as number;
    }

    // The least element as a number, as Math.min gives it (Infinity for none).
    min(): number {
        const items = this.items;
        const least = pts_parallel_reduce((from, to) => {
            let min = Infinity;
            for (let i = from; i < to; i++) {
                min = Math.min(min, Number(items[i]));
            }
            return min;
        }, (left, right) => Math.min(left as number, right as number), items.length);
        return least as number;
    }

    // The greatest element as a number, as Math.max gives it (-Infinity for none).
    max(): number {
        const items = this.items;
        const greatest = pts_parallel_reduce((from, to) => {
            let max = -Infinity;
            for (let i = from; i < to; i++) {
                max = Math.max(max, Number(items[i]));
            }
            return max;
        }, (left, right) => Math.max(left as number, right as number), items.length);
        return greatest as number;
    }

    // A new array of callback's values for each element, in order, each array of them flattened one level.
    flatMap<U>(callback: ParallelCallback<(value: T, index: number, array: T[]) => U | U[]>): U[] {
        const items = this.items;
        const flattened = pts_parallel_reduce((from, to) => {
            const piece: U[] = [];
            for (let i = from; i < to; i++) {
                const value = callback(items[i], i, items);
                if (Array.isArray(value)) {
                    piece.push(...value);
                } else {
                    piece.push(value);
                }
            }
            return piece;
        }, (left, right) => {
            const joined = left as U[];
            joined.push(...(right as U[]));
            return joined;
        }, items.length);
        return flattened as U[];
    }

    // Sorts the array in place, stably, and returns it, as Array's sort does: by compare, or
    // without one by the elements' strings, undefined last.
    sort(compare?: ParallelCallback<(a: T, b: T) => number>): T[] {
        const items = this.items;
        if (compare !== undefined) {
            sortInPlace(items, compare);
            return items;
        }
        const keys = items.map((value) => (value === undefined ? undefined : String(value)));
        const order = range(items.length).toArray();
        sortInPlace(order, (a, b) => compareDefault(keys[a], keys[b]));
        return permute(items, order);
    }

    // Sorts the array in place, stably, by key's value for each element, and returns it.
    sortBy<K extends number | string>(key: ParallelCallback<(value: T) => K>): T[] {
        const items = this.items;
        const keys = new ParallelArray(items).map((value) => key(value));
        const order = range(items.length).toArray();
        sortInPlace(order, (a, b) => (keys[a] < keys[b] ? -1 : keys[b] < keys[a] ? 1 : 0));
        return permute(items, order);
    }

    // A new array of the elements.
    toArray(): T[] {
        return this.items.slice();
    }

    private findFound(predicate: (value: T, index: number, array: T[]) => unknown): Found<T> {
        const items = this.items;
        const done = { found: false };
        const result = pts_parallel_reduce((from, to) => {
            const piece: Found<T> = { found: false, value: undefined };
            for (let i = from; i < to && !done.found; i++) {
                if (predicate(items[i], i, items)) {
                    piece.found = true;
                    piece.value = items[i];
                    done.found = true;
                }
            }
            return piece;
        }, (left, right) => ((left as Found<T>).found ? left : right), items.length);
        return result as Found<T>;
    }
}

// What ParallelTypedArray uses of a typed array (D-126). Not a union of the typed arrays:
// tsc types a value of a type parameter whose constraint is a union as the union where
// its members are read, which would hide the typed array of the view's instance.
interface TypedArrayLike {
    readonly length: number;
    [index: number]: number;
    slice(start?: number, end?: number): TypedArrayLike;
    subarray(begin?: number, end?: number): this;
    set(array: ArrayLike<number>, offset?: number): void;
    sort(): TypedArrayLike;
}

// A parallel view of a typed array (D-126): ParallelArray's methods over its elements, which
// are numbers; map and filter make typed arrays of its kind, as its own map and filter do.
export class ParallelTypedArray<A extends TypedArrayLike> {
    constructor(private readonly items: A) {}

    // A new typed array of callback's value for each element, in order.
    map(callback: ParallelCallback<(value: number, index: number, array: A) => number>): A {
        const items = this.items;
        const results = items.slice() as A;
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                results[i] = callback(items[i], i, items);
            }
        }, items.length);
        return results;
    }

    forEach(callback: ParallelCallback<(value: number, index: number, array: A) => void>): void {
        const items = this.items;
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                callback(items[i], i, items);
            }
        }, items.length);
    }

    // A new typed array of the elements predicate holds for, in order.
    filter(predicate: ParallelCallback<(value: number, index: number, array: A) => unknown>): A {
        const items = this.items;
        const kept = pts_parallel_reduce((from, to) => {
            const piece: number[] = [];
            for (let i = from; i < to; i++) {
                if (predicate(items[i], i, items)) {
                    piece.push(items[i]);
                }
            }
            return piece;
        }, (left, right) => {
            const joined = left as number[];
            joined.push(...(right as number[]));
            return joined;
        }, items.length) as number[];
        const results = items.slice(0, kept.length) as A;
        results.set(kept);
        return results;
    }

    // The elements folded with callback, which must be associative, from initial, as
    // `reduce` folds them (D-151): initial comes first, once; initial itself for none.
    reduce(callback: ParallelCallback<(left: number, right: number) => number>, initial: number): number {
        const items = this.items;
        if (items.length === 0) {
            return initial;
        }
        const total = pts_parallel_reduce((from, to) => {
            let accumulator = items[from];
            for (let i = from + 1; i < to; i++) {
                accumulator = callback(accumulator, items[i]);
            }
            return accumulator;
        }, (left, right) => callback(left as number, right as number), items.length);
        return callback(initial, total as number);
    }

    some(predicate: ParallelCallback<(value: number, index: number, array: A) => unknown>): boolean {
        return this.findFound(predicate).found;
    }

    every(predicate: ParallelCallback<(value: number, index: number, array: A) => unknown>): boolean {
        return !this.findFound((value, index, array) => !predicate(value, index, array)).found;
    }

    // An element predicate holds for (any one, not necessarily the first), or undefined.
    find(predicate: ParallelCallback<(value: number, index: number, array: A) => unknown>): number | undefined {
        return this.findFound(predicate).value;
    }

    count(predicate: ParallelCallback<(value: number, index: number, array: A) => unknown>): number {
        const items = this.items;
        const total = pts_parallel_reduce((from, to) => {
            let n = 0;
            for (let i = from; i < to; i++) {
                if (predicate(items[i], i, items)) {
                    n++;
                }
            }
            return n;
        }, (left, right) => (left as number) + (right as number), items.length);
        return total as number;
    }

    sum(): number {
        const items = this.items;
        const total = pts_parallel_reduce((from, to) => {
            let sum = 0;
            for (let i = from; i < to; i++) {
                sum += items[i];
            }
            return sum;
        }, (left, right) => (left as number) + (right as number), items.length);
        return total as number;
    }

    min(): number {
        const items = this.items;
        const least = pts_parallel_reduce((from, to) => {
            let min = Infinity;
            for (let i = from; i < to; i++) {
                min = Math.min(min, items[i]);
            }
            return min;
        }, (left, right) => Math.min(left as number, right as number), items.length);
        return least as number;
    }

    max(): number {
        const items = this.items;
        const greatest = pts_parallel_reduce((from, to) => {
            let max = -Infinity;
            for (let i = from; i < to; i++) {
                max = Math.max(max, items[i]);
            }
            return max;
        }, (left, right) => Math.max(left as number, right as number), items.length);
        return greatest as number;
    }

    flatMap<U>(callback: ParallelCallback<(value: number, index: number, array: A) => U | U[]>): U[] {
        const items = this.items;
        return new ParallelArray(Array.from(items)).flatMap((value, index) => callback(value, index, items));
    }

    // Sorts the typed array in place and returns it, as its own sort does: by compare, or
    // without one in numeric order (-0 before 0, NaN last).
    sort(compare?: ParallelCallback<(a: number, b: number) => number>): A {
        const items = this.items;
        if (compare !== undefined) {
            const numbers = Array.from(items);
            sortInPlace(numbers, compare);
            items.set(numbers);
            return items;
        }
        const threads = pts_parallel_threads();
        if (threads === 1) {
            items.sort();
            return items;
        }
        // The pieces sort with the typed array's own sort, in place, and then merge.
        const piece = Math.max(SEQUENTIAL_SORT, Math.ceil(items.length / (threads * PIECES_PER_THREAD)));
        sortRun(items, items.slice() as A, 0, items.length, piece, compareNumbers, (from, to) => {
            items.subarray(from, to).sort();
        });
        return items;
    }

    // Sorts the typed array in place, stably, by key's value for each element, and returns it.
    sortBy<K extends number | string>(key: ParallelCallback<(value: number) => K>): A {
        const items = this.items;
        const numbers = Array.from(items);
        new ParallelArray(numbers).sortBy(key);
        items.set(numbers);
        return items;
    }

    // A new number[] of the elements.
    toArray(): number[] {
        return Array.from(this.items);
    }

    private findFound(predicate: (value: number, index: number, array: A) => unknown): Found<number> {
        const items = this.items;
        const done = { found: false };
        const result = pts_parallel_reduce((from, to) => {
            const piece: Found<number> = { found: false, value: undefined };
            for (let i = from; i < to && !done.found; i++) {
                if (predicate(items[i], i, items)) {
                    piece.found = true;
                    piece.value = items[i];
                    done.found = true;
                }
            }
            return piece;
        }, (left, right) => ((left as Found<number>).found ? left : right), items.length);
        return result as Found<number>;
    }
}

// The integers start, start + 1, …, end - 1 (none if end <= start).
export class Range {
    constructor(readonly start: number, readonly end: number) {}

    get length(): number {
        return Math.max(0, this.end - this.start);
    }

    // A parallel view of the range.
    get par(): ParallelRange {
        return new ParallelRange(this.start, this.length);
    }

    toArray(): number[] {
        const values = new Array<number>(this.length);
        for (let i = 0; i < values.length; i++) {
            values[i] = this.start + i;
        }
        return values;
    }

    *[Symbol.iterator](): Generator<number, void, undefined> {
        for (let i = this.start; i < this.end; i++) {
            yield i;
        }
    }
}

// range(start, end): the integers start..end-1; range(end): 0..end-1.
export function range(start: number, end?: number): Range {
    return end === undefined ? new Range(0, Math.trunc(start)) : new Range(Math.trunc(start), Math.trunc(end));
}

export class ParallelRange {
    constructor(private readonly start: number, private readonly length: number) {}

    map<U>(callback: ParallelCallback<(value: number) => U>): U[] {
        const start = this.start;
        const results = new Array<U>(this.length);
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                results[i] = callback(start + i);
            }
        }, this.length);
        return results;
    }

    forEach(callback: ParallelCallback<(value: number) => void>): void {
        const start = this.start;
        pts_parallel_for((from, to) => {
            for (let i = from; i < to; i++) {
                callback(start + i);
            }
        }, this.length);
    }

    filter(predicate: ParallelCallback<(value: number) => unknown>): number[] {
        const start = this.start;
        const kept = pts_parallel_reduce((from, to) => {
            const piece: number[] = [];
            for (let i = from; i < to; i++) {
                if (predicate(start + i)) {
                    piece.push(start + i);
                }
            }
            return piece;
        }, (left, right) => {
            const joined = left as number[];
            joined.push(...(right as number[]));
            return joined;
        }, this.length);
        return kept as number[];
    }

    // The integers folded with callback, which must be associative, from initial, as
    // `reduce` folds them (D-151): initial comes first, once; initial itself for none.
    reduce(callback: ParallelCallback<(left: number, right: number) => number>, initial: number): number {
        const start = this.start;
        if (this.length === 0) {
            return initial;
        }
        const total = pts_parallel_reduce((from, to) => {
            let accumulator = start + from;
            for (let i = from + 1; i < to; i++) {
                accumulator = callback(accumulator, start + i);
            }
            return accumulator;
        }, (left, right) => callback(left as number, right as number), this.length);
        return callback(initial, total as number);
    }

    some(predicate: ParallelCallback<(value: number) => unknown>): boolean {
        return this.findFound(predicate).found;
    }

    every(predicate: ParallelCallback<(value: number) => unknown>): boolean {
        return !this.findFound((value) => !predicate(value)).found;
    }

    find(predicate: ParallelCallback<(value: number) => unknown>): number | undefined {
        return this.findFound(predicate).value;
    }

    count(predicate: ParallelCallback<(value: number) => unknown>): number {
        const start = this.start;
        const total = pts_parallel_reduce((from, to) => {
            let n = 0;
            for (let i = from; i < to; i++) {
                if (predicate(start + i)) {
                    n++;
                }
            }
            return n;
        }, (left, right) => (left as number) + (right as number), this.length);
        return total as number;
    }

    sum(): number {
        return this.length * this.start + (this.length * (this.length - 1)) / 2;
    }

    min(): number {
        return this.length > 0 ? this.start : Infinity;
    }

    max(): number {
        return this.length > 0 ? this.start + this.length - 1 : -Infinity;
    }

    flatMap<U>(callback: ParallelCallback<(value: number) => U | U[]>): U[] {
        return new ParallelArray(this.toArray()).flatMap((value) => callback(value));
    }

    // A new array of the integers sorted by compare.
    sort(compare: ParallelCallback<(a: number, b: number) => number>): number[] {
        return new ParallelArray(this.toArray()).sort(compare);
    }

    // A new array of the integers sorted by key's value for each.
    sortBy<K extends number | string>(key: ParallelCallback<(value: number) => K>): number[] {
        return new ParallelArray(this.toArray()).sortBy(key);
    }

    toArray(): number[] {
        return new Range(this.start, this.start + this.length).toArray();
    }

    private findFound(predicate: (value: number) => unknown): Found<number> {
        const start = this.start;
        const done = { found: false };
        const result = pts_parallel_reduce((from, to) => {
            const piece: Found<number> = { found: false, value: undefined };
            for (let i = from; i < to && !done.found; i++) {
                if (predicate(start + i)) {
                    piece.found = true;
                    piece.value = start + i;
                    done.found = true;
                }
            }
            return piece;
        }, (left, right) => ((left as Found<number>).found ? left : right), this.length);
        return result as Found<number>;
    }
}

// ---------------------------------------------------------------- the parallel merge sort

// Runs of at most this many elements merge sequentially, and no piece sorts sequentially with fewer.
const SEQUENTIAL_SORT = 2048;
// The pieces per thread that sort sequentially (with Array's sort) before the merges: more merge levels cost more than the balance they buy.
const PIECES_PER_THREAD = 1;

// Array's default order: by the elements' strings (UTF-16 code units), undefined last.
function compareDefault(a: string | undefined, b: string | undefined): number {
    if (a === undefined) {
        return b === undefined ? 0 : 1;
    }
    if (b === undefined) {
        return -1;
    }
    return a < b ? -1 : b < a ? 1 : 0;
}

// A typed array's default order: numeric, -0 before 0, NaN last.
function compareNumbers(a: number, b: number): number {
    if (a !== a || b !== b) {
        return (a !== a ? 1 : 0) - (b !== b ? 1 : 0);
    }
    if (a === 0 && b === 0) {
        return (Object.is(b, -0) ? 1 : 0) - (Object.is(a, -0) ? 1 : 0);
    }
    return a < b ? -1 : b < a ? 1 : 0;
}

// Puts items in the order order lists their indices in, in place, and returns items.
function permute<T>(items: T[], order: number[]): T[] {
    const sorted = new ParallelArray(order).map((index) => items[index]);
    pts_parallel_for((from, to) => {
        for (let i = from; i < to; i++) {
            items[i] = sorted[i];
        }
    }, items.length);
    return items;
}

// Sorts items in place, stably, by compare: Rayon's parallel merge sort, whose pieces
// Array's sort sorts, PIECES_PER_THREAD per thread; with one thread, Array's sort alone (D-O06).
function sortInPlace<T>(items: T[], compare: (a: T, b: T) => number): void {
    const threads = pts_parallel_threads();
    if (threads === 1) {
        items.sort(compare);
        return;
    }
    const piece = Math.max(SEQUENTIAL_SORT, Math.ceil(items.length / (threads * PIECES_PER_THREAD)));
    sortRun(items, items.slice(), 0, items.length, piece, compare, (from, to) => {
        const sorted = items.slice(from, to).sort(compare);
        for (let i = 0; i < sorted.length; i++) {
            items[from + i] = sorted[i];
        }
    });
}

// What the merge sort sorts: an array, or a typed array (D-126).
interface Indexed<T> {
    [index: number]: T;
}

// Sorts items[from..to), using buffer[from..to) for the merge: runs of at most piece
// elements by sortPiece, longer ones by merging their sorted halves.
function sortRun<T, S extends Indexed<T>>(items: S, buffer: S, from: number, to: number, piece: number, compare: (a: T, b: T) => number, sortPiece: (from: number, to: number) => void): void {
    if (to - from <= piece) {
        sortPiece(from, to);
        return;
    }
    const middle = from + Math.floor((to - from) / 2);
    join(() => sortRun(items, buffer, from, middle, piece, compare, sortPiece), () => sortRun(items, buffer, middle, to, piece, compare, sortPiece));
    mergeRuns(items, from, middle, middle, to, buffer, from, compare);
    pts_parallel_for((start, end) => {
        for (let i = from + start; i < from + end; i++) {
            items[i] = buffer[i];
        }
    }, to - from);
}

// Merges the sorted runs source[left..leftEnd) and source[right..rightEnd) into target
// from at on, stably: the left run's elements first among equals. A long merge splits at
// the longer run's middle element, found in the other run by binary search, and merges
// the two halves at once.
function mergeRuns<T, S extends Indexed<T>>(source: S, left: number, leftEnd: number, right: number, rightEnd: number, target: S, at: number, compare: (a: T, b: T) => number): void {
    if (leftEnd - left + (rightEnd - right) <= SEQUENTIAL_SORT) {
        while (left < leftEnd && right < rightEnd) {
            if (compare(source[right], source[left]) < 0) {
                target[at++] = source[right++];
            } else {
                target[at++] = source[left++];
            }
        }
        while (left < leftEnd) {
            target[at++] = source[left++];
        }
        while (right < rightEnd) {
            target[at++] = source[right++];
        }
        return;
    }
    let leftSplit: number;
    let rightSplit: number;
    if (leftEnd - left >= rightEnd - right) {
        leftSplit = left + Math.floor((leftEnd - left) / 2);
        const pivot = source[leftSplit];
        rightSplit = search(right, rightEnd, (i) => compare(source[i], pivot) < 0); // the right run's elements before the pivot
    } else {
        rightSplit = right + Math.floor((rightEnd - right) / 2);
        const pivot = source[rightSplit];
        leftSplit = search(left, leftEnd, (i) => compare(pivot, source[i]) >= 0); // the left run's elements not after the pivot
    }
    const secondAt = at + (leftSplit - left) + (rightSplit - right);
    join(
        () => mergeRuns(source, left, leftSplit, right, rightSplit, target, at, compare),
        () => mergeRuns(source, leftSplit, leftEnd, rightSplit, rightEnd, target, secondAt, compare),
    );
}

// The first index in from..to for which before is false, where before holds for a prefix of the indices.
function search(from: number, to: number, before: (index: number) => boolean): number {
    while (from < to) {
        const middle = from + Math.floor((to - from) / 2);
        if (before(middle)) {
            from = middle + 1;
        } else {
            to = middle;
        }
    }
    return from;
}

// Runs a and b, perhaps at once on two threads, and returns both results once both are
// done; a throw out of either is rethrown then, a's first (D-122).
export function join<A, B>(a: ParallelCallback<() => A>, b: ParallelCallback<() => B>): [A, B] {
    const results: any[] = [undefined, undefined];
    pts_parallel_join(() => {
        results[0] = a();
    }, () => {
        results[1] = b();
    });
    return [results[0] as A, results[1] as B];
}
