// File I/O through the promise API: write 2,000 small files 100 at a time, read them
// all back, check their sizes with stat, list the directory and remove it; three rounds.
import { mkdtemp, readdir, readFile, rm, stat, writeFile } from "pts:fs/promises";

const FILES = 2000;
const BATCH = 100;

function contentOf(i: number): string {
    return `file ${i}: ${"abcdefghij".repeat((i % 40) + 1)}\n`;
}

async function round(): Promise<number> {
    const dir = await mkdtemp("/tmp/pts-bench-file-io-");
    for (let start = 0; start < FILES; start += BATCH) {
        const writes: Promise<void>[] = [];
        for (let i = start; i < start + BATCH; i++) {
            writes.push(writeFile(`${dir}/f${i}.txt`, contentOf(i)));
        }
        await Promise.all(writes);
    }
    let total = 0;
    for (let start = 0; start < FILES; start += BATCH) {
        const reads: Promise<string>[] = [];
        for (let i = start; i < start + BATCH; i++) {
            reads.push(readFile(`${dir}/f${i}.txt`, "utf8"));
        }
        for (const text of await Promise.all(reads)) {
            total += text.length;
        }
        for (let i = start; i < start + BATCH; i += 10) {
            total += (await stat(`${dir}/f${i}.txt`)).size;
        }
    }
    total += (await readdir(dir)).length;
    await rm(dir, { recursive: true });
    return total;
}

let sum = 0;
for (let i = 0; i < 3; i++) {
    sum += await round();
}
console.log(sum);
